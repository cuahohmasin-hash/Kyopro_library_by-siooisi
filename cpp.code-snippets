            "// AALC001 V等の「C=1になる回数を積算」用。一般の任意条件への加算ではない。",
            "// 0-indexed/[l,r)。構築O(N)、操作O(log N)。値/履歴/タグはint128、個数はint。",
            "struct RangeAddMinCountHistorySegTree {",
            "    using i128=__int128_t;",
            "    static constexpr i128 INF=i128(1)<<125;",
            "    // 判定時に全C>=1ならC=1の位置は最小値位置だけ。mn/countでその履歴増分を一括計算できる。",
            "    // historyは最小位置に限らず区間内全Dの和。count=0は空区間。",
            "    struct Node { i128 mn=INF,history=0; int count=0; };",
