        "ll from_base_n(const string& s, int base) {",
        "    assert(2 <= base && base <= 36 && !s.empty());",
        "    bool negative = s[0] == '-';",
        "    assert((int)s.size() > negative);",
        "    int128 res = 0;",
        "    for (int i = negative; i < (int)s.size(); ++i) {",
        "        int val = -1;",
        "        if ('0' <= s[i] && s[i] <= '9') val = s[i] - '0';",
        "        else if ('A' <= s[i] && s[i] <= 'Z') val = s[i] - 'A' + 10;",
        "        else if ('a' <= s[i] && s[i] <= 'z') val = s[i] - 'a' + 10;",
        "        assert(0 <= val && val < base);",
        "        res = res * base + val; // Horner法で乗算回数を削減",
        "    }",
        "    if (negative) res = -res;",
        "    assert(LLONG_MIN <= res && res <= LLONG_MAX);",
        "    return (ll)res;",
