        "        T root_val = sign[x] * (v - weight[x]);",
        "        if (fixed[r]) {",
        "            if (val[r] != root_val) valid = false;",
        "        } else {",
        "            fixed[r] = true;",
        "            val[r] = root_val;",
        "        }",
