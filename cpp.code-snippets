        "// 和(X+Y=V)と差(X-Y=V)の両方を管理できる万能DSU (Equation DSU / Affine DSU)",
        "// 内部で X_i = sign * X_root + weight の一次関数の形で状態を管理する",
        "// 奇数長のサイクルによる「値の確定」も自動検知",
        "template<class T>",
        "struct EquationDSU {",
        "    int n;",
        "    vector<int> par, sz, sign;",
        "    vector<T> weight, val;",
        "    vector<bool> fixed;",
        "    bool valid; // 矛盾が生じた場合 false",
        "",
        "    EquationDSU(int n) : n(n), par(n), sz(n, 1), sign(n, 1), weight(n, 0), val(n, 0), fixed(n, false), valid(true) {",
        "        iota(par.begin(), par.end(), 0);",
        "    }",
        "",
        "    int find(int x) {",
        "        if (par[x] == x) return x;",
        "        int r = find(par[x]);",
        "        weight[x] += sign[x] * weight[par[x]];",
        "        sign[x] *= sign[par[x]];",
        "        return par[x] = r;",
        "    }",
