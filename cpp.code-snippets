        "                sign[rx] = -cx * cy; weight[rx] = D * cx;",
        "                if (was_fixed) fix(rx, old_val); // 確定状態を伝播",
        "            } else {",
        "                bool was_fixed = fixed[ry]; T old_val = val[ry];",
        "                sz[rx] += sz[ry]; par[ry] = rx;",
        "                sign[ry] = -cx * cy; weight[ry] = D * cy;",
        "                if (was_fixed) fix(ry, old_val);",
        "            }",
        "        }",
        "        return valid;",
        "    }",
        "",
        "    // 戻り値用の構造体",
