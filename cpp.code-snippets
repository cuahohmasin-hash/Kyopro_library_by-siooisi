"配列ベース双方向リスト": {
  "prefix": "snip_doubly_linked_list",
  "body": [
    "// 配列ベースの高速な双方向リスト (1-indexed対応)",
    "// 構築: DoublyLinkedList dll(N);",
    "// 連結・切り離し: O(1) / 列の先頭取得: O(列の長さ) / 全列取得: O(N)",
    "// insert_after / insert_before の y は、prev[y] = next[y] = -1 の未連結要素を渡す。",
    "// erase_between は x と y の間を飛ばして直接つなぐ。飛ばした要素自身の prev/next は更新しない。",
    "struct DoublyLinkedList {",
    "    int n;",
    "    vector<int> prev, next;",
    "",
    "    // n: 要素数 (内部では1~nを扱うため n+1 サイズを確保)",
    "    DoublyLinkedList(int n) : n(n), prev(n + 1, -1), next(n + 1, -1) {}",
    "",
    "    // x の後ろに y を繋ぐ O(1)",
    "    void connect(int x, int y) {",
    "        next[x] = y;",
    "        prev[y] = x;",
    "    }",
    "",
    "    // x の直後に、未連結の y を挿入する O(1)",
    "    void insert_after(int x, int y) {",
    "        int z = next[x];",
    "        next[x] = y;",
    "        prev[y] = x;",
    "        next[y] = z;",
    "        if (z != -1) prev[z] = y;",
    "    }",
    "",
    "    // x の直前に、未連結の y を挿入する O(1)",
    "    void insert_before(int x, int y) {",
    "        int z = prev[x];",
    "        prev[x] = y;",
    "        next[y] = x;",
    "        prev[y] = z;",
    "        if (z != -1) next[z] = y;",
    "    }",
    "",
    "    // x と y の間の要素を飛ばし、x の直後を y にする O(1)",
    "    // x が左、y が右であることを仮定する",
    "    void erase_between(int x, int y) {",
    "        next[x] = y;",
    "        prev[y] = x;",
    "    }",
    "",
    "    // x と、x の「後ろ」の要素を切り離す O(1)",
    "    void disconnect_back(int x) {",
    "        if (next[x] != -1) {",
    "            prev[next[x]] = -1;",
    "            next[x] = -1;",
    "        }",
    "    }",
    "",
    "    // x と、x の「前」の要素を切り離す O(1)",
    "    void disconnect_front(int x) {",
    "        if (prev[x] != -1) {",
    "            next[prev[x]] = -1;",
    "            prev[x] = -1;",
    "        }",
    "    }",
    "",
    "    // x が属する列の「先頭」の要素番号を取得する",
    "    int get_head(int x) {",
    "        int current = x;",
    "        while (prev[current] != -1) {",
    "            current = prev[current];",
    "        }",
    "        return current;",
    "    }",
    "",
    "    // x が属する列の全要素を配列(vector)として取得する",
    "    vector<int> get_sequence(int x) {",
    "        int current = get_head(x);",
    "        vector<int> res;",
    "        while (current != -1) {",
    "            res.push_back(current);",
    "            current = next[current];",
    "        }",
    "        return res;",
    "    }",
    "",
    "    // 全ての連結成分（列）を2次元配列として取得する O(N)",
    "    vector<vector<int>> get_all_sequences() {",
    "        vector<vector<int>> res;",
    "        for (int i = 1; i <= n; i++) {",
    "            // 前に要素がない（＝列の先頭である）場合のみ探索を開始",
    "            if (prev[i] == -1) {",
    "                vector<int> seq;",
    "                int current = i;",
    "                while (current != -1) {",
    "                    seq.push_back(current);",
    "                    current = next[current];",
    "                }",
    "                res.push_back(seq);",
    "            }",
    "        }",
    "        return res;",
    "    }",
    "};"
  ],
  "description": "配列ベースの高速な双方向リスト。直前・直後への挿入、連結・切り離しをO(1)で行う。全ての列をO(N)で取得可能。"
},
