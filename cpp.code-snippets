            "template<long long Mod=998244353> struct AddModFunction {",
            "    static_assert(Mod>0);",
            "    using Int=__int128_t;",
            "    // modが1回以上あれば ((x+before) mod Mod)+after へ圧縮できる。",
            "    // 最後のmodの前後を分けると、区間外から渡される任意のxに対して評価できる。",
            "    bool has_mod=false;",
