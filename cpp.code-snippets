    "    auto rotate_low = [](Polygon& p) {",
    "        int k = 0;",
    "        for (int i = 1; i < (int)p.size(); ++i)",
    "            if (p[i].y < p[k].y || (p[i].y == p[k].y && p[i].x < p[k].x)) k = i;",
    "        std::rotate(p.begin(), p.begin() + k, p.end());",
    "    };",
    "    rotate_low(a); rotate_low(b);",
    "    int n = (int)a.size(), m = (int)b.size(), i = 0, j = 0;",
    "    std::vector<Point> ea(n), eb(m);",
    "    for (int k = 0; k < n; ++k) ea[k] = a[(k + 1) % n] - a[k];",
    "    for (int k = 0; k < m; ++k) eb[k] = b[(k + 1) % m] - b[k];",
    "    Point cur = a[0] + b[0]; Polygon res{cur};",
    "    while (i < n || j < m) {",
    "        if (j == m || (i < n && cross(ea[i], eb[j]) > EPS)) cur += ea[i++];",
    "        else if (i == n || cross(ea[i], eb[j]) < -EPS) cur += eb[j++];",
    "        else cur += ea[i++] + eb[j++];",
    "        res.push_back(cur);",
    "    }",
    "    res.pop_back(); return convex_hull(std::move(res));",
    "}",
    "} // namespace geo",
    "$0"
  ],
