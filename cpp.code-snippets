            "        std::vector<Node> v; v.reserve(a.size()); for(const auto& x:a) v.push_back(leaf(x)); return v;",
            "    }",
            "    int n;",
            "    atcoder::lazy_segtree<Node,op,e,Permutation,mapping,composition,id> seg;",
            "    explicit PermutationPrefixSegTree(const std::vector<Values>& a):n(int(a.size())),seg(leaves(a)){}",
            "    explicit PermutationPrefixSegTree(int count=0):PermutationPrefixSegTree(std::vector<Values>(count)){}",
