  "body": [
    "// 次元数を実行時に指定するN次元累積和。各次元0-indexed、queryは半開超直方体 [l[0],r[0]) x ... を返す。",
    "// 構築 O(D * Πsize)、prefix O(D)、query O(2^D)、メモリ O(Πsize)。Dが小さい場合に使う。",
    "// Tは T{} が加法単位元で、+= と -= を使える型。累積値がllを超えるならint128等を指定する。",
    "// addはbuild前だけ。query/prefixを初めて呼ぶと自動でbuildする。",
    "template<class T>",
    "struct CumsumND {",
    "    vector<int> shape;",
    "    vector<size_t> stride;",
    "    vector<T> data;",
    "    bool built = false;",
    "",
    "    explicit CumsumND(vector<int> shape_) : shape(move(shape_)), stride(shape.size()) {",
    "        if (shape.empty()) throw invalid_argument(\"CumsumND requires at least one dimension\");",
    "        size_t total = 1;",
    "        for (int axis = (int)shape.size() - 1; axis >= 0; --axis) {",
    "            if (shape[axis] < 0) throw invalid_argument(\"CumsumND shape must be non-negative\");",
    "            stride[axis] = total;",
    "            size_t length = (size_t)shape[axis];",
    "            if (length != 0 && total > numeric_limits<size_t>::max() / length)",
    "                throw length_error(\"CumsumND shape product overflow\");",
    "            total *= length;",
    "        }",
    "        if (total > data.max_size()) throw length_error(\"CumsumND is too large\");",
    "        data.assign(total, T{});",
    "    }",
    "",
    "    CumsumND(initializer_list<int> shape_) : CumsumND(vector<int>(shape_)) {}",
    "",
    "    // row-major（最後の次元が最速）で並べた初期値から構築する。",
    "    CumsumND(vector<int> shape_, vector<T> values) : CumsumND(move(shape_)) {",
    "        if (values.size() != data.size()) throw invalid_argument(\"CumsumND values size mismatch\");",
    "        data = move(values);",
    "    }",
    "",
    "    int dimensions() const { return (int)shape.size(); }",
    "    size_t element_count() const { return data.size(); }",
    "",
    "    size_t flat_index(span<const int> position) const {",
    "        if ((int)position.size() != dimensions()) throw invalid_argument(\"CumsumND coordinate dimension mismatch\");",
    "        size_t index = 0;",
    "        for (int axis = 0; axis < dimensions(); ++axis) {",
    "            if (position[axis] < 0 || position[axis] >= shape[axis])",
    "                throw out_of_range(\"CumsumND coordinate out of range\");",
    "            index += (size_t)position[axis] * stride[axis];",
    "        }",
    "        return index;",
    "    }",
    "",
    "    void add(span<const int> position, const T& value) {",
    "        if (built) throw logic_error(\"CumsumND::add called after build\");",
    "        data[flat_index(position)] += value;",
    "    }",
    "    void add(initializer_list<int> position, const T& value) {",
    "        add(span<const int>(position.begin(), position.size()), value);",
    "    }",
    "",
    "    void build() {",
    "        if (built) return;",
    "        if (data.empty()) { built = true; return; }",
    "        const size_t total = data.size();",
    "        for (int axis = 0; axis < dimensions(); ++axis) {",
    "            const size_t step = stride[axis];",
    "            const size_t length = (size_t)shape[axis];",
    "            const size_t block = step * length;",
    "            for (size_t base = 0; base < total; base += block) {",
    "                for (size_t coordinate = 1; coordinate < length; ++coordinate) {",
    "                    size_t current = base + coordinate * step;",
    "                    size_t previous = current - step;",
    "                    for (size_t offset = 0; offset < step; ++offset)",
    "                        data[current + offset] += data[previous + offset];",
    "                }",
    "            }",
    "        }",
    "        built = true;",
    "    }",
    "",
    "    // 原点から半開超直方体 [0,r[0]) x ... の和。",
    "    T prefix(span<const int> right) {",
