            "    static AddModFunction combine(AddModFunction a,AddModFunction b){",
            "        // bにmodがなければ末尾へ加算。あればaの加算分もbのmodの内側へまとめる。",
            "        if(!b.has_mod){a.after+=b.after;return a;}",
