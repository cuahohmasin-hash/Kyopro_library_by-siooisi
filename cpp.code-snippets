            "    int add(long long a,long long b,int line_id=-1) {",
            "        assert(!last_slope_ || a<=*last_slope_); last_slope_=a;",
            "        int id=line_id<0 ? next_id_++ : line_id;",
            "        if (!hull_.empty() && hull_.back().a==a) {",
            "            if (hull_.back().b<=b) return id;",
            "            hull_.pop_back();",
            "        }",
            "        Line line{a,b,id};",
            "        while (hull_.size()>=2 && redundant(hull_[hull_.size()-2],hull_.back(),line)) hull_.pop_back();",
            "        hull_.push_back(line); return id;",
            "    }",
            "    std::optional<Result> query(long long x) const {",
            "        if (hull_.empty()) return std::nullopt;",
            "        int l=0,r=static_cast<int>(hull_.size())-1;",
            "        while (l<r) {",
            "            int m=l+(r-l)/2;",
