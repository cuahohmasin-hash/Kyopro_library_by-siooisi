            "// Header: resources/library/segtree/affine_moments.hpp",
            "#include <bits/stdc++.h>",
            "#include <atcoder/lazysegtree>",
            "",
            "namespace cp {",
            "// RangeAffineMomentSegTree<mint998,4> seg(A);",
            "// range_affine(l,r,a,b)でx←a*x+b。range_add/range_set、moment(l,r,k)も使用可。",
            "// prod(l,r).moment[k]=Σx^k (0<=k<=K)。0乗和は要素数、空区間は全成分0。",
            "// 0-indexed/[l,r)。構築O(NK)、更新O(K² log N)、取得O(K log N)、メモリO(NK)。",
            "// Mintはmodint等の環型。K>=1。整数で使う場合は各冪・和・タグが型の範囲内。",
            "template<class Mint, int K>",
            "struct RangeAffineMomentSegTree {",
            "    static_assert(K >= 1);",
            "    // (a*x+b)^kの二項展開には0..k乗和が全て必要。K乗和だけでは一様更新できない。",
            "    struct Node { std::array<Mint,K+1> moment{}; };",
            "    struct Tag { Mint a=1,b=0; };",
            "    // 各乗和は左右の和で結合。0乗和は要素数で、定数項b^kの寄与を計算する。",
            "    static Node op(Node x,Node y) {",
            "        for(int k=0;k<=K;++k) x.moment[k]+=y.moment[k];",
            "        return x;",
            "    }",
            "    static Node e() { return {}; } // 空区間は0乗和も含め全0。",
            "    static const auto& binomial() {",
            "        static const auto c=[] {",
            "            std::array<std::array<Mint,K+1>,K+1> a{};",
            "            for(int i=0;i<=K;++i) {",
            "                a[i][0]=a[i][i]=1;",
            "                for(int j=1;j<i;++j) a[i][j]=a[i-1][j-1]+a[i-1][j];",
            "            }",
            "            return a;",
            "        }();",
            "        return c;",
            "    }",
            "    // Σ(a*x+b)^k=Σj binom(k,j)*a^j*b^(k-j)*Σx^j。更新前の全乗和から同時に作る。",
            "    static Node mapping(Tag f,Node x) {",
            "        std::array<Mint,K+1> ap{},bp{};",
            "        ap[0]=bp[0]=1;",
            "        for(int k=1;k<=K;++k) { ap[k]=ap[k-1]*f.a; bp[k]=bp[k-1]*f.b; }",
            "        Node y;",
            "        const auto& c=binomial();",
            "        for(int k=0;k<=K;++k) for(int j=0;j<=k;++j)",
            "            y.moment[k]+=c[k][j]*ap[j]*bp[k-j]*x.moment[j];",
            "        return y;",
            "    }",
            "    static Tag composition(Tag f,Tag g) { return {f.a*g.a,f.a*g.b+f.b}; } // gの後にf",
            "    static Tag id() { return {}; }",
            "    // 葉は0乗=1、k乗=x^k。タグ恒等元はx←1*x+0。",
            "    static Node leaf(Mint x) {",
            "        Node v; v.moment[0]=1;",
            "        for(int k=1;k<=K;++k) v.moment[k]=v.moment[k-1]*x;",
            "        return v;",
            "    }",
            "    static std::vector<Node> leaves(const std::vector<Mint>& a) {",
            "        std::vector<Node> v; v.reserve(a.size());",
            "        for(auto x:a) v.push_back(leaf(x));",
            "        return v;",
            "    }",
            "    atcoder::lazy_segtree<Node,op,e,Tag,mapping,composition,id> seg;",
            "    explicit RangeAffineMomentSegTree(const std::vector<Mint>& a):seg(leaves(a)){}",
            "    explicit RangeAffineMomentSegTree(int n=0):RangeAffineMomentSegTree(std::vector<Mint>(n)){}",
            "    void range_affine(int l,int r,Mint a,Mint b) { seg.apply(l,r,{a,b}); }",
            "    void range_add(int l,int r,Mint x) { range_affine(l,r,1,x); }",
            "    void range_set(int l,int r,Mint x) { range_affine(l,r,0,x); }",
            "    void set(int i,Mint x) { seg.set(i,leaf(x)); }",
            "    Mint get(int i) { return seg.get(i).moment[1]; }",
            "    Node prod(int l,int r) { return seg.prod(l,r); }",
            "    Node all_prod() { return seg.all_prod(); }",
            "    Mint moment(int l,int r,int k) { assert(0<=k&&k<=K); return prod(l,r).moment[k]; }",
            "};",
            "} // namespace cp",
            "#endif // CP_GENERATED_SEGTREE_AFFINE_MOMENTS_HPP"
        ],
