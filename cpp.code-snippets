  "prefix": "snip_hash_doubly_linked_list",
  "body": [
    "// safe_map版の双方向リスト",
    "// 値が大きい / クエリで新しい値が追加される場合に使う",
    "// 前提: 全要素は一意でNONEと異なる。各操作は存在/非存在条件を内部でも検査する。",
    "// 構築: HashDoublyLinkedList<ll> dll(NONE); dll.build(A);",
    "// 1要素初期化: dll.init_single(x);",
    "// 挿入: dll.insert_after(x, y); / dll.insert_before(x, y);",
    "// 削除: dll.erase(x);",
    "// 取得: auto ans = dll.to_vector();",
    "template<class T>",
    "struct HashDoublyLinkedList {",
    "    const T NONE;",
    "    safe_map<T, T> prv, nxt;",
    "    T head, tail;",
    "    int sz;",
    "",
    "    HashDoublyLinkedList(T none) : NONE(none), head(none), tail(none), sz(0) {}",
    "",
    "    // 空にする O(size)",
    "    void clear() {",
    "        prv.clear();",
    "        nxt.clear();",
    "        head = tail = NONE;",
    "        sz = 0;",
    "    }",
    "",
    "    // 初期列を作る O(N)",
    "    void build(const vector<T>& a) {",
    "        clear();",
    "        int n = a.size();",
    "        if (n == 0) return;",
    "        for (T x : a) {",
    "            bool ok = x != NONE && !contains(x);",
    "            assert(ok);",
    "            if (!ok) { clear(); return; }",
    "            prv[x] = NONE; // 重複検査用。隣接関係は後で上書きする",
    "        }",
    "",
    "        head = a[0];",
    "        tail = a[n - 1];",
    "        sz = n;",
    "",
    "        for (int i = 0; i < n; i++) {",
    "            prv[a[i]] = (i == 0 ? NONE : a[i - 1]);",
    "            nxt[a[i]] = (i == n - 1 ? NONE : a[i + 1]);",
    "        }",
    "    }",
    "",
    "    // 要素1つだけの列を作る",
    "    void init_single(T x) {",
    "        clear();",
    "        assert(x != NONE);",
    "        if (x == NONE) return;",
    "        head = tail = x;",
    "        prv[x] = NONE;",
    "        nxt[x] = NONE;",
    "        sz = 1;",
    "    }",
    "",
    "    // x が存在するか",
    "    bool contains(T x) const {",
    "        return prv.find(x) != prv.end();",
    "    }",
    "",
    "    // x の直後に y を挿入する",
    "    void insert_after(T x, T y) {",
    "        bool ok = contains(x) && y != NONE && !contains(y);",
    "        assert(ok);",
    "        if (!ok) return;",
    "        T z = nxt[x];",
    "",
    "        prv[y] = x;",
    "        nxt[y] = z;",
    "",
    "        nxt[x] = y;",
    "        if (z != NONE) prv[z] = y;",
    "        else tail = y;",
    "",
    "        sz++;",
    "    }",
    "",
    "    // x の直前に y を挿入する",
    "    void insert_before(T x, T y) {",
    "        bool ok = contains(x) && y != NONE && !contains(y);",
    "        assert(ok);",
    "        if (!ok) return;",
    "        T p = prv[x];",
    "",
    "        prv[y] = p;",
    "        nxt[y] = x;",
    "",
    "        prv[x] = y;",
    "        if (p != NONE) nxt[p] = y;",
    "        else head = y;",
    "",
    "        sz++;",
    "    }",
    "",
    "    // 先頭に x を追加する",
    "    void push_front(T x) {",
    "        if (sz == 0) {",
    "            init_single(x);",
    "            return;",
    "        }",
    "        insert_before(head, x);",
    "    }",
    "",
    "    // 末尾に x を追加する",
    "    void push_back(T x) {",
    "        if (sz == 0) {",
    "            init_single(x);",
    "            return;",
    "        }",
    "        insert_after(tail, x);",
    "    }",
    "",
    "    // x を削除する",
    "    void erase(T x) {",
    "        assert(contains(x));",
    "        if (!contains(x)) return;",
    "        T p = prv[x];",
    "        T q = nxt[x];",
    "",
    "        if (p != NONE) nxt[p] = q;",
    "        else head = q;",
    "",
    "        if (q != NONE) prv[q] = p;",
    "        else tail = p;",
    "",
    "        prv.erase(x);",
    "        nxt.erase(x);",
    "        sz--;",
    "",
    "        if (sz == 0) {",
    "            head = tail = NONE;",
    "        }",
    "    }",
    "",
    "    // 先頭を削除する",
    "    void pop_front() {",
    "        assert(sz > 0);",
    "        if (sz == 0) return;",
    "        erase(head);",
    "    }",
    "",
    "    // 末尾を削除する",
    "    void pop_back() {",
    "        assert(sz > 0);",
    "        if (sz == 0) return;",
    "        erase(tail);",
    "    }",
    "",
    "    // 現在の列を取得する",
    "    vector<T> to_vector() const {",
    "        vector<T> res;",
    "        T cur = head;",
    "        while (cur != NONE) {",
    "            res.push_back(cur);",
    "            auto it = nxt.find(cur);",
    "            if (it == nxt.end()) break;",
    "            cur = it->second;",
    "        }",
    "        return res;",
    "    }",
    "",
    "    // 現在の列を取得する get_sequence 版",
    "    vector<T> get_sequence() const {",
    "        return to_vector();",
    "    }",
    "",
    "    // 先頭を返す",
    "    T front() const {",
    "        return head;",
    "    }",
    "",
    "    // 末尾を返す",
    "    T back() const {",
    "        return tail;",
    "    }",
    "",
    "    // x の前を返す",
    "    T get_prev(T x) const {",
    "        auto it = prv.find(x);",
    "        if (it == prv.end()) return NONE;",
    "        return it->second;",
    "    }",
    "",
    "    // x の後ろを返す",
    "    T get_next(T x) const {",
    "        auto it = nxt.find(x);",
    "        if (it == nxt.end()) return NONE;",
    "        return it->second;",
    "    }",
    "",
    "    // 要素数を返す",
    "    int size() const {",
    "        return sz;",
    "    }",
    "",
    "    // 空かどうか",
    "    bool empty() const {",
    "        return sz == 0;",
    "    }",
    "};$0"
  ],
  "description": "safe_map版の双方向リスト。値が大きい場合や、クエリで新しい値が追加される場合に使う。挿入・削除・先頭末尾追加が平均O(1)。"
},"Parity DSU": {
    "prefix": "snip_parity_dsu",
    "body": [
        "// Parity付きUnion-Find",
        "// color[x] xor color[y] = w を管理する",
        "// w=0: 同じ, w=1: 違う",
        "struct ParityDSU {",
        "    vector<int> parent, sz, diff;",
        "    ParityDSU(int n) : parent(n), sz(n, 1), diff(n, 0) {",
        "        iota(parent.begin(), parent.end(), 0);",
        "    }",
        "    pair<int,int> find(int x) {",
        "        if (parent[x] == x) return {x, 0};",
        "        auto [r, p] = find(parent[x]);",
        "        diff[x] ^= p;",
        "        parent[x] = r;",
        "        return {parent[x], diff[x]};",
        "    }",
        "    int leader(int x) { return find(x).first; }",
        "    int parity(int x) { return find(x).second; }",
        "    bool same(int x, int y) { return leader(x) == leader(y); }",
        "    bool merge(int x, int y, int w) {",
        "        auto [rx, px] = find(x);",
        "        auto [ry, py] = find(y);",
        "        if (rx == ry) return ((px ^ py) == w);",
        "        if (sz[rx] < sz[ry]) {",
        "            swap(rx, ry);",
        "            swap(px, py);",
        "        }",
        "        parent[ry] = rx;",
        "        sz[rx] += sz[ry];",
        "        diff[ry] = px ^ py ^ w;",
        "        return true;",
        "    }",
        "    int diff_parity(int x, int y) {",
        "        auto [rx, px] = find(x);",
        "        auto [ry, py] = find(y);",
        "        if (rx != ry) return -1;",
        "        return px ^ py;",
        "    }",
        "    int size(int x) { return sz[leader(x)]; }",
        "};",
        "$0"
    ],
    "description": "Parity付きUnion-Find（同じ/違う・偶奇・二部グラフ判定）"
},"Bipartite Min DSU": {
    "prefix": "snip_bipartite_min_dsu",
    "body": [
        "// 二部グラフ管理用DSU",
        "// color[x] xor color[y] = w を追加しながら、各成分の min(色0側, 色1側) の総和を管理する",
        "// w=0: 同じ色, w=1: 違う色",
        "// d.ans が現在の最小黒数、d.ok=false なら二部グラフでない",
        "struct BipartiteMinDSU {",
        "    vector<int> parent, sz, diff;",
        "    vector<array<long long, 2>> cnt;",
        "    long long ans = 0;",
        "    bool ok = true;",
        "",
        "    BipartiteMinDSU(int n) : parent(n), sz(n, 1), diff(n, 0), cnt(n) {",
        "        iota(parent.begin(), parent.end(), 0);",
        "        for (int i = 0; i < n; i++) cnt[i] = {1, 0};",
        "    }",
        "",
        "    // 戻り値: {leader, x と leader の色の xor 差}",
        "    pair<int, int> find(int x) {",
        "        if (parent[x] == x) return {x, 0};",
        "        auto [r, p] = find(parent[x]);",
        "        diff[x] ^= p;",
        "        parent[x] = r;",
        "        return {parent[x], diff[x]};",
        "    }",
        "",
        "    int leader(int x) {",
        "        return find(x).first;",
        "    }",
        "",
        "    int parity(int x) {",
        "        return find(x).second;",
        "    }",
        "",
        "    bool same(int x, int y) {",
        "        return leader(x) == leader(y);",
        "    }",
        "",
        "    long long cost(int r) {",
        "        return min(cnt[r][0], cnt[r][1]);",
        "    }",
        "",
        "    // color[x] xor color[y] = w を追加する",
        "    // 矛盾がなければ true、矛盾したら false",
        "    bool merge(int x, int y, int w) {",
        "        if (!ok) return false;",
        "",
        "        auto [rx, px] = find(x);",
        "        auto [ry, py] = find(y);",
        "",
        "        if (rx == ry) {",
        "            if ((px ^ py) != w) ok = false;",
        "            return ok;",
        "        }",
        "",
        "        ans -= cost(rx);",
        "        ans -= cost(ry);",
        "",
        "        if (sz[rx] < sz[ry]) {",
        "            swap(rx, ry);",
        "            swap(px, py);",
        "        }",
        "",
        "        // ry を rx にぶら下げる",
        "        // diff[ry] = ry と rx の色の xor 差",
        "        int d = px ^ py ^ w;",
        "        parent[ry] = rx;",
        "        diff[ry] = d;",
        "        sz[rx] += sz[ry];",
        "",
        "        if (d == 0) {",
        "            cnt[rx][0] += cnt[ry][0];",
        "            cnt[rx][1] += cnt[ry][1];",
        "        } else {",
        "            cnt[rx][0] += cnt[ry][1];",
        "            cnt[rx][1] += cnt[ry][0];",
        "        }",
        "",
        "        ans += cost(rx);",
        "        return true;",
        "    }",
        "",
        "    // x と y の色の xor 差を返す。同じ成分でなければ -1",
        "    int diff_parity(int x, int y) {",
        "        auto [rx, px] = find(x);",
