        "// 頂点番号・非負重み・辺数・連結性を検査するが、逆辺の対称性は呼び出し側の前提。",
        "struct TreeDiameterResult {",
        "    using Distance = __int128_t;",
        "    Distance length = 0, radius = 0;",
        "    int s = -1, t = -1;",
        "    std::vector<int> path, centers;",
        "    std::vector<Distance> dist_s, dist_t;",
