            "// NAND畳み込み: seg.apply(l+1,r,A[l])（区間[l,r)、最初の値は初期値として渡す）。",
            "template<int Bits=30,class UInt=unsigned long long> struct BitwiseFunction {",
            "    static_assert(std::is_unsigned_v<UInt>&&sizeof(UInt)<=8);",
            "    static_assert(1<=Bits&&Bits<=std::numeric_limits<UInt>::digits);",
            "    static constexpr UInt mask=UInt(~UInt(0))>>(std::numeric_limits<UInt>::digits-Bits);",
            "    UInt zero=0,one=mask;",
            "    UInt eval(UInt x)const{return UInt(((zero&UInt(~x))|(one&x))&mask);}",
            "    static BitwiseFunction bit_and(UInt x){return {0,UInt(x&mask)};}",
            "    static BitwiseFunction bit_or(UInt x){return {UInt(x&mask),mask};}",
            "    static BitwiseFunction bit_xor(UInt x){return {UInt(x&mask),UInt((~x)&mask)};}",
            "    static BitwiseFunction nand(UInt x){return {mask,UInt((~x)&mask)};}",
            "    static BitwiseFunction nor(UInt x){return {UInt((~x)&mask),0};}",
            "    static BitwiseFunction bit_not(){return {mask,0};}",
            "    static BitwiseFunction constant(UInt x){return {UInt(x&mask),UInt(x&mask)};}",
            "    // tableのbit (2*a+b) = 二項演算(a,b)の出力。下位から(0,0),(0,1),(1,0),(1,1)。",
            "    // 例: AND=8, OR=14, XOR=6, NAND=7, NOR=1。各bitでxを左、rhsを右に適用する。",
            "    static BitwiseFunction from_truth_table(unsigned table,UInt rhs){",
            "        if(table>=16)throw std::invalid_argument(\"truth table must be in [0,16)\");",
            "        rhs&=mask;",
