            "template<class T=__int128_t> struct ClampMotionFunction {",
            "    static_assert((std::is_integral_v<T> && std::is_signed_v<T>)||std::is_same_v<T,__int128_t>);",
            "    bool empty=true;",
            "    // lower/upperは未飽和入力の区間。外では位置が飽和し、移動距離も距離分だけ減る。",
            "    // 最終位置だけでは総距離を復元できないため、gainも同時に保持する。",
            "    T lower=0,upper=0,shift=0,gain=0;",
            "    static T clamp(T x,T l,T r){return std::min(std::max(x,l),r);}",
            "    static T distance(T x,T l,T r){return x<l?l-x:(x>r?x-r:T(0));}",
            "    static ClampMotionFunction move(T d,T maximum){",
            "        assert(maximum>=0);return {false,-d,maximum-d,d,d<0?-d:d};",
            "    }",
            "    std::pair<T,T> eval(T x)const{",
            "        if(empty)return {x,0};",
