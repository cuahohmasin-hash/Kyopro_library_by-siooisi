"二項係数 (nCr / nHr / 階乗)": {
        "prefix": "snip_com",
        "body": [
            "// 二項係数(nCr)計算。テンプレの mint998 を使用する。",
            "// 必要な最大 n だけ COMinit(max_n) で確保するため、固定長200万配列を持たない。",
            "vector<mint998> fac{1}, finv{1};",
            "void COMinit(int max_n = ${1:2000000}) {",
            "    assert(0 <= max_n && max_n < mint998::mod());",
            "    int old = (int)fac.size() - 1;",
            "    if (max_n <= old) return;",
            "    fac.resize(max_n + 1);",
            "    finv.resize(max_n + 1);",
            "    for (int i = old + 1; i <= max_n; i++) fac[i] = fac[i - 1] * i;",
            "    finv[max_n] = fac[max_n].inv();",
            "    for (int i = max_n; i > old; i--) finv[i - 1] = finv[i] * i;",
            "}",
            "// 二項係数 (nCk)",
            "mint998 COM(int n, int k){",
            "    if (n < k || n < 0 || k < 0) return 0;",
            "    assert(n < (int)fac.size());",
            "    return fac[n] * finv[k] * finv[n - k];",
            "}",
            "// 重複組合せ (nHk)",
            "mint998 HOM(int n, int k){",
            "    if (n < 0 || k < 0) return 0;",
            "    if (n == 0 && k == 0) return 1;",
            "    return COM(n + k - 1, k);",
            "}",
            "// 巨大な n (10^14規模など) と小さな k に対応した二項係数 (nCk)",
            "// 依存: finv配列 (COMinit(k) 以上を事前計算しておく)",
            "// 計算量: O(k)",
            "mint998 COM_large_n(long long n, int k) {",
            "    if (n < k || n < 0 || k < 0) return 0;",
            "    assert(k < (int)finv.size());",
            "    long long mod_n = n % mint998::mod();",
            "    if (mod_n < k) return 0;",
            "    mint998 res = 1;",
            "    mint998 cur_n = mod_n;",
            "    for (int i = 0; i < k; i++) {",
            "        res *= cur_n;",
            "        cur_n -= 1;",
            "    }",
            "    res *= finv[k];",
            "    return res;",
            "}",
            "// 巨大な n と小さな k に対応した重複組合せ (nHk)",
            "mint998 HOM_large_n(long long n, int k) {",
            "    if (n < 0 || k < 0) return 0;",
            "    if (n == 0 && k == 0) return 1;",
            "    return COM_large_n(n + k - 1, k);",
            "}"
        ],
        "description": "必要サイズだけ前計算する二項係数・重複組合せ (mint998)"
    },
"ラグランジュ補間（連続点・オフセット・任意点）": {
    "prefix": "snip_lagrange",
    "body": [
      "// ラグランジュ補間。N個の値から次数N-1以下の多項式 f の値を求める。",
      "// 使用例（テンプレのmint998。vector<mint>でも同じ関数を使える）:",
      "// vector<mint998> y{0, 1, 4}; // f(t)=t^2 の f(0),f(1),f(2)",
      "// auto ans = lagrange(y, 1000000000000LL); // 連続点版: f(x)、O(N)",
      "// vector<mint998> shifted{10000, 10201, 10404}; // f(100),f(101),f(102)",
      "// auto ans2 = lagrange(shifted, 100LL, 105LL); // オフセット版: f(105)=11025、O(N)",
      "// vector<mint998> xs{1, 3, 7}, ys{1, 9, 49};",
      "// auto ans3 = lagrange(xs, ys, mint998(5)); // 任意点版: f(5)=25、O(N^2)",
      "// 前提: modは素数、1<=N<=mod、元の f はmod上で次数N-1以下の多項式。",
      "// 任意点版は xs.size()==ys.size()、xsはmod上で全て異なる（0とmodは同じ点）。",
      "// 整数x,Lはll範囲で負数も可。xはmod上で評価する。配列の添字は0-indexed。",
      "// 例: DPで値を求めた数列も、多項式であることと次数の上限を確認してから補間する。",
      "// 追加メモリO(N)、逆元計算は各呼び出し1回。厳密な時間はO(N+log mod)/O(N^2+log mod)。",
      "// COMinit/fac/finvに依存しない。テンプレート関数なのでmainの外へ展開する。",
      "namespace lagrange_detail {",
      "template<class Mint>",
      "Mint consecutive(const vector<Mint>& y, Mint x) {",
      "    assert(!y.empty() && y.size() <= (size_t)Mint::mod());",
      "    int n = (int)y.size();",
      "    if (x.val() < n) return y[x.val()]; // サンプル点とmod上で一致",
      "    vector<Mint> pref(n + 1, 1), suff(n + 1, 1), invfac(n, 1);",
      "    for (int i = 0; i < n; ++i) pref[i + 1] = pref[i] * (x - Mint(i));",
      "    for (int i = n - 1; i >= 0; --i) suff[i] = suff[i + 1] * (x - Mint(i));",
      "    Mint factorial = 1;",
      "    for (int i = 1; i < n; ++i) factorial *= Mint(i);",
      "    invfac[n - 1] = factorial.inv();",
      "    for (int i = n - 1; i > 0; --i) invfac[i - 1] = invfac[i] * Mint(i);",
      "    Mint ans = 0;",
      "    for (int i = 0; i < n; ++i) {",
      "        // 分母は i! * (N-1-i)! * (-1)^(N-1-i)。",
      "        Mint term = y[i] * pref[i] * suff[i + 1] * invfac[i] * invfac[n - 1 - i];",
      "        if ((n - 1 - i) & 1) ans -= term;",
      "        else ans += term;",
      "    }",
      "    return ans;",
      "}",
      "} // namespace lagrange_detail",
      "",
      "// y[i]=f(i) から f(x) を求める。連続点専用のO(N)版。",
      "template<class Mint>",
      "Mint lagrange(const vector<Mint>& y, ll x) {",
      "    return lagrange_detail::consecutive(y, Mint(x));",
      "}",
      "",
      "// y[i]=f(L+i) から f(x) を求める。引数順は (y, L, x)。",
      "template<class Mint>",
      "Mint lagrange(const vector<Mint>& y, ll L, ll x) {",
      "    return lagrange_detail::consecutive(y, Mint(x) - Mint(L)); // llでx-Lを計算しない",
      "}",
      "",
      "// ys[i]=f(xs[i]) から f(x) を求める。任意点用のO(N^2)版。",
      "// xはmint998(整数)等を渡す。連続点なら上のO(N)版を使う。",
      "template<class Mint>",
      "Mint lagrange(const vector<Mint>& xs, const vector<Mint>& ys, Mint x) {",
      "    assert(xs.size() == ys.size() && !xs.empty() && xs.size() <= (size_t)Mint::mod());",
      "    int n = (int)xs.size();",
      "    vector<Mint> den(n, 1), pref(n + 1, 1), suff(n + 1, 1), den_pref(n + 1, 1);",
      "    for (int i = 0; i < n; ++i) for (int j = i + 1; j < n; ++j) {",
      "        Mint diff = xs[i] - xs[j];",
      "        assert(diff != Mint(0)); // mod上での重複点を検出",
      "        den[i] *= diff; den[j] *= -diff;",
      "    }",
      "    for (int i = 0; i < n; ++i) {",
      "        pref[i + 1] = pref[i] * (x - xs[i]);",
      "        den_pref[i + 1] = den_pref[i] * den[i];",
      "    }",
      "    for (int i = n - 1; i >= 0; --i) suff[i] = suff[i + 1] * (x - xs[i]);",
      "    // 分母の逆元をまとめて求め、pow/invをN回呼ぶのを避ける。",
      "    Mint inv_product = den_pref[n].inv(), ans = 0;",
      "    for (int i = n - 1; i >= 0; --i) {",
      "        Mint inv_den = inv_product * den_pref[i];",
      "        inv_product *= den[i];",
      "        ans += ys[i] * pref[i] * suff[i + 1] * inv_den;",
      "    }",
      "    return ans;",
      "}"
    ],
    "description": "mint998/mint対応ラグランジュ補間。連続点・オフセットO(N)、任意点O(N^2)、逆元計算1回"
},
"座標圧縮": {
    "prefix": "snip_compress",
    "body": [
      "// 座標圧縮 (Coordinate Compression)",
      "// 使い方:",
      "// Compress<ll> cp(A); // 配列Aで初期化",
      "// cp.get(x) : 元の値xが圧縮後に何番目になるか (0-indexed)",
      "// cp.val(i) : 圧縮後の値iは、元の値でいうといくつか",
      "// cp.get_vector(A) : 座圧後の配列をまるごと返す (offset=1で1-indexed)",
      "template <typename T>",
      "struct Compress {",
      "    vector<T> vals;",
      "    bool is_built = false;",
      "    Compress() {}",
      "    Compress(const vector<T>& v) { add(v); build(); }",
      "    Compress(const vector<T>& v1, const vector<T>& v2) { add(v1); add(v2); build(); }",
      "    void add(T x) { vals.push_back(x); is_built = false; }",
      "    void add(const vector<T>& v) { vals.insert(vals.end(), v.begin(), v.end()); is_built = false; }",
      "    void build() {",
      "        if (is_built) return;",
      "        sort(vals.begin(), vals.end());",
      "        vals.erase(unique(vals.begin(), vals.end()), vals.end());",
      "        is_built = true;",
      "    }",
      "    int get(T x) { if (!is_built) build(); return lower_bound(vals.begin(), vals.end(), x) - vals.begin(); }",
      "    T val(int i) { if (!is_built) build(); return vals[i]; }",
      "    int size() { if (!is_built) build(); return vals.size(); }",
      "    vector<int> get_vector(const vector<T>& v, int offset = 0) {",
      "        vector<int> res;",
      "        res.reserve(v.size());",
      "        for (auto& x : v) res.push_back(get(x) + offset);",
      "        return res;",
      "    }",
      "};"
    ],
    "description": "座標圧縮"
  },
    "2次元累積和": {
        "prefix": "snip_cumsum2d",
        "body": [
            "// 2次元累積和",
            "// 宣言：CumSum2D<ll> r(H,W)",
            "// 1. add(h, w, val) で(h, w)に値を加算 (0-indexed)",
            "// 2. build() で累積和を構築 (O(HW))",
            "// 3. query(h1, w1, h2, w2) で左上(h1,w1)から右下(h2,w2)の矩形和を取得 (閉区間)",
            "template <typename T>",
            "struct CumSum2D {",
            "    int H, W;",
            "    vector<vector<T>> data;",
            "    bool built = false;",
            "    CumSum2D(int h, int w) : H(h), W(w), data(h + 1, vector<T>(w + 1, 0)) {}",
            "    void add(int h, int w, T val) {",
            "        assert(!built);",
            "        if (built) return;",
            "        if (h >= 0 && h < H && w >= 0 && w < W) data[h + 1][w + 1] += val;",
            "    }",
            "    void build() {",
            "        if (built) return;",
            "        for (int i = 1; i <= H; ++i) {",
            "            for (int j = 1; j <= W; ++j) {",
            "                data[i][j] += data[i][j - 1] + data[i - 1][j] - data[i - 1][j - 1];",
            "            }",
            "        }",
            "        built = true;",
            "    }",
            "    T query(int h1, int w1, int h2, int w2) {",
            "        if (!built) build();",
            "        return data[h2 + 1][w2 + 1] - data[h1][w2 + 1] - data[h2 + 1][w1] + data[h1][w1];",
            "    }",
            "};"
        ],
        "description": "二次元累積和"
    },
    "2次元いもす法 (半開区間)": {
    "prefix": "snip_imos2d",
    "body": [
        "// 2次元いもす法",
        "// 宣言：Imos2D<ll> r(H,W)",
        "// 1. add(h1, w1, h2, w2, val) で [h1, h2) × [w1, w2) の半開区間に加算 (0-indexed)",
        "// 2. build() で累積和を構築し、各マスの値を確定 (O(HW))",
        "// 3. get(h, w) で(h, w)のマスの値を取得",
        "// マスの面積なのか、座標から求めるのかで渡す値を変える",
        "template <typename T>",
        "struct Imos2D {",
        "    int H, W;",
        "    vector<vector<T>> data;",
        "    bool built = false;",
        "    Imos2D(int h, int w) : H(h), W(w), data(h + 2, vector<T>(w + 2, 0)) {}",
        "    void add(int h1, int w1, int h2, int w2, T val) {",
        "        assert(!built);",
        "        if (built) return;",
        "        if (h1 < 0 || h1 > h2 || h2 > H || w1 < 0 || w1 > w2 || w2 > W) return;",
        "        data[h1 + 1][w1 + 1] += val;",
        "        data[h1 + 1][w2 + 1] -= val; // 半開区間なので +1",
        "        data[h2 + 1][w1 + 1] -= val; // 半開区間なので +1",
        "        data[h2 + 1][w2 + 1] += val; // 半開区間なので +1",
        "    }",
        "    void build() {",
        "        if (built) return;",
        "        for (int i = 1; i <= H + 1; ++i) {",
        "            for (int j = 1; j <= W + 1; ++j) {",
        "                data[i][j] += data[i][j - 1] + data[i - 1][j] - data[i - 1][j - 1];",
        "            }",
        "        }",
        "        built = true;",
        "    }",
        "    T get(int h, int w) {",
        "        if (!built) build();",
        "        return data[h + 1][w + 1];",
        "    }",
        "};"
    ],
    "description": "二次元いもす法 (半開区間版)"
    },
    "最短距離から経路復元": {
        "prefix": "snip_restore_path",
        "body": [
            "// 距離配列から最短経路の頂点列（始点→終点）を1本復元。有向/無向、非負整数重みに対応。",
            "// 重みなし: restore_path(t, G, dist); // G=vector<vector<int>>, 未到達=-1",
            "// 重み付き: restore_path(t, G, dist, s, infl); // 既存dijkstraのEdge{to,cost}をそのまま使用可",
            "// pair版も可: vector<vector<pair<int,ll>>> G; // {行き先,重み} の順",
            "// distは正しい最短距離配列。整数型は64bit以下。負辺・浮動小数重みは非対応。",
            "// s省略時: 重みなしは到達したdist==0へ復元。重み付きはdist==0が一意なら自動判定。",
            "// 重み付きで0距離の頂点が複数ある場合はs必須（省略するとinvalid_argument）。",
            "// 未到達値が-1以外なら第5引数へ指定。既定は型の最大値。負のdistも未到達扱い。",
            "// 未到達・距離に合う経路なしは{}。s==tなら{t}。最短経路の辞書順は保証しない。",
            "// 逆辺を内部構築するので、Gは元の向きのまま渡す。時間・追加メモリO(V+E)/呼び出し。",
            "// 多数の終点を復元するなら、BFS/Dijkstra時に親を記録する方法の方が効率的。",
            "template<class EdgeType, class Dist>",
            "vector<int> restore_path(int t, const vector<vector<EdgeType>>& G,",
            "                         const vector<Dist>& dist, int s = -1,",
            "                         Dist unreachable = numeric_limits<Dist>::max()) {",
            "    static_assert(is_integral_v<Dist> && sizeof(Dist) <= 8);",
            "    constexpr bool unweighted = is_integral_v<EdgeType>;",
            "    int n = (int)G.size();",
            "    if ((int)dist.size() != n || t < 0 || t >= n || s < -1 || s >= n)",
            "        throw invalid_argument(\"restore_path: invalid size or vertex\");",
            "    auto reachable = [&](int v) { return dist[v] != unreachable && dist[v] >= 0; };",
            "    if (!reachable(t)) return {};",
            "    if constexpr (!unweighted) {",
            "        if (s == -1) {",
            "            for (int v = 0; v < n; ++v) if (reachable(v) && dist[v] == 0) {",
            "                if (s != -1) throw invalid_argument(\"restore_path: specify source for zero-weight paths\");",
            "                s = v;",
            "            }",
            "            if (s == -1) return {};",
            "        }",
            "    }",
            "    if (s != -1 && (!reachable(s) || dist[s] != 0)) return {};",
            "    // 最短距離の等式を満たす辺だけ逆向きに保存する。",
            "    vector<vector<int>> rev(n);",
            "    for (int u = 0; u < n; ++u) {",
            "        for (const auto& edge : G[u]) {",
            "            int v;",
            "            __int128_t w;",
            "            if constexpr (unweighted) { v = (int)edge; w = 1; }",
            "            else if constexpr (requires { edge.to; edge.cost; }) {",
            "                v = (int)edge.to; w = edge.cost;",
            "                static_assert(is_integral_v<decltype(edge.cost)> && sizeof(edge.cost) <= 8);",
            "            } else {",
            "                v = (int)edge.first; w = edge.second;",
            "                static_assert(is_integral_v<typename EdgeType::second_type> && sizeof(edge.second) <= 8);",
            "            }",
            "            if (v < 0 || v >= n || w < 0)",
            "                throw invalid_argument(\"restore_path: invalid edge or negative weight\");",
            "            if (reachable(u) && reachable(v) && (__int128_t)dist[u] + w == (__int128_t)dist[v])",
            "                rev[v].push_back(u);",
            "        }",
            "    }",
            "    vector<int> next_vertex(n, -1), que{t};",
            "    next_vertex[t] = t; // 訪問済み管理を兼ねる。重み0の閉路でも同じ頂点を再訪しない。",
            "    for (size_t head = 0; head < que.size(); ++head) {",
            "        int v = que[head];",
            "        if ((s == -1 && dist[v] == 0) || v == s) {",
            "            vector<int> path{v};",
            "            while (v != t) { v = next_vertex[v]; path.push_back(v); }",
            "            return path;",
            "        }",
            "        for (int u : rev[v]) if (next_vertex[u] == -1) {",
            "            next_vertex[u] = v;",
            "            que.push_back(u);",
            "        }",
            "    }",
            "    return {};",
            "}"
        ],
        "description": "重みなし・非負整数重み付き最短経路復元。有向辺・0重み閉路対応"
    },
    "ダイクストラ法": {
        "prefix": "snip_dijkstra",
        "body": [
            "// ダイクストラ法 (単一始点最短経路) O(E log V)",
            "// s: スタート頂点",
            "// 戻り値: sから各頂点への最短距離の配列 (到達不可能な場合は 1LL<<60)",
            "struct Edge { int to; ll cost; };",
            "using Graph = vector<vector<Edge>>;",
            "vector<ll> dijkstra(const Graph& G, int s) {",
            "    int N = (int)G.size();",
            "    VECI(ll, dist, N, infl);",
            "    dist[s] = 0;",
            "    min_pq<pair<ll, int>> pq; // テンプレの min_pq を使用",
            "    pq.push({0, s});",
            "    while (!pq.empty()) {",
            "        auto [d, v] = pq.top(); pq.pop();",
            "        if (d != dist[v]) continue;",
            "        for (const auto& e : G[v]) {",
            "            assert(e.cost >= 0);",
            "            if (d > infl - e.cost) continue;",
            "            ll nd = d + e.cost;",
            "            if (chmin(dist[e.to], nd)) pq.push({nd, e.to});",
            "        }",
            "    }",
            "    return dist;",
            "}"
        ],
        "description": "ダイクストラ法"
    },
    "約数列挙 O(√N)": {
        "prefix": "snip_divisor",
        "body": [
