            "// first_prefix_gt(l,x,col):ΣA[l..i][col]>xとなる最初のi。ない場合はN。",
            "// 総和ではなく最大prefix和で検索するため、列に負数が混在しても使用可能。",
            "// 0-indexed/[l,r)。構築O(NK)、操作O(K log N)。葉はll、集計はint128。",
            "template<int K>",
            "struct PermutationPrefixSegTree {",
            "    static_assert(K>0);",
            "    using i128=__int128_t;",
            "    using Values=std::array<long long,K>;",
            "    using Permutation=std::array<int,K>;",
            "    static constexpr i128 NEG_INF=-(i128(1)<<125);",
            "    // 負値混在ではsumだけでprefix検索できない。列ごとの最大prefix和を併せて保持する。",
            "    struct Node { int len=0; std::array<i128,K> sum{},pref{}; };",
            "    // prefixは左内か「左全体+右prefix」。len=0を空として扱い、非空prefixの意味を保つ。",
            "    static Node op(Node x,Node y) {",
            "        if(!x.len) return y;",
            "        if(!y.len) return x;",
            "        Node z; z.len=x.len+y.len;",
            "        for(int j=0;j<K;++j) { z.sum[j]=x.sum[j]+y.sum[j]; z.pref[j]=std::max(x.pref[j],x.sum[j]+y.pref[j]); }",
            "        return z;",
            "    }",
