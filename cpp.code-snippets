            "",
            "namespace cp {",
            "// RangeAddWeightedMinSegTree seg(A,weights); weights省略時は全1。",
            "// range_add(l,r,x)、prod(l,r).mn/weight/count（最小値/その位置の重み和/個数）。",
            "// 座標圧縮した葉の長さをweightsにすれば、最小値になる実際の総長を取得可能。",
            "// 0-indexed/[l,r)。構築O(N)、操作O(log N)。値・加算・重み和はint128。",
            "// 空区間はcount=0/weight=0、mn=INF。weightsは負でも可。演算はint128範囲内。",
            "struct RangeAddWeightedMinSegTree {",
            "    using i128=__int128_t;",
