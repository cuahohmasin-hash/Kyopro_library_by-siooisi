    "    }",
    "    return r;",
    "}",
    "",
    "struct CoverTree {",
    "    int n; const std::vector<long long>& ys;",
    "    std::vector<int> cover; std::vector<i128> length;",
    "    // 機能: 圧縮済みy座標区間の被覆長を管理するセグメント木を初期化する。",
    "    CoverTree(const std::vector<long long>& y) : n((int)y.size() - 1), ys(y), cover(4 * std::max(1, n)), length(4 * std::max(1, n)) {}",
    "    // 機能: 子の状態と被覆数から、指定ノード区間の被覆長を再計算する。",
    "    void pull(int node, int l, int r) {",
    "        if (cover[node] > 0) length[node] = (i128)ys[r] - ys[l];",
