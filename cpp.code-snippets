            "// 禁止辺の巨大値は呼出側で十分な値を用意し、結果に禁止辺がないか確認する。",
            "inline HungarianResult hungarian(const std::vector<std::vector<long long>>& cost) {",
            "    int n = (int)cost.size(); if (!n) return {};",
            "    int m = (int)cost[0].size();",
            "    if (n > m) throw std::invalid_argument(\"hungarian: rows > columns\");",
            "    for (const auto& row : cost) if ((int)row.size() != m) throw std::invalid_argument(\"hungarian: shape\");",
            "    const __int128_t inf = (__int128_t)1 << 120;",
            "    std::vector<__int128_t> u(n+1), v(m+1);",
            "    std::vector<int> p(m+1), way(m+1);",
            "    for (int i = 1; i <= n; ++i) {",
            "        p[0] = i; int j0 = 0;",
            "        std::vector<__int128_t> minv(m+1,inf); std::vector<char> used(m+1);",
            "        do {",
            "            used[j0] = true; int i0 = p[j0], j1 = 0; __int128_t delta = inf;",
            "            for (int j = 1; j <= m; ++j) if (!used[j]) {",
            "                __int128_t cur = (__int128_t)cost[i0-1][j-1] - u[i0] - v[j];",
            "                if (cur < minv[j]) { minv[j] = cur; way[j] = j0; }",
            "                if (minv[j] < delta) { delta = minv[j]; j1 = j; }",
            "            }",
            "            for (int j = 0; j <= m; ++j) {",
            "                if (used[j]) { u[p[j]] += delta; v[j] -= delta; }",
            "                else minv[j] -= delta;",
