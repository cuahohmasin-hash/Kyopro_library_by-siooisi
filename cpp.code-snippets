"ワーシャルフロイド": {
    "prefix": "snip_warshall_floyd",
    "body": [
        "// --------------------------------------------------------",
        "// snip_warshall_floyd : ワーシャルフロイド法",
        "// --------------------------------------------------------",
        "// 概要: 全頂点間の最短距離を一気に求める",
        "// 計算量: O(V^3) （頂点数 V <= 400 程度で有効）",
        "// 場面: Nが小さく、あらゆる頂点間の移動コストをO(1)で引き出したい時",
        "// 注意: ループの順番は必ず k(経由) -> i(始点) -> j(終点) にすること",
        "",
        "/* 準備: dist配列は infl (無限大) で初期化し、dist[i][i] = 0 としておく",
        "vector<vector<ll>> dist(N, vector<ll>(N, infl));",
        "for (int i = 0; i < N; i++) dist[i][i] = 0;",
        "*/",
        "",
        "for (int k = 0; k < N; k++) {         // k: 経由する頂点",
        "    for (int i = 0; i < N; i++) {     // i: スタートの頂点",
        "        if (dist[i][k] == infl) continue;",
        "        ll dik = dist[i][k];",
        "        auto& di = dist[i];",
        "        const auto& dk = dist[k];",
        "        for (int j = 0; j < N; j++) { // j: ゴールの頂点",
        "            if (dk[j] == infl) continue;",
        "            int128 nd = (int128)dik + dk[j];",
        "            if (nd < di[j]) di[j] = (ll)nd;",
        "        }",
        "    }",
        "}"
    ],
    "description": "全頂点対の最短経路をO(V^3)で求めるワーシャルフロイド法"
},
"ビットDP": {
    "prefix": "snip_bitdp",
    "body": [
        "// --------------------------------------------------------",
        "// snip_bitdp : bitDP (巡回セールスマン問題の応用など)",
        "// --------------------------------------------------------",
        "// 概要: 訪問済みの頂点集合をビットで管理して最小(最大)コストを求める",
        "// 計算量: O(2^N * N^2) （頂点数 N <= 16〜20 程度で有効）",
        "// 場面: 頂点を巡る最短経路、特定の集合を満たす最適化など",
        "// 注意: dpの初期値(infl / -infl)や更新式(min / max)は問題に合わせて変更する",
        "",
        "// 1. DP配列の定義 (Nは頂点数。1<<N は 2^N を表す)",
        "// dp[mask][u] = 訪問済み集合がmask、現在地がuのときの最小コスト",
        "vector<vector<ll>> dp(1 << N, vector<ll>(N, infl));",
        "",
        "// 2. スタート地点の初期化",
        "// (特定の S から出発する場合)",
        "dp[1 << S][S] = 0;",
        "// (どこから出発しても良い場合)",
        "// for (int i = 0; i < N; i++) dp[1 << i][i] = 0;",
        "",
        "// 3. 状態遷移 (配るDP)",
        "for (int mask = 0; mask < (1 << N); mask++) {     // 外側: 状態 (0 から昇順で確定していく)",
        "    for (int u = 0; u < N; u++) {                 // 中側: 現在地",
        "        if (dp[mask][u] == infl) continue;        // 到達不可能な状態はスキップ",
        "",
        "        for (int v = 0; v < N; v++) {             // 内側: 次に行く場所",
        "            if (!(mask & (1 << v))) {             // まだ v を訪問していないなら",
        "                int next_mask = mask | (1 << v);  // v を訪問済みにした新しい mask",
        "                ",
        "                // 状態の更新 (最短距離なら chmin と dist[u][v] の和など)",
        "                chmin(dp[next_mask][v], dp[mask][u] + dist[u][v]);",
        "            }",
        "        }",
        "    }",
        "}"
    ],
    "description": "集合を状態に持つO(2^N * N^2)のbitDPテンプレート"
},
"辺数カウント付きDSU": {
    "prefix": "snip_dsu_edge",
    "body": [
        "// 辺の数をカウントできるUnion-Find (ACL dsuラッパー)",
        "// 計算量: 構築 O(N), 各操作(merge, leader, size, edge_count) O(α(N))",
        "// 使い方: EdgeCountDSU d(N); d.merge(u, v); d.edge_count(u);",
        "#include <atcoder/dsu>",
        "#include <vector>",
        "",
        "struct EdgeCountDSU {",
        "    atcoder::dsu d;",
        "    std::vector<long long> edge_counts;",
        "",
        "    // コンストラクタ（初期化）",
        "    EdgeCountDSU(int n) : d(n), edge_counts(n, 0) {}",
        "",
        "    // 辺を追加してマージする関数",
        "    int merge(int u, int v) {",
        "        int leader_u = d.leader(u);",
        "        int leader_v = d.leader(v);",
        "",
        "        // ケースA: すでに同じグループなら、辺の数を1増やすだけ",
        "        if (leader_u == leader_v) {",
        "            edge_counts[leader_u]++;",
        "            return leader_u;",
        "        }",
        "",
        "        // ケースB: 違うグループなら、合体させて辺の数を合計する",
        "        long long sum_edges = edge_counts[leader_u] + edge_counts[leader_v] + 1;",
        "        ",
        "        // ACLのmergeを呼ぶと、新しいリーダーが返ってくる",
        "        int new_leader = d.merge(u, v); ",
        "        ",
        "        // 新しいリーダーに合計した辺の数を記録する",
        "        edge_counts[new_leader] = sum_edges;",
        "        ",
        "        return new_leader;",
        "    }",
        "",
        "    // 頂点 u が属するグループのリーダーを取得する",
        "    int leader(int u) {",
        "        return d.leader(u);",
        "    }",
        "",
        "    // 頂点 u が属するグループの頂点数（サイズ）を取得する",
        "    int size(int u) {",
        "        return d.size(u);",
        "    }",
        "",
        "    // ★追加機能：頂点 u が属するグループの辺の数を取得する",
        "    long long edge_count(int u) {",
        "        return edge_counts[d.leader(u)];",
        "    }",
        "};"
    ],
    "description": "グループ内の辺の数をカウントできるUnion-Find（ACLラッパー）"
},
"Next配列構築": {
  "prefix": "snip_next_array",
  "body": [
    "// 文字列Sの部分列探索用 Next配列の構築",
    "// 構築計算量: O(|S| * 26) / クエリ(次文字の検索)計算量: O(1)",
    "// 使い方: auto next_c = calc_next(S);",
    "// next_c[i][c] := 位置 i 以降で文字 c ('a'-'z') が最初に登場するインデックス",
    "// 存在しない場合は番兵として文字列の長さ |S| が入る",
    "vector<array<int, 26>> calc_next(const string& S) {",
    "    int n = (int)S.size();",
    "    for (char c : S) if (c < 'a' || 'z' < c) throw invalid_argument(\"calc_next supports only a-z\");",
    "    vector<array<int, 26>> res(n + 1);",
    "    res[n].fill(n);",
    "    for (int i = n - 1; i >= 0; --i) {",
    "        res[i] = res[i + 1]; // 連続arrayを一括コピーし、26回の分岐を除く",
    "        res[i][S[i] - 'a'] = i;",
    "    }",
    "    return res;",
    "}"
  ],
  "description": "文字列の部分列探索を高速化するNext配列を構築する"
},
"2-SAT 最大1個制約 (超頂点)": {
    "prefix": "snip_2sat_at_most_one",
    "body": [
        "// 使い方: 互いに排他(最大1個しか選べない)グループの配列を渡す",
        "// group: {頂点番号, true(選ぶ) / false(選ばない)} のリスト",
        "// 計算量: 辺・頂点の追加 O(K) (Kはグループの要素数)",
        "ll V_count = N; // 超頂点用のIDカウンター (Nは元の頂点数)",
        "two_sat t(500000); // 余裕を持たせたサイズで初期化",
        "",
        "auto add_at_most_one = [&](const vector<pair<ll, bool>>& group) {",
        "\tll k = group.size();",
        "\tif (k <= 1) return;",
        "",
        "\tvector<ll> y(k);",
        "\trep(i, 0, k) {",
        "\t\ty[i] = V_count;",
        "\t\tV_count++; ",
        "\t}",
        "",
        "\trep(i, 0, k) {",
        "\t\tll v_id = group[i].first;",
        "\t\tbool v_val = group[i].second;",
        "",
        "\t\t// ① 自分が選ばれたら、自分のランプをON",
        "\t\tt.add_clause(v_id, !v_val, y[i], true);",
        "",
        "\t\tif (i > 0) {",
        "\t\t\t// ② 左のランプがONなら、自分のランプもON",
        "\t\t\tt.add_clause(y[i-1], false, y[i], true);",
        "\t\t\t// ③ 自分が選ばれるなら、左のランプは絶対にOFF",
        "\t\t\tt.add_clause(v_id, !v_val, y[i-1], false);",
        "\t\t}",
        "\t}",
        "};"
    ],
    "description": "2-SATで「最大1個しか選べない(At-Most-One)」制約を超頂点でO(K)で追加する関数"
},
