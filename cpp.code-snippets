            "// for (auto [l,r] : iu.intervals()) { ... } // 左端昇順。const参照なのでコピー不要。",
            "// add: k区間を吸収するとO(log(M+1)+k)償却、Q回合計O(Q log(Q+1))。Mは保持区間数。",
            "// Tは64bit以下の整数型（boolを除く）。長さ・返り値はint128。テンプレのcoutで出力可。",
            "// L>Rは空区間としてaddは0、containsはtrue。addで吸収された区間のiteratorは無効。",
            "template<class T = ll>",
            "class IntervalUnion {",
            "    static_assert(is_integral_v<T> && !is_same_v<T, bool> && numeric_limits<T>::digits <= 64);",
            "    set<pair<T,T>> st;",
            "    int128 total = 0;",
            "    static int128 length(T l, T r) { return (int128)r - (int128)l + 1; }",
            "public:",
            "    int128 covered() const { return total; }",
            "    const set<pair<T,T>>& intervals() const { return st; }",
            "",
            "    bool contains(T l, T r) const {",
            "        if (l > r) return true;",
