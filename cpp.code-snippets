"XOR Trie": {
  "prefix": "snip_xor_trie",
  "body": [
    "// XOR Trie",
    "// 非負long longを01 Trieに追加し、xとの最大XOR値をO(LOG)で取得する。",
    "// 空Trieへのqueryは-1を返す。",
    "// 計算量: insert/query ともに O(LOG)、メモリ O(要素数 * LOG)",
    "struct XorTrie {",
    "    static const int LOG = 62; // 非負long longの全bit (0..62)",
    "    vector<array<int, 2>> nxt;",
    "    int element_count = 0;",
    "",
    "    XorTrie() {",
    "        nxt.push_back({-1, -1});",
    "    }",
    "",
    "    void insert(long long x) {",
    "        assert(x >= 0);",
    "        if (x < 0) return;",
    "        int v = 0;",
    "        for (int b = LOG; b >= 0; b--) {",
    "            int c = (x >> b) & 1;",
    "            if (nxt[v][c] == -1) {",
    "                nxt[v][c] = (int)nxt.size();",
    "                nxt.push_back({-1, -1});",
    "            }",
    "            v = nxt[v][c];",
    "        }",
    "        element_count++;",
    "    }",
    "",
    "    bool empty() const { return element_count == 0; }",
    "    int size() const { return element_count; }",
    "",
    "    // x と Trie内のどれか1つの値との XOR の最大値を返す",
    "    long long max_xor(long long x) const {",
    "        assert(x >= 0);",
    "        if (x < 0 || empty()) return -1;",
    "        int v = 0;",
    "        long long res = 0;",
    "        for (int b = LOG; b >= 0; b--) {",
    "            int c = (x >> b) & 1;",
    "            int want = c ^ 1;",
    "            if (nxt[v][want] != -1) {",
    "                res |= 1LL << b;",
    "                v = nxt[v][want];",
    "            } else {",
    "                v = nxt[v][c];",
    "            }",
    "        }",
    "        return res;",
    "    }",
    "};"
  ],
  "description": "XOR最大値クエリ用の01 Trie"
},
"桁DP_map枠": {
  "prefix": "snip_digit_dp_map",
  "body": [
    "// map版 桁DP 汎用枠",
    "// 状態を ll key に圧縮し、到達した状態だけ safe_map に持つ。",
    "// 各遷移の重みは変えずに足し合わせるため、主用途は条件を満たす数の個数（ll/mint）。",
    "// transition(key, digit) が次状態keyを返す。捨てる遷移は -1 を返す。",
    "// accept(key) が最後に数える状態なら true を返す。",
    "// 計算量: O(|N| * 到達状態数 * 10) 程度。状態空間が広いが実際の到達状態が少ないとき向け。",
    "// 注意: このスニペットはあなたのテンプレの safe_map<ll, Count> を使う前提。",
    "//       safe_map がない環境では unordered_map<ll, Count> などに置き換える。",
    "",
    "template<class Count, class Transition, class Accept>",
    "Count digit_dp_leq_map(",
    "    const string& N,",
    "    ll init_key,",
    "    Transition transition,",
    "    Accept accept",
    ") {",
    "    array<safe_map<ll, Count>, 2> dp, ndp;",
    "    dp[1][init_key] = Count(1);",
    "",
    "    for (char c : N) {",
    "        ndp[0].clear();",
    "        ndp[1].clear();",
    "",
    "        for (int tight = 0; tight <= 1; tight++) {",
    "            int lim = tight ? c - '0' : 9;",
    "",
    "            for (const auto& [key, val] : dp[tight]) {",
    "                if (val == Count(0)) continue;",
    "",
    "                for (int d = 0; d <= lim; d++) {",
    "                    ll nkey = transition(key, d);",
    "                    if (nkey < 0) continue;",
    "",
    "                    int ntight = tight && (d == lim);",
    "                    ndp[ntight][nkey] += val;",
    "                }",
    "            }",
    "        }",
    "",
    "        dp[0].swap(ndp[0]);",
    "        dp[1].swap(ndp[1]);",
    "    }",
    "",
    "    Count ans = Count(0);",
    "    for (int tight = 0; tight <= 1; tight++) {",
    "        for (const auto& [key, val] : dp[tight]) {",
    "            if (accept(key)) ans += val;",
    "        }",
    "    }",
    "",
    "    return ans;",
    "}",
    "",
    "// ===== 使用例テンプレ =====",
    "string ${1:N};",
    "cin >> ${1:N};",
    "",
    "// [問題ごとに変更1: 答えの型] 数え上げ結果の型。通常ll、modを取るならmint998など。",
    "using Count = ${2:long long};",
    "",
    "// [問題ごとに変更2: 状態key] ここまで見た桁について、未来の判定に必要な情報だけを持つ。",
    "// 状態が余り1個など単純ならenc/decは削除してkeyを直接使ってよい。複合状態のときだけ使う。",
    "// 例1: 桁和 mod K                 -> key = sum_mod（0..K-1）",
    "// 例2: 数字3を1回以上使ったか     -> key = has3（0/1）",
    "// 例3: 先頭0を除く使用数字集合     -> key = started * (1<<10) + mask",
    "// 例4: 余り・started・maskを併用   -> それぞれの範囲を掛けて1個の非負llへ圧縮",
    "// key=-1は遷移を捨てる予約値なので、有効な状態は必ず0以上にする。",
    "auto enc = [&](/* TODO: 状態 */) -> ll {",
    "    return ${3:0};",
    "};",
    "",
    "// [問題ごとに変更3: 復号] encと逆順に剰余・除算し、transition/acceptで使う状態へ戻す。",
    "auto dec = [&](ll key) {",
    "    // 複合状態の例（encもこの並びに合わせて作る）:",
    "    // int started = key % 2; key /= 2;",
    "    // int mask = key % (1 << 10); key /= (1 << 10);",
    "    // int has3 = key % 2; key /= 2;",
    "    // int rem3 = key;",
    "    return ${4:key};",
    "};",
    "",
    "// [問題ごとに変更4: 初期状態] まだ1桁も置いていない状態をencした値。",
    "// 余りなら0、フラグならfalse、maskなら0、startedならfalseから始める。",
    "ll init_key = ${5:0};",
    "",
    "auto transition = [&](ll key, int d) -> ll {",
    "    // [問題ごとに変更5: 状態遷移] keyをdecし、次の数字dを置いた状態をencして返す。",
    "    // 例1: 数そのものの余り mod K -> (key * 10 + d) % K",
    "    // 例2: 桁和 mod K             -> (key + d) % K",
    "    // 例3: 数字3を含む            -> key || (d == 3)",
    "    // 例4: 同じ数字を2回使わない  -> started後に(mask >> d & 1)なら-1、そうでなければmaskへ追加",
    "    // 禁止部分文字列・上限回数超過など、条件違反の遷移は-1を返して捨てる。",
    "    // leading zero: 0007を7として扱う性質（桁数・使用数字など）はstartedを状態に含め、",
