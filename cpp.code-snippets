        "        for (int i = 0; i < n; i++) {",
        "            hash[i + 1] = calc_mod((__int128_t)hash[i] * base + s[i]);",
        "            power[i + 1] = calc_mod((__int128_t)power[i] * base);",
        "        }",
        "    }",
        "    ",
        "    // [l, r) のハッシュ値を取得 (0-indexed)",
        "    ull get(int l, int r) const {",
        "        ull res = hash[r] + MOD - calc_mod((__int128_t)hash[l] * power[r - l]);",
        "        return res >= MOD ? res - MOD : res;",
        "    }",
        "",
        "    // 文字列全体のハッシュ値を取得",
        "    ull all() const {",
        "        return hash[n];",
        "    }",
        "",
        "    // 文字列全体のハッシュ値を一発で取得",
