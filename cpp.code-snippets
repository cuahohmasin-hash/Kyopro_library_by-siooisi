            "        const auto &a=tree[p*2], &b=tree[p*2+1];",
            "        Node c; c.len=a.len+b.len;c.sum=a.sum+b.sum;",
            "        c.mn=std::min(a.mn,b.mn);c.mx=std::max(a.mx,b.mx);",
