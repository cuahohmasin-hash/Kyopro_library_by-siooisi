      "",
      "    // pos 番目の値を val に変更。0 <= pos < size()",
      "    static void set(Node* t, int pos, const T& val) {",
      "        push(t);",
      "        int lsz = count(t->l);",
      "        if (pos < lsz) {",
      "            set(t->l, pos, val);",
      "        } else if (pos == lsz) {",
      "            t->val = val;",
      "        } else {",
      "            set(t->r, pos - lsz - 1, val);",
      "        }",
      "        pull(t);",
      "    }",
      "",
      "    void set(int pos, const T& val) {",
      "        assert(0 <= pos && pos < size());",
      "        set(root, pos, val);",
      "    }",
      "",
      "    // pos 番目の直前に val を挿入。0 <= pos <= size()",
      "    void insert(int pos, const T& val) {",
      "        assert(0 <= pos && pos <= size());",
      "        Node *a, *b;",
      "        split(root, pos, a, b);",
      "        root = merge(merge(a, new Node(val)), b);",
      "    }",
      "",
      "    void push_front(const T& val) {",
      "        insert(0, val);",
      "    }",
      "",
      "    void push_back(const T& val) {",
      "        insert(size(), val);",
      "    }",
      "",
      "    // pos 番目の要素を削除。0 <= pos < size()",
      "    void erase(int pos) {",
      "        assert(0 <= pos && pos < size());",
      "        Node *a, *m, *b;",
      "        split(root, pos, a, m);",
      "        split(m, 1, m, b);",
      "        delete m;",
      "        root = merge(a, b);",
      "    }",
      "",
      "    T pop_front() {",
      "        assert(!empty());",
      "        T res = get(0);",
      "        erase(0);",
      "        return res;",
      "    }",
      "",
      "    T pop_back() {",
      "        assert(!empty());",
      "        T res = get(size() - 1);",
      "        erase(size() - 1);",
      "        return res;",
      "    }",
      "",
      "    T front() {",
      "        assert(!empty());",
      "        return get(0);",
      "    }",
      "",
      "    T back() {",
      "        assert(!empty());",
      "        return get(size() - 1);",
      "    }",
      "",
      "    // 半開区間 [left, right) を反転",
      "    void reverse(int left, int right) {",
      "        assert(0 <= left && left <= right && right <= size());",
      "        Node *a, *m, *b;",
      "        split(root, right, a, b);",
      "        split(a, left, a, m);",
      "        if (m) m->rev ^= 1;",
      "        root = merge(merge(a, m), b);",
      "    }",
      "",
      "    // std::rotate と同様に [left, middle) と [middle, right) を入れ替える",
      "    void rotate(int left, int middle, int right) {",
      "        assert(0 <= left && left <= middle && middle <= right && right <= size());",
      "        Node *a, *b, *c, *d;",
      "        split(root, right, a, d);",
      "        split(a, middle, a, c);",
      "        split(a, left, a, b);",
      "        root = merge(merge(merge(a, c), b), d);",
      "    }",
      "",
      "    // 半開区間 [left, right) の集約値を取得",
      "    T query(int left, int right) {",
      "        assert(0 <= left && left <= right && right <= size());",
      "        Node *a, *m, *b;",
      "        split(root, right, a, b);",
      "        split(a, left, a, m);",
      "        T res = prod(m);",
      "        root = merge(merge(a, m), b);",
      "        return res;",
      "    }",
      "",
      "    // 全要素の集約値を取得",
      "    T all_prod() const {",
      "        return prod(root);",
      "    }",
      "",
      "    static void dump(Node* t, vector<T>& res) {",
      "        if (!t) return;",
      "        push(t);",
      "        dump(t->l, res);",
      "        res.push_back(t->val);",
      "        dump(t->r, res);",
      "    }",
      "",
      "    // 現在の列を vector に変換。O(N)",
      "    vector<T> to_vector() {",
      "        vector<T> res;",
      "        res.reserve(size());",
      "        dump(root, res);",
      "        return res;",
      "    }",
      "};",
      "// ------------------------"
    ],
    "description": "Implicit Treap (Insert, Erase, Get, Set, Reverse, Rotate, Query, to_vector)"
},
"Prim法_dense": {
  "prefix": "snip_prim_dense",
  "body": [
    "// Prim法（隣接行列版）",
    "// 最小全域木(MST)を構築",
    "// 計算量: O(N^2)",
    "//",
    "// 使い方:",
    "// auto tree = prim_dense<ll>(cost, infl); // 非辺をinflで埋めた場合",
    "// costは対称なN*N行列、実辺重みはno_edge未満とする",
    "// 戻り値: MSTの隣接リスト。非連結・不正な行列なら空vector",
    "",
    "template<class T>",
    "vector<vector<pair<int,T>>> prim_dense(",
    "    const vector<vector<T>>& cost,",
    "    T no_edge = numeric_limits<T>::max() / 4",
    ") {",
    "    int n = (int)cost.size();",
    "    for (const auto& row : cost) {",
    "        if ((int)row.size() != n) { assert(false); return {}; }",
    "    }",
    "    if (n == 0) return {};",
    "",
    "    vector<T> mincost(n, no_edge);",
    "    vector<int> parent(n, -1);",
    "    vector<bool> used(n, false);",
    "",
    "    vector<vector<pair<int,T>>> tree(n);",
    "",
    "    mincost[0] = 0;",
    "",
    "    for (int step = 0; step < n; step++) {",
    "        int v = -1;",
    "",
    "        for (int i = 0; i < n; i++) {",
    "            if (!used[i] && (v == -1 || mincost[i] < mincost[v])) {",
    "                v = i;",
    "            }",
    "        }",
    "",
    "        if (v == -1 || mincost[v] >= no_edge) return {}; // 非連結",
    "",
    "        used[v] = true;",
    "",
    "        if (parent[v] != -1) {",
    "            int p = parent[v];",
    "            T w = cost[p][v];",
    "            tree[p].push_back({v, w});",
    "            tree[v].push_back({p, w});",
    "        }",
    "",
    "        for (int to = 0; to < n; to++) {",
    "            if (!used[to] && cost[v][to] < no_edge && cost[v][to] < mincost[to]) {",
    "                mincost[to] = cost[v][to];",
    "                parent[to] = v;",
    "            }",
    "        }",
    "    }",
    "",
    "    return tree;",
    "}"
  ],
  "description": "Prim法（隣接行列版・O(N^2)）"
