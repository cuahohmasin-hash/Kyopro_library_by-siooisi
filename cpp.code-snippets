    "    i128 answer = 0, first_x = ceil_div(cx - radius, scale) * scale;",
    "    for (i128 x = first_x; x <= cx + radius; x += scale) {",
    "        i128 dx = x - cx, rem = radius * radius - dx * dx; if (rem < 0) continue;",
    "        i128 dy = floor_sqrt(rem);",
