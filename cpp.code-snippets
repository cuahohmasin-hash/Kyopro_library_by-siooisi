            "#ifndef CP_GENERATED_SEGTREE_DUAL_SEGMENT_TREE_HPP",
            "#define CP_GENERATED_SEGTREE_DUAL_SEGMENT_TREE_HPP",
            "// Header: resources/library/segtree/dual_segment_tree.hpp",
            "#include <bits/stdc++.h>",
            "",
            "namespace cp {",
            "// DualSegmentTree<Value,Tag,mapping,composition,id> seg(A);",
            "// apply(l,r,f):区間作用、get(i):点取得、set(i,x):点代入。0-indexed/[l,r)。",
            "// mapping(f,x)は点への作用。composition(f,g)はgの後にf。id()は恒等作用。",
            "// 加算/代入だけでなく、行列/関数合成など非可換な作用も順序を保つ。",
            "// Valueの結合演算は不要。構築O(N)、操作O(log N)、メモリO(N)。",
            "template<class Value,class Tag,auto mapping,auto composition,auto id>",
            "class DualSegmentTree {",
            "    int n_=0,size_=1,log_=0;",
            "    // 区間集約値を持たず、葉のValueと内部ノードの未伝播Tagだけを保持する。",
            "    // 葉の初期値は渡された値そのもの。空区間へのapplyは何もせず、タグの単位元はid()。",
            "    std::vector<Value> values_;",
            "    std::vector<Tag> lazy_;",
            "    // 新しいfを古いlazyの後に合成。Value用op/eがない代わりにTagの結合法則が必要。",
            "    void apply_node(int k,const Tag& f) {",
            "        if(k<size_) lazy_[k]=composition(f,lazy_[k]);",
            "        else if(k-size_<n_) values_[k-size_]=mapping(f,values_[k-size_]);",
            "    }",
            "    void push(int k) {",
            "        apply_node(2*k,lazy_[k]); apply_node(2*k+1,lazy_[k]); lazy_[k]=id();",
            "    }",
            "public:",
            "    explicit DualSegmentTree(const std::vector<Value>& values):n_(int(values.size())),values_(values) {",
            "        while(size_<n_) { size_*=2; ++log_; }",
            "        lazy_.assign(2*size_,id());",
            "    }",
            "    explicit DualSegmentTree(int n=0,Value initial=Value{}):DualSegmentTree(std::vector<Value>(n,initial)){}",
            "    int size() const { return n_; }",
            "    void apply(int l,int r,const Tag& f) {",
            "        assert(0<=l&&l<=r&&r<=n_);",
            "        if(l==r) return;",
            "        l+=size_; r+=size_;",
            "        // 境界の祖先の古い作用を先に下ろす。後から来た非可換作用との順序を維持。",
            "        for(int h=log_;h>=1;--h) {",
            "            if(((l>>h)<<h)!=l) push(l>>h);",
            "            if(((r>>h)<<h)!=r) push((r-1)>>h);",
            "        }",
            "        while(l<r) {",
            "            if(l&1) apply_node(l++,f);",
            "            if(r&1) apply_node(--r,f);",
            "            l>>=1; r>>=1;",
            "        }",
            "    }",
            "    Value get(int i) {",
            "        assert(0<=i&&i<n_);",
            "        int k=i+size_;",
            "        for(int h=log_;h>=1;--h) push(k>>h);",
            "        return values_[i];",
            "    }",
            "    void set(int i,const Value& x) {",
            "        assert(0<=i&&i<n_);",
            "        int k=i+size_;",
            "        for(int h=log_;h>=1;--h) push(k>>h);",
            "        values_[i]=x;",
            "    }",
            "};",
            "} // namespace cp",
            "#endif // CP_GENERATED_SEGTREE_DUAL_SEGMENT_TREE_HPP"
        ],
