            "// 空range_sum=0、空range_min=INF、空range_max=-INF。N=0も使用可。",
            "class SegmentTreeBeats {",
            "    using Wide=__int128_t;",
            "    static constexpr Wide INF=Wide(1)<<120;",
            "    // 第2極値と極値個数を持つため、chmin/chmaxが極値だけを変える場合はsumまで直接更新可。",
