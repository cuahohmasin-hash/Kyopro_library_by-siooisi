"HL分解": {
  "prefix": "snip_hld",
  "body": [
    "// HL分解 Heavy-Light Decomposition",
    "// 木上のパスを、配列上の O(log N) 個の区間 [l, r) に分解するライブラリ。",
    "// セグ木・遅延セグ木と組み合わせることで、パス更新・パス取得を扱える。",
    "//",
    "// 使い方:",
    "//   HLD hld(N);",
    "//   hld.add_edge(u, v);",
    "//   hld.build(root);",
    "//",
    "// 頂点に値がある場合:",
    "//   hld.path_vertex(u, v, [&](int l, int r) {",
    "//       // 配列上の区間 [l, r) を処理",
    "//   });",
    "//",
    "// 辺に値がある場合:",
    "//   辺 parent[x] - x の値を hld.pos[x] に置く。",
    "//   hld.path_edge(u, v, [&](int l, int r) {",
    "//       // u-v パス上の辺に対応する区間 [l, r) を処理",
    "//   });",
    "//",
    "// 計算量:",
    "//   build: O(N)",
    "//   path_vertex / path_edge: O(log N) 個の区間に分解",
    "//   セグ木と組み合わせると、パス操作 1 回あたり O(log^2 N) 程度",
    "// 注意: 再帰DFSを使うため、鎖状でNが大きい木ではスタック上限を確認する。",
    "//       path_* は区間の向きを返さないため、非可換な演算ではu側/v側を分けて処理する。",
    "",
    "struct HLD {",
    "    int n, cur;",
    "    vector<vector<int>> g;",
    "    vector<int> parent, depth, heavy, head, pos, rev, sz;",
    "",
    "    HLD(int n) : n(n), cur(0), g(n), parent(n), depth(n), heavy(n, -1),",
    "                 head(n), pos(n), rev(n), sz(n) {}",
    "",
    "    void add_edge(int u, int v) {",
    "        g[u].push_back(v);",
    "        g[v].push_back(u);",
    "    }",
    "",
    "    int dfs_sz(int v, int p) {",
    "        parent[v] = p;",
    "        sz[v] = 1;",
    "        int max_sz = 0;",
    "",
    "        for (int to : g[v]) {",
    "            if (to == p) continue;",
    "",
    "            depth[to] = depth[v] + 1;",
    "            int sub = dfs_sz(to, v);",
    "            sz[v] += sub;",
    "",
    "            // 一番大きい子部分木を heavy edge として採用する",
    "            if (sub > max_sz) {",
    "                max_sz = sub;",
    "                heavy[v] = to;",
    "            }",
    "        }",
    "",
    "        return sz[v];",
    "    }",
    "",
    "    void dfs_hld(int v, int h) {",
    "        head[v] = h;",
    "        pos[v] = cur;",
    "        rev[cur] = v;",
    "        cur++;",
    "",
    "        // heavy な子を先に進めることで、heavy path が配列上で連続になる",
    "        if (heavy[v] != -1) {",
    "            dfs_hld(heavy[v], h);",
    "        }",
    "",
    "        for (int to : g[v]) {",
    "            if (to == parent[v] || to == heavy[v]) continue;",
    "            dfs_hld(to, to);",
    "        }",
    "    }",
    "",
    "    void build(int root = 0) {",
    "        depth[root] = 0;",
    "        dfs_sz(root, -1);",
    "        dfs_hld(root, root);",
    "    }",
    "",
    "    // 頂点 u-v パスを、配列上の区間 [l, r) に分解する。",
    "    // 頂点に値がある問題で使う。LCA の頂点も含まれる。",
    "    template<class F>",
    "    void path_vertex(int u, int v, const F& f) const {",
    "        while (head[u] != head[v]) {",
    "            if (depth[head[u]] < depth[head[v]]) swap(u, v);",
    "",
    "            f(pos[head[u]], pos[u] + 1);",
    "            u = parent[head[u]];",
    "        }",
    "",
    "        if (depth[u] > depth[v]) swap(u, v);",
    "        f(pos[u], pos[v] + 1);",
    "    }",
    "",
    "    // 辺 u-v パスを、配列上の区間 [l, r) に分解する。",
    "    // 辺 parent[x] - x の値を pos[x] に置くことを前提にする。",
    "    // LCA 自身の pos は、対応するパス上の辺ではないので含めない。",
    "    template<class F>",
    "    void path_edge(int u, int v, const F& f) const {",
    "        while (head[u] != head[v]) {",
    "            if (depth[head[u]] < depth[head[v]]) swap(u, v);",
    "",
    "            f(pos[head[u]], pos[u] + 1);",
    "            u = parent[head[u]];",
    "        }",
    "",
    "        if (depth[u] > depth[v]) swap(u, v);",
    "",
    "        // u が LCA。辺クエリなので pos[u] は含めない",
    "        if (pos[u] + 1 <= pos[v]) {",
    "            f(pos[u] + 1, pos[v] + 1);",
    "        }",
    "    }",
    "",
    "    // 頂点 v の部分木を、配列上の区間 [l, r) に変換する。",
    "    pair<int, int> subtree(int v) const {",
    "        return {pos[v], pos[v] + sz[v]};",
    "    }",
    "",
    "    int lca(int u, int v) const {",
    "        while (head[u] != head[v]) {",
    "            if (depth[head[u]] < depth[head[v]]) swap(u, v);",
    "            u = parent[head[u]];",
    "        }",
    "",
    "        if (depth[u] > depth[v]) swap(u, v);",
    "        return u;",
    "    }",
    "};",
    "",
    "// ------------------------------------------------------------",
    "// ACL lazy_segtree 用: 区間加算・区間最小値",
    "// HLD と組み合わせると、パス加算・パス最小値ができる。",
    "// #include <atcoder/lazysegtree> が必要。",
    "// using namespace atcoder; が必要。",
    "// ------------------------------------------------------------",
    "",
    "using HldSegNode = long long;",
    "using F = long long;",
    "const long long HLD_INF = (1LL << 62);",
    "",
    "HldSegNode op_hld_min(HldSegNode a, HldSegNode b) {",
    "    return min(a, b);",
    "}",
    "",
    "HldSegNode e_hld_min() {",
    "    return HLD_INF;",
    "}",
    "",
    "HldSegNode mapping_hld_add(F f, HldSegNode x) {",
    "    return x == HLD_INF ? HLD_INF : x + f;",
    "}",
    "",
    "F composition_hld_add(F f, F g) {",
    "    return f + g;",
    "}",
    "",
    "F id_hld_add() {",
    "    return 0;",
    "}",
    "",
    "// 使用例:",
    "//",
    "// HLD hld(N);",
    "// rep(i, 0, N - 1) {",
    "//     int u, v;",
    "//     cin >> u >> v;",
    "//     u--; v--;",
    "//     hld.add_edge(u, v);",
    "// }",
    "// hld.build(0);",
    "//",
    "// vector<long long> base(N, HLD_INF);",
    "//",
    "// 辺に値がある場合:",
    "//   辺 parent[v] - v の値を base[hld.pos[v]] に置く。",
    "//   根には対応する辺がないので HLD_INF のままでよい。",
    "//",
    "// lazy_segtree<HldSegNode, op_hld_min, e_hld_min, F, mapping_hld_add, composition_hld_add, id_hld_add> seg(base);",
    "//",
    "// パス上の辺に +x:",
    "// hld.path_edge(u, v, [&](int l, int r) {",
