            "class OfflineDynamicConnectivity {",
            "    struct Event { int type,u,v,id; }; // 0:add,1:remove,2:same,3:size,4:components",
            "    int n_,queries_=0;",
            "    std::vector<Event> events_;",
            "    void check(int v) const { assert(0<=v && v<n_); }",
            "public:",
