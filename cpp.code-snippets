            "#ifndef CP_GENERATED_DP_MONOTONE_MINIMA_HPP",
            "#define CP_GENERATED_DP_MONOTONE_MINIMA_HPP",
            "// Header: resources/library/dp/monotone_minima.hpp",
            "#include <bits/stdc++.h>",
            "",
            "namespace cp {",
            "// 行ごとの「最左の最小値の列」が単調非減少な行列用。",
            "// value(row,col) を評価し、各行のargminを返す。O((rows+cols) log(rows+1))評価、O(rows)追加メモリ。",
            "// 行列本体は不要。0行は空、列は1以上（0行時のみ0列可）。",
            "template<class Value> std::vector<int> monotone_minima(int rows, int cols, Value value) {",
            "    if (rows < 0 || cols < 0 || (rows && !cols)) throw std::invalid_argument(\"monotone_minima: shape\");",
            "    std::vector<int> ans(rows,-1);",
            "    auto rec = [&](auto&& self, int l, int r, int cl, int cr) -> void {",
            "        if (l >= r) return;",
            "        int m = l+(r-l)/2, best = cl;",
            "        auto best_value = value(m,cl);",
            "        for (int j = cl+1; j < cr; ++j) {",
            "            auto cur = value(m,j); if (cur < best_value) { best_value = cur; best = j; }",
            "        }",
            "        ans[m] = best; self(self,l,m,cl,best+1); self(self,m+1,r,best,cr);",
            "    };",
            "    if (rows) rec(rec,0,rows,0,cols);",
            "    return ans;",
            "}",
            "",
            "// Totally monotone行列の各行の最左argmin。O(rows+cols)評価・メモリ（SMAWK）。",
            "// 単に元行列のargminが単調なだけでは不可：全ての部分行列でも単調が必要。",
            "// Monge行列（A[i,j]+A[i+1,j+1] <= A[i,j+1]+A[i+1,j]）はこの条件を満たす。",
            "template<class Value> std::vector<int> smawk(int rows, int cols, Value value) {",
            "    if (rows < 0 || cols < 0 || (rows && !cols)) throw std::invalid_argument(\"smawk: shape\");",
            "    std::vector<int> ans(rows,-1), rs(rows), cs(cols);",
            "    std::iota(rs.begin(),rs.end(),0); std::iota(cs.begin(),cs.end(),0);",
            "    auto rec = [&](auto&& self, const std::vector<int>& r, const std::vector<int>& c) -> void {",
            "        if (r.empty()) return;",
            "        std::vector<int> reduced; reduced.reserve(std::min(r.size(),c.size()));",
            "        for (int col : c) {",
            "            while (!reduced.empty()) {",
            "                int row = r[reduced.size()-1];",
            "                if (!(value(row,col) < value(row,reduced.back()))) break;",
            "                reduced.pop_back();",
            "            }",
            "            if (reduced.size() < r.size()) reduced.push_back(col);",
            "        }",
            "        std::vector<int> odd;",
            "        for (size_t i = 1; i < r.size(); i += 2) odd.push_back(r[i]);",
            "        self(self,odd,reduced);",
            "        size_t pos = 0;",
            "        for (size_t i = 0; i < r.size(); i += 2) {",
            "            int row = r[i], limit = i+1 < r.size() ? ans[r[i+1]] : reduced.back();",
            "            ans[row] = reduced[pos]; auto best = value(row,reduced[pos]);",
