"固定小数・円内格子点": {
  "prefix": "snip_geo_lattice_circle",
  "body": [
    "// ABC191 D型: 小数を10^digits倍の整数として読み、浮動小数なしで円内・円周上の格子点を数える。",
    "// 入力の小数桁はdigits以下（余分な桁は0のみ）、radius>=0、scale>0、全中間値がint128内を前提とする。",
    "// count_* は x 座標を走査するため O(radius / scale)。",
    "namespace lattice_circle {",
    "using i128 = __int128_t;",
    "// 機能: 小数文字列を10^digits倍した厳密な整数へ変換する。",
    "i128 parse_scaled(std::string s, int digits = 4) {",
    "    assert(digits >= 0 && !s.empty());",
    "    if (digits < 0 || s.empty()) return 0;",
    "    bool negative = false, saw_digit = false; int pos = 0;",
    "    if (!s.empty() && (s[0] == '+' || s[0] == '-')) negative = s[pos++] == '-';",
    "    i128 whole = 0;",
    "    while (pos < (int)s.size() && s[pos] != '.') {",
    "        if (s[pos] < '0' || '9' < s[pos]) throw invalid_argument(\"invalid decimal string\");",
    "        saw_digit = true; whole = whole * 10 + (s[pos++] - '0');",
    "    }",
    "    if (pos < (int)s.size() && s[pos] == '.') ++pos;",
    "    i128 frac = 0, scale = 1; int used = 0;",
    "    while (used < digits) {",
    "        int digit = 0;",
    "        if (pos < (int)s.size()) {",
    "            if (s[pos] < '0' || '9' < s[pos]) throw invalid_argument(\"invalid decimal string\");",
    "            saw_digit = true; digit = s[pos++] - '0';",
    "        }",
    "        frac = frac * 10 + digit; scale *= 10; ++used;",
    "    }",
    "    while (pos < (int)s.size()) {",
    "        if (s[pos] != '0') throw invalid_argument(\"too many fractional digits\");",
    "        saw_digit = true; ++pos;",
    "    }",
    "    if (!saw_digit) throw invalid_argument(\"decimal string has no digit\");",
    "    i128 value = whole * scale + frac; return negative ? -value : value;",
    "}",
    "// 機能: 負数にも対応した数学的な床除算 floor(a/b) を返す。",
    "i128 floor_div(i128 a, i128 b) {",
    "    if (b == 0) throw invalid_argument(\"floor_div requires non-zero divisor\");",
    "    i128 q = a / b, r = a % b; if (r != 0 && ((r > 0) != (b > 0))) --q; return q;",
    "}",
    "// 機能: 負数にも対応した数学的な天井除算 ceil(a/b) を返す。",
    "i128 ceil_div(i128 a, i128 b) { return -floor_div(-a, b); }",
    "// 機能: __int128 非負整数 n の floor(sqrt(n)) を厳密に返す。",
    "i128 floor_sqrt(i128 n) {",
    "    if (n < 0) return -1; i128 x = (i128)sqrtl((long double)n);",
    "    while (x + 1 <= n / (x + 1)) ++x;",
    "    while (x > 0 && x > n / x) --x;",
    "    return x;",
    "}",
    "// 機能: 固定倍率整数で表した円盤内・円周上の整数格子点数を厳密に数える。",
    "i128 count_inside(i128 cx, i128 cy, i128 radius, i128 scale) {",
    "    assert(radius >= 0 && scale > 0);",
    "    if (radius < 0 || scale <= 0) return 0;",
    "    i128 answer = 0, first_x = ceil_div(cx - radius, scale) * scale;",
    "    for (i128 x = first_x; x <= cx + radius; x += scale) {",
    "        i128 dx = x - cx, rem = radius * radius - dx * dx; if (rem < 0) continue;",
    "        i128 dy = floor_sqrt(rem);",
    "        answer += floor_div(cy + dy, scale) - ceil_div(cy - dy, scale) + 1;",
    "    }",
    "    return answer;",
    "}",
    "// 機能: 固定倍率整数で表した円周上だけの整数格子点数を厳密に数える。",
    "i128 count_on_circumference(i128 cx, i128 cy, i128 radius, i128 scale) {",
    "    assert(radius >= 0 && scale > 0);",
