    "// 機能: 点集合をすべて含む最小の軸平行外接長方形を返す。",
    "std::optional<Rect> bounding_box(const std::vector<Point>& p) {",
    "    if (p.empty()) return std::nullopt;",
    "    Rect r{p[0].x, p[0].y, p[0].x, p[0].y};",
    "    for (Point q : p) {",
    "        r.x1 = std::min(r.x1, q.x); r.x2 = std::max(r.x2, q.x);",
