  "body": [
    "// 依存: snip_geo2d_float。多角形の面積・重心・内外判定、凸包、凸切断、凸共通部分、直径・最小幅、Minkowski和。",
    "// convex_* / minimum_width / Minkowski和は、重複点なしのCCW凸多角形（通常はconvex_hull(..., false)）を渡す。",
    "// convex_polygon_intersectionは正面積の凸多角形用。点・線分へ退化した入力は対象外。",
    "namespace geo {",
    "using Polygon = std::vector<Point>;",
    "enum class Location { OUT, ON, IN };",
    "",
    "// 機能: 多角形の符号付き面積の2倍を返す。反時計回りなら正。",
    "Real polygon_signed_area2(const Polygon& p) {",
    "    Real s = 0; int n = (int)p.size();",
    "    for (int i = 0; i < n; ++i) s += cross(p[i], p[(i + 1) % n]);",
    "    return s; // CCWなら正、符号付き面積の2倍",
    "}",
    "// 機能: 多角形の通常の面積を返す。",
    "Real polygon_area(const Polygon& p) { return fabsl(polygon_signed_area2(p)) / 2; }",
    "// 機能: 多角形の全辺長を足して周長を返す。",
    "Real polygon_perimeter(const Polygon& p) {",
    "    Real ans = 0; int n = (int)p.size();",
    "    for (int i = 0; i < n; ++i) ans += distance(p[i], p[(i + 1) % n]);",
    "    return ans;",
    "}",
    "// 機能: 面積を持つ多角形の面積重心を返す。面積0なら nullopt。",
    "std::optional<Point> polygon_centroid(const Polygon& p) {",
    "    Real a2 = polygon_signed_area2(p);",
    "    if (sgn(a2) == 0) return std::nullopt;",
