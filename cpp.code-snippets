    "// 軸平行長方形の正規化・包含・交差・共通部分面積・bounding box・和集合面積。整数座標を厳密処理。",
    "namespace rectgeo {",
    "using i128 = __int128_t;",
    "struct Point { long long x, y; };",
    "struct Rect { long long x1, y1, x2, y2; }; // [x1,x2]×[y1,y2]。面積計算では境界は影響しない。",
    "// 機能: 長方形の端点順を x1≤x2・y1≤y2 となるよう正規化する。",
    "Rect normalized(Rect r) {",
    "    if (r.x1 > r.x2) std::swap(r.x1, r.x2);",
    "    if (r.y1 > r.y2) std::swap(r.y1, r.y2);",
    "    return r;",
    "}",
    "// 機能: 点が軸平行長方形の内部または境界上にあるか判定する。",
    "bool contains(Rect r, Point p, bool boundary = true) {",
    "    r = normalized(r);",
    "    if (boundary) return r.x1 <= p.x && p.x <= r.x2 && r.y1 <= p.y && p.y <= r.y2;",
