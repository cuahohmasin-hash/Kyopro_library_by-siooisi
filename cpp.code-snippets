            "    explicit MatrixProductSegTree(const std::vector<Matrix>& a):seg(a){}",
            "    explicit MatrixProductSegTree(int n=0):seg(n){}",
            "    void set(int i,const Matrix& m){seg.set(i,m);}",
            "    Matrix prod(int l,int r)const{return seg.prod(l,r);}",
