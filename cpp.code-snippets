"円周順序・角度区間": {
  "prefix": "snip_geo_cyclic_angle",
  "body": [
    "// 円周上の角度・巡回区間。最小被覆弧、一定幅の弧内最大点数、円周上の弦交差判定を収録。",
    "namespace cyclic_geo {",
    "using Real = long double;",
    "constexpr Real EPS = 1e-12L;",
    "const Real PI = acosl(-1.0L);",
    "// 機能: 角度を [0,2π) へ正規化する。",
    "Real normalize(Real a) { a = fmodl(a, 2 * PI); if (a < 0) a += 2 * PI; return a; }",
    "// 機能: from から to へ反時計回りに進む角度を [0,2π) で返す。",
    "Real ccw_distance(Real from, Real to) { return normalize(to - from); }",
    "// 機能: 2角度間の短い方の角距離を返す。",
    "Real angular_distance(Real a, Real b) { Real d = ccw_distance(a, b); return std::min(d, 2 * PI - d); }",
    "// 機能: angle が from から反時計回りに to へ進む円弧上にあるか判定する。",
    "bool in_ccw_arc(Real angle, Real from, Real to, bool boundary = true) {",
    "    Real whole = ccw_distance(from, to), part = ccw_distance(from, angle);",
    "    return boundary ? part <= whole + EPS : (part > EPS && part < whole - EPS);",
    "}",
    "",
    "struct CoveringArc { Real length = 0, from = 0, to = 0; };",
    "// 機能: 与えた全角度を含む最短円弧とその始点・終点を求める。",
    "CoveringArc minimum_covering_arc(std::vector<Real> angles) {",
    "    if (angles.empty()) return {};",
    "    for (Real& a : angles) a = normalize(a);",
    "    std::sort(angles.begin(), angles.end()); int n = (int)angles.size();",
    "    Real largest_gap = -1; int gap_after = 0;",
    "    for (int i = 0; i < n; ++i) {",
    "        Real next = i + 1 < n ? angles[i + 1] : angles[0] + 2 * PI;",
    "        if (next - angles[i] > largest_gap) largest_gap = next - angles[i], gap_after = i;",
    "    }",
    "    Real from = angles[(gap_after + 1) % n], to = angles[gap_after];",
    "    return {2 * PI - largest_gap, from, to};",
    "}",
    "// 機能: 幅 width の円弧内に同時に含められる角度点数の最大値を求める。",
    "int max_points_in_arc(std::vector<Real> angles, Real width, bool boundary = true) {",
    "    int n = (int)angles.size(); if (n == 0) return 0;",
    "    if (width >= 2 * PI - EPS) return n;",
    "    for (Real& a : angles) a = normalize(a); std::sort(angles.begin(), angles.end());",
    "    std::vector<Real> doubled = angles; for (Real a : angles) doubled.push_back(a + 2 * PI);",
    "    int answer = 1, r = 0;",
    "    for (int l = 0; l < n; ++l) {",
    "        r = std::max(r, l);",
    "        while (r + 1 < l + n) {",
    "            Real span = doubled[r + 1] - doubled[l];",
    "            if (boundary ? span <= width + EPS : span < width - EPS) ++r; else break;",
    "        }",
    "        answer = std::max(answer, r - l + 1);",
    "    }",
    "    return answer; // sort込み O(N log N)",
    "}",
    "// 機能: 半円内に同時に含められる角度点数の最大値を求める。",
    "int max_points_in_semicircle(std::vector<Real> angles, bool boundary = true) {",
    "    return max_points_in_arc(std::move(angles), PI, boundary);",
    "}",
    "// 機能: 円周上の複数の反時計回り円弧の和集合長を求める。",
    "Real circular_interval_union_length(const std::vector<std::pair<Real, Real>>& ccw_arcs) {",
    "    std::vector<std::pair<Real, Real>> intervals;",
    "    for (auto [from, to] : ccw_arcs) {",
    "        from = normalize(from); to = normalize(to); Real len = ccw_distance(from, to);",
    "        if (len <= EPS) continue; // from==to は長さ0の弧として扱う",
    "        if (from <= to) intervals.push_back({from, to});",
    "        else { intervals.push_back({from, 2 * PI}); intervals.push_back({0, to}); }",
    "    }",
    "    std::sort(intervals.begin(), intervals.end()); Real answer = 0, l = 0, r = -1;",
    "    for (auto [a, b] : intervals) {",
    "        if (r < a - EPS) { if (r >= 0) answer += r - l; l = a; r = b; }",
    "        else r = std::max(r, b);",
    "    }",
    "    if (r >= 0) answer += r - l; return answer;",
    "}",
    "",
    "// 機能: 巡回添字で left から正方向に right へ進む区間内に x があるか判定する。",
    "bool cyclic_between(int x, int left, int right, int n, bool boundary = false) {",
    "    // 円周indexで left から正方向に right へ進む弧上に x があるか。",
    "    auto delta = [&](int a, int b) { int d = (b - a) % n; if (d < 0) d += n; return d; };",
    "    int whole = delta(left, right), part = delta(left, x);",
    "    return boundary ? part <= whole : (0 < part && part < whole);",
    "}",
    "// 機能: 円周上の4端点を結ぶ2本の弦が円内部で真に交差するか判定する。",
    "bool chords_properly_intersect(int a, int b, int c, int d, int n) {",
    "    // 4端点が相異なる前提。端点が円周上で交互に現れる iff 円内部で交差する。",
    "    if (a == b || c == d || a == c || a == d || b == c || b == d) return false;",
    "    return cyclic_between(c, a, b, n) != cyclic_between(d, a, b, n)",
    "        && cyclic_between(a, c, d, n) != cyclic_between(b, c, d, n);",
    "}",
    "} // namespace cyclic_geo",
    "$0"
  ],
  "description": "円周角度の正規化、巡回弧判定、最小被覆弧、半円内最大点数、角度区間和、弦交差"
},
"動点・衝突幾何": {
  "prefix": "snip_geo_moving",
  "body": [
    "// 依存: snip_geo2d_float + snip_geo_circle_triangle。等速動点・円盤衝突・壁反射。",
    "// 前提: from<=to、円半径は非負。静止点が常に円周上なら時刻{-inf,+inf}を返す。",
    "namespace geo {",
    "struct ClosestApproach { Real time = 0, distance = 0; Point first{}, second{}; };",
    "// 二次方程式 A*t^2+B*t+C=0 の実数解を桁落ちしにくい形で昇順に返す。",
    "std::vector<Real> stable_quadratic_roots(Real A, Real B, Real C) {",
    "    if (fabsl(A) <= EPS * EPS) return {};",
    "    Real disc = B * B - 4 * A * C;",
    "    Real tol = EPS * std::max({1.0L, fabsl(B * B), fabsl(4 * A * C)});",
    "    if (disc < -tol) return {};",
    "    Real root_disc = sqrtl(std::max(0.0L, disc));",
    "    if (root_disc <= EPS) return {-B / (2 * A)};",
    "    Real q = -0.5L * (B + copysignl(root_disc, B));",
    "    Real x1 = q / A, x2 = C / q;",
    "    if (x1 > x2) std::swap(x1, x2);",
    "    return {x1, x2};",
    "}",
    "// 機能: 等速直線運動する2点が指定時間区間で最接近する時刻・距離・位置を求める。",
    "ClosestApproach closest_approach(Point p, Point velocity_p, Point q, Point velocity_q, Real from, Real to) {",
    "    if (from > to) throw invalid_argument(\"closest_approach requires from <= to\");",
    "    Point relative = p - q, velocity = velocity_p - velocity_q; Real vv = norm2(velocity);",
    "    Real t = vv <= EPS * EPS ? from : std::clamp(-dot(relative, velocity) / vv, from, to);",
    "    Point a = p + velocity_p * t, b = q + velocity_q * t;",
    "    return {t, geo::distance(a, b), a, b};",
    "}",
    "// 機能: 等速運動する2円盤が指定時間区間で初めて接触・重なる時刻を返す。",
    "std::optional<Real> first_disk_collision_time(Point p, Point velocity_p, Real radius_p,",
    "                                               Point q, Point velocity_q, Real radius_q,",
    "                                               Real from = 0, Real to = std::numeric_limits<Real>::infinity()) {",
    "    if (from > to || radius_p < 0 || radius_q < 0) throw invalid_argument(\"invalid collision interval or radius\");",
    "    Point r = p - q, v = velocity_p - velocity_q; Real radius = radius_p + radius_q;",
    "    auto value = [&](Real t) { return norm2(r + v * t) - radius * radius; };",
    "    if (value(from) <= EPS) return from;",
    "    Real A = norm2(v), B = 2 * dot(r, v), C = norm2(r) - radius * radius;",
    "    if (A <= EPS * EPS) return std::nullopt;",
    "    for (Real root : stable_quadratic_roots(A, B, C)) {",
    "        if (root < from - EPS) continue;",
    "        Real t = std::max(from, root);",
    "        if (t <= to + EPS && value(t) <= EPS * std::max(1.0L, radius * radius)) return t;",
    "    }",
    "    return std::nullopt;",
    "}",
    "// 機能: 直線壁で鏡面反射した後の速度ベクトルを返す。",
    "Point reflect_velocity(Point velocity, Line wall) {",
    "    Point tangent = unit(wall.b - wall.a);",
    "    if (length(tangent) <= EPS) return -velocity;",
    "    Point normal = perp(tangent); return velocity - normal * (2 * dot(velocity, normal));",
    "}",
    "// 機能: 等速動点が円周上に来る時刻を負時刻も含めて返す。",
    "std::vector<Real> moving_point_circle_times(Point p, Point velocity, Circle c) {",
    "    // p + velocity*t が円周に来る全時刻（負時刻も含む）。",
    "    if (c.radius < 0) throw invalid_argument(\"circle radius must be non-negative\");",
    "    Point r = p - c.center; Real A = norm2(velocity), B = 2 * dot(r, velocity), C = norm2(r) - c.radius * c.radius;",
    "    if (A <= EPS * EPS) return fabsl(C) <= EPS ? std::vector<Real>{-std::numeric_limits<Real>::infinity(), std::numeric_limits<Real>::infinity()} : std::vector<Real>{};",
    "    return stable_quadratic_roots(A, B, C);",
    "}",
    "} // namespace geo",
    "$0"
  ],
  "description": "等速動点の最近接、動く2円盤の初回衝突、直線壁での速度反射、動点と円の接触時刻"
},
"3D幾何フル": {
  "prefix": "snip_geo3d",
  "body": [
    "// 独立したlong double版3D幾何。ベクトル、直線・線分・平面、球、回転、球面距離を収録。",
    "// EPSは入力スケールに合わせる。Planeを直接作る場合はnormal!=0、球半径は非負を前提とする。",
    "namespace geo3 {",
    "using Real = long double;",
    "constexpr Real EPS = 1e-12L;",
    "const Real PI = acosl(-1.0L);",
    "// 機能: 実数を EPS 込みで負・0・正の -1/0/1 に分類する。",
    "int sgn(Real x) { return (x > EPS) - (x < -EPS); }",
    "// 機能: 値を [-1,1] に丸め、逆三角関数の定義域外を防ぐ。",
    "Real clamp_unit(Real x) { return std::max(-1.0L, std::min(1.0L, x)); }",
    "struct Point {",
    "    Real x = 0, y = 0, z = 0;",
    "    // 機能: 3D点・ベクトルをそのまま返す単項プラス演算子。",
    "    Point operator+() const { return *this; }",
    "    // 機能: 3D点・ベクトルの全成分の符号を反転する。",
    "    Point operator-() const { return {-x, -y, -z}; }",
    "    // 機能: 2つの3D点・ベクトルを成分ごとに加算する。",
    "    Point operator+(Point p) const { return {x + p.x, y + p.y, z + p.z}; }",
    "    // 機能: 2つの3D点・ベクトルを成分ごとに減算する。",
    "    Point operator-(Point p) const { return {x - p.x, y - p.y, z - p.z}; }",
    "    // 機能: 3D点・ベクトルを実数倍する。",
    "    Point operator*(Real k) const { return {x * k, y * k, z * k}; }",
    "    // 機能: 3D点・ベクトルを実数で割る。",
    "    Point operator/(Real k) const { return {x / k, y / k, z / k}; }",
    "};",
    "// 機能: 実数を左辺に置いたスカラー倍 k*p を使えるようにする。",
    "Point operator*(Real k, Point p) { return p * k; }",
    "// 機能: 2つの3Dベクトルの内積を返す。",
    "Real dot(Point a, Point b) { return a.x * b.x + a.y * b.y + a.z * b.z; }",
    "// 機能: 2つの3Dベクトルの外積ベクトルを返す。",
    "Point cross(Point a, Point b) { return {a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x}; }",
    "// 機能: 3Dベクトルの長さの2乗を返す。",
    "Real norm2(Point p) { return dot(p, p); }",
    "// 機能: 3Dベクトルの長さを返す。",
    "Real length(Point p) { return sqrtl(std::max(0.0L, norm2(p))); }",
    "// 機能: 2つの3D点間のユークリッド距離を返す。",
    "Real distance(Point a, Point b) { return length(a - b); }",
    "// 機能: 同方向の単位ベクトルを返す。ゼロならゼロベクトル。",
    "Point unit(Point p) { Real d = length(p); return d <= EPS ? Point{} : p / d; }",
    "// 機能: スカラー三重積 a・(b×c) を返し、体積や共面判定に使う。",
    "Real scalar_triple(Point a, Point b, Point c) { return dot(a, cross(b, c)); }",
    "// 機能: 2つの3Dベクトル間の小さい角度をラジアンで返す。",
    "Real angle_between(Point a, Point b) { Real d = length(a) * length(b); return d <= EPS ? 0 : acosl(clamp_unit(dot(a,b)/d)); }",
    "// 機能: ベクトル p を指定軸の周りに rad ラジアン回転する。",
    "Point rotate_around_axis(Point p, Point unit_axis, Real rad) {",
    "    if (length(unit_axis) <= EPS) return p;",
    "    Point u = unit(unit_axis); Real c = cosl(rad), s = sinl(rad);",
    "    return p * c + cross(u, p) * s + u * (dot(u, p) * (1 - c));",
    "}",
    "",
    "struct Line { Point point, direction; };",
    "struct Segment { Point a, b; };",
    "struct Plane { Point normal; Real offset = 0; }; // dot(normal, X) = offset",
    "struct Sphere { Point center; Real radius = 0; };",
    "// 機能: 3点 a・b・c を通る平面を作る。3点が共線ならnullopt。",
    "std::optional<Plane> plane_through(Point a, Point b, Point c) {",
    "    Point n = cross(b - a, c - a);",
    "    if (length(n) <= EPS) return std::nullopt;",
    "    return Plane{n, dot(n, a)};",
    "}",
    "// 機能: 点 x を平面 p へ正射影した点を返す。",
    "Point projection(Plane p, Point x) {",
    "    Real z = norm2(p.normal);",
    "    if (z <= EPS * EPS) throw invalid_argument(\"projection requires non-degenerate plane\");",
    "    return x - p.normal * ((dot(p.normal, x) - p.offset) / z);",
    "}",
    "// 機能: 点 x を平面 p に関して面対称移動した点を返す。",
    "Point reflection(Plane p, Point x) { return projection(p, x) * 2 - x; }",
    "// 機能: 点と平面の最短距離を返す。",
    "Real distance_point_plane(Point x, Plane p) {",
    "    Real d = length(p.normal);",
    "    if (d <= EPS) throw invalid_argument(\"distance_point_plane requires non-degenerate plane\");",
    "    return fabsl(dot(p.normal, x) - p.offset) / d;",
    "}",
    "// 機能: 3D直線上で点 p に最も近い点を返す。",
    "Point closest_point(Line l, Point p) {",
    "    Real z = norm2(l.direction); return z <= EPS * EPS ? l.point : l.point + l.direction * (dot(p - l.point, l.direction) / z);",
    "}",
    "// 機能: 3D線分上で点 p に最も近い点を返す。",
    "Point closest_point(Segment s, Point p) {",
    "    Point d = s.b - s.a; Real z = norm2(d); if (z <= EPS * EPS) return s.a;",
    "    return s.a + d * std::clamp(dot(p - s.a, d) / z, 0.0L, 1.0L);",
    "}",
    "// 機能: 点と3D直線の最短距離を返す。",
    "Real distance_point_line(Point p, Line l) { return distance(p, closest_point(l, p)); }",
    "// 機能: 点と3D線分の最短距離を返す。",
    "Real distance_point_segment(Point p, Segment s) { return distance(p, closest_point(s, p)); }",
    "",
    "struct LinePlaneIntersection { int count = 0; Point point{}; }; // 0:none, 1:unique, -1:line lies on plane",
    "// 機能: 3D直線と平面の共通部分を「なし・一点・直線全体」に分類する。",
    "LinePlaneIntersection line_plane_intersection(Line l, Plane p) {",
    "    if (length(p.normal) <= EPS) throw invalid_argument(\"line_plane_intersection requires non-degenerate plane\");",
    "    if (length(l.direction) <= EPS) {",
    "        return {fabsl(dot(p.normal, l.point) - p.offset) <= EPS ? 1 : 0, l.point};",
    "    }",
    "    Real den = dot(p.normal, l.direction), num = p.offset - dot(p.normal, l.point);",
    "    if (sgn(den) == 0) return {sgn(num) == 0 ? -1 : 0, {}};",
    "    return {1, l.point + l.direction * (num / den)};",
    "}",
    "struct PlanePlaneIntersection { int count = 0; Line line{}; }; // 0:none, 1:line, -1:same plane",
    "// 機能: 2平面の共通部分を「なし・一本の直線・同一平面」に分類する。",
    "PlanePlaneIntersection plane_plane_intersection(Plane a, Plane b) {",
    "    if (length(a.normal) <= EPS || length(b.normal) <= EPS) throw invalid_argument(\"plane_plane_intersection requires non-degenerate planes\");",
    "    Point direction = cross(a.normal, b.normal); Real z = norm2(direction);",
    "    if (z <= EPS * EPS) {",
    "        Point sample = a.normal * (a.offset / norm2(a.normal));",
    "        bool same = fabsl(dot(b.normal, sample) - b.offset) <= EPS;",
    "        return {same ? -1 : 0, {}};",
    "    }",
    "    Point p = cross(b.normal * a.offset - a.normal * b.offset, direction) / z;",
    "    return {1, {p, direction}};",
    "}",
    "// 機能: 非平行な2直線上の最近点をそれぞれ1点ずつ返す。",
    "std::optional<std::pair<Point, Point>> closest_points(Line a, Line b) {",
    "    Point u = a.direction, v = b.direction, w = a.point - b.point;",
    "    Real aa = dot(u,u), bb = dot(u,v), cc = dot(v,v), dd = dot(u,w), ee = dot(v,w);",
    "    Real den = aa * cc - bb * bb; if (fabsl(den) <= EPS || aa <= EPS * EPS || cc <= EPS * EPS) return std::nullopt;",
    "    Real s = (bb * ee - cc * dd) / den, t = (aa * ee - bb * dd) / den;",
    "    return std::pair<Point,Point>{a.point + u * s, b.point + v * t};",
    "}",
    "// 機能: 平行・交差・ねじれを含む2つの3D直線間距離を返す。",
    "Real distance_line_line(Line a, Line b) {",
    "    if (norm2(a.direction) <= EPS * EPS) return distance_point_line(a.point, b);",
    "    if (norm2(b.direction) <= EPS * EPS) return distance_point_line(b.point, a);",
    "    Point n = cross(a.direction, b.direction);",
    "    if (length(n) <= EPS) return length(cross(b.point - a.point, a.direction)) / length(a.direction);",
    "    return fabsl(dot(b.point - a.point, n)) / length(n);",
    "}",
    "// 機能: 3D空間内の三角形面積を外積の長さから求める。",
    "Real triangle_area(Point a, Point b, Point c) { return length(cross(b - a, c - a)) / 2; }",
    "// 機能: 四面体の符号付き体積の6倍を返す。",
    "Real tetrahedron_signed_volume6(Point a, Point b, Point c, Point d) { return scalar_triple(b - a, c - a, d - a); }",
    "// 機能: 四面体の通常の体積を返す。",
    "Real tetrahedron_volume(Point a, Point b, Point c, Point d) { return fabsl(tetrahedron_signed_volume6(a,b,c,d)) / 6; }",
    "",
    "// 機能: 球面と3D直線の交点を0～2点で返す。",
    "std::vector<Point> sphere_line_intersections(Sphere s, Line l) {",
    "    if (s.radius < 0) throw invalid_argument(\"sphere radius must be non-negative\");",
    "    if (norm2(l.direction) <= EPS * EPS) return fabsl(distance(s.center,l.point)-s.radius)<=EPS ? std::vector<Point>{l.point} : std::vector<Point>{};",
    "    Point h = closest_point(l, s.center); Real rem = s.radius * s.radius - norm2(h - s.center);",
    "    if (rem < -EPS) return {}; if (rem <= EPS) return {h};",
    "    Point d = unit(l.direction) * sqrtl(rem); return {h - d, h + d};",
    "}",
    "enum class SphereIntersectionType { NONE, POINT, CIRCLE, COINCIDENT };",
    "struct SphereIntersection { SphereIntersectionType type = SphereIntersectionType::NONE; Point center{}, normal{}; Real radius = 0; };",
    "// 機能: 2球面の共通部分をなし・一点・円・一致に分類する。",
    "SphereIntersection sphere_sphere_intersection(Sphere a, Sphere b) {",
    "    if (a.radius < 0 || b.radius < 0) throw invalid_argument(\"sphere radius must be non-negative\");",
    "    Point v = b.center - a.center; Real d = length(v);",
    "    if (d <= EPS) return {fabsl(a.radius-b.radius)<=EPS ? SphereIntersectionType::COINCIDENT : SphereIntersectionType::NONE, {}, {}, 0};",
    "    if (d > a.radius + b.radius + EPS || d < fabsl(a.radius - b.radius) - EPS) return {};",
    "    Real x = (a.radius*a.radius - b.radius*b.radius + d*d) / (2*d);",
    "    Real h2 = std::max(0.0L, a.radius*a.radius - x*x); Point center = a.center + v * (x/d);",
    "    return {h2 <= EPS ? SphereIntersectionType::POINT : SphereIntersectionType::CIRCLE, center, unit(v), sqrtl(h2)};",
    "}",
    "// 機能: 緯度経度をラジアンで受け取り、球面上の大円距離をhaversine式で返す。",
    "Real great_circle_distance(Real lat1, Real lon1, Real lat2, Real lon2, Real sphere_radius = 1) {",
    "    // 緯度経度はradian。haversineで微小距離にも比較的安定。",
    "    Real dlat = lat2-lat1, dlon = lon2-lon1;",
    "    Real h = sinl(dlat/2)*sinl(dlat/2) + cosl(lat1)*cosl(lat2)*sinl(dlon/2)*sinl(dlon/2);",
    "    return 2 * sphere_radius * asinl(sqrtl(std::clamp(h, 0.0L, 1.0L)));",
    "}",
    "} // namespace geo3",
    "$0"
  ],
  "description": "3Dベクトル、直線・線分・平面の交点距離、球交差、軸回転、三角形・四面体、球面距離"
},
"桁DP 区間差分": {
  "prefix": "snip_digit_dp_range_sub",
  "body": [
    "// F(R) - F(L - 1) で閉区間 L <= X <= R の加算可能な集計値を求める。",
    "// 個数・桁和・数字出現回数など専用。最大値・最小値には使用できない。",
    "// snip_digit_dp_fold と併用し、calc_leq(bound)にはF(bound)を返すラムダを渡す。",
    "// L,Rはlong longを超えてよい10進文字列。Dataはoperator-=と加法単位元Data{}を持つこと。",
    "// leading zeroを区別する場合はstartedを状態に含める。",
    "// 計算量: calc_leqと同じく O((|L| + |R|) * STATE_SIZE * base)。",
    "",
    "// 非負10進文字列から余分な上位0を除く。",
    "string normalize_decimal_string(string s) {",
    "    if (s.empty()) return string(1, '0');",
