    "    void add(int ql, int qr, int value, int node, int l, int r) {",
    "        if (qr <= l || r <= ql) return;",
    "        if (ql <= l && r <= qr) cover[node] += value;",
    "        else {",
    "            int m = (l + r) / 2; add(ql, qr, value, node * 2, l, m); add(ql, qr, value, node * 2 + 1, m, r);",
