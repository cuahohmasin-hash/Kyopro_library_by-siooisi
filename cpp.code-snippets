    "        upd(i, j); upd(ni, j);",
    "    }",
    "    return ans;",
    "}",
    "",
    "// 機能: 整数線分上の格子点数を両端込みで求める。",
    "i128 lattice_points_on_segment(Point a, Point b) {",
    "    i128 dx = (i128)b.x - a.x, dy = (i128)b.y - a.y;",
    "    return gcd128(dx, dy) + 1;",
    "}",
    "// 機能: 格子多角形の境界上にある格子点の総数を求める。",
    "i128 polygon_boundary_lattice_points(const std::vector<Point>& p) {",
    "    i128 b = 0; int n = (int)p.size();",
    "    for (int i = 0; i < n; ++i) {",
    "        Point q = p[(i + 1) % n];",
    "        b += gcd128((i128)q.x - p[i].x, (i128)q.y - p[i].y);",
    "    }",
    "    return b;",
    "}",
    "// 機能: 単純格子多角形の内部格子点数をPickの定理で求める。",
    "i128 polygon_interior_lattice_points(const std::vector<Point>& p) {",
    "    // Pick: 2I = |2S| - B + 2。単純格子多角形が前提。",
    "    return (abs128(polygon_area2(p)) - polygon_boundary_lattice_points(p) + 2) / 2;",
    "}",
    "",
    "// a,b,c が作る円上に d があるか。a,b,c が非共線であること。",
    "// 機能: 非共線な a・b・c が定める円周上に d もあるか厳密判定する。",
    "bool concyclic(Point a, Point b, Point c, Point d) {",
    "    i128 bx = (i128)b.x - a.x, by = (i128)b.y - a.y;",
    "    i128 cx = (i128)c.x - a.x, cy = (i128)c.y - a.y;",
    "    i128 dx = (i128)d.x - a.x, dy = (i128)d.y - a.y;",
    "    i128 b2 = bx * bx + by * by, c2 = cx * cx + cy * cy, d2 = dx * dx + dy * dy;",
    "    i128 det = b2 * (cx * dy - cy * dx)",
    "             - c2 * (bx * dy - by * dx)",
    "             + d2 * (bx * cy - by * cx);",
    "    return det == 0;",
    "}",
    "// 機能: 点集合全体が1つの有限半径の円周上に乗り得るか判定する。",
    "bool can_lie_on_one_circle(std::vector<Point> p) {",
    "    std::sort(p.begin(), p.end());",
    "    p.erase(std::unique(p.begin(), p.end()), p.end());",
    "    if (p.size() <= 2) return true;",
    "    int k = -1;",
    "    for (int i = 2; i < (int)p.size(); ++i) if (cross(p[0], p[1], p[i]) != 0) { k = i; break; }",
    "    if (k == -1) return false; // 3点以上が一直線なら有限半径の円には乗らない",
    "    for (Point q : p) if (!concyclic(p[0], p[1], p[k], q)) return false;",
    "    return true;",
    "}",
    "} // namespace igeo",
    "$0"
  ],
  "description": "__int128による整数2D幾何フルセット。線分、直線、垂直二等分線、偏角、凸包、格子点、共円判定"
},
"実数2D幾何コア・直線・線分": {
  "prefix": "snip_geo2d_float",
  "body": [
    "// long double 版2D幾何コア。点・ベクトル・角度・直線・半直線・線分・交点・射影・距離を収録。",
    "// 判定だけ整数で完結する問題では snip_geo2d_int を優先し、交点座標などが必要なときに使う。",
    "// EPSは入力座標の規模に合わせて調整する。orient/parallel等の絶対EPS判定はスケール依存。",
    "namespace geo {",
    "using Real = long double;",
    "constexpr Real EPS = 1e-12L;",
    "const Real PI = acosl(-1.0L);",
    "",
    "// 機能: 実数を EPS 込みで負・0・正の -1/0/1 に分類する。",
    "int sgn(Real x) { return (x > EPS) - (x < -EPS); }",
    "// 機能: 相対誤差を考慮して2つの実数が等しいか判定する。",
    "bool eq(Real a, Real b) {",
    "    return fabsl(a - b) <= EPS * std::max({1.0L, fabsl(a), fabsl(b)});",
    "}",
    "// 機能: 値を [-1,1] に丸め、acos・asin の誤差による定義域外を防ぐ。",
    "Real clamp_unit(Real x) { return std::max(-1.0L, std::min(1.0L, x)); }",
    "// 機能: 角度を [0,2π) の範囲へ正規化する。",
    "Real normalize_angle(Real a) {",
    "    a = fmodl(a, 2 * PI);",
    "    if (a < 0) a += 2 * PI;",
    "    return a; // [0, 2PI)",
    "}",
    "// 機能: 角度を [-π,π) の範囲へ正規化する。",
    "Real normalize_signed_angle(Real a) {",
    "    a = normalize_angle(a);",
    "    if (a >= PI) a -= 2 * PI;",
    "    return a; // [-PI, PI)",
    "}",
    "",
    "struct Point {",
    "    Real x = 0, y = 0;",
    "    // 機能: 点・ベクトルをそのまま返す単項プラス演算子。",
    "    Point operator+() const { return *this; }",
    "    // 機能: 点・ベクトルの全成分の符号を反転する。",
    "    Point operator-() const { return {-x, -y}; }",
    "    // 機能: 2つの点・ベクトルを成分ごとに加算する。",
    "    Point operator+(const Point& p) const { return {x + p.x, y + p.y}; }",
    "    // 機能: 2つの点・ベクトルを成分ごとに減算する。",
    "    Point operator-(const Point& p) const { return {x - p.x, y - p.y}; }",
    "    // 機能: 点・ベクトルを実数倍する。",
    "    Point operator*(Real k) const { return {x * k, y * k}; }",
    "    // 機能: 点・ベクトルを実数で割る。",
    "    Point operator/(Real k) const { return {x / k, y / k}; }",
    "    // 機能: 現在の点・ベクトルへ別のベクトルを加算する。",
    "    Point& operator+=(const Point& p) { x += p.x; y += p.y; return *this; }",
    "    // 機能: 現在の点・ベクトルから別のベクトルを減算する。",
    "    Point& operator-=(const Point& p) { x -= p.x; y -= p.y; return *this; }",
    "    // 機能: 現在の点・ベクトルを実数倍する。",
    "    Point& operator*=(Real k) { x *= k; y *= k; return *this; }",
    "};",
    "// 機能: 実数を左辺に置いたスカラー倍 k*p を使えるようにする。",
    "Point operator*(Real k, Point p) { return p * k; }",
    "// 機能: 絶対EPSで2点が同一点か判定する。",
    "bool same_point(Point a, Point b) { return fabsl(a.x - b.x) <= EPS && fabsl(a.y - b.y) <= EPS; }",
    "// 機能: 点を x 優先、次に y の辞書順で比較する。",
    "bool lex_less(Point a, Point b) { return a.x != b.x ? a.x < b.x : a.y < b.y; }",
    "",
    "// 機能: 2ベクトルの内積を返す。",
    "Real dot(Point a, Point b) { return a.x * b.x + a.y * b.y; }",
    "// 機能: 2ベクトルの2次元外積を返す。",
    "Real cross(Point a, Point b) { return a.x * b.y - a.y * b.x; }",
    "// 機能: ベクトル OA と OB の外積を返す。",
    "Real cross(Point o, Point a, Point b) { return cross(a - o, b - o); }",
    "// 機能: ベクトルの長さの2乗を返す。",
    "Real norm2(Point p) { return dot(p, p); }",
    "// 機能: 2点間距離の2乗を返す。",
    "Real dist2(Point a, Point b) { return norm2(a - b); }",
    "// 機能: ベクトルのユークリッド長を返す。",
    "Real length(Point p) { return sqrtl(std::max(0.0L, norm2(p))); }",
    "// 機能: 2点間のユークリッド距離を返す。",
    "Real distance(Point a, Point b) { return length(a - b); }",
    "// 機能: ベクトルを反時計回りへ90度回転した垂直ベクトルを返す。",
    "Point perp(Point p) { return {-p.y, p.x}; }",
    "// 機能: 同方向の単位ベクトルを返す。ゼロベクトルならゼロを返す。",
    "Point unit(Point p) { Real d = length(p); return d <= EPS ? Point{} : p / d; }",
    "// 機能: ベクトルを原点中心に rad ラジアン回転する。",
    "Point rotate(Point p, Real rad) {",
    "    Real c = cosl(rad), s = sinl(rad);",
    "    return {c * p.x - s * p.y, s * p.x + c * p.y};",
    "}",
    "// 機能: ベクトルの偏角を atan2 により [-π,π] 付近の値で返す。",
    "Real argument(Point p) { return atan2l(p.y, p.x); }",
    "// 機能: 2ベクトル間の小さい方の角度をラジアンで返す。",
    "Real angle_between(Point a, Point b) {",
    "    Real den = length(a) * length(b);",
    "    return den <= EPS ? 0 : acosl(clamp_unit(dot(a, b) / den));",
    "}",
    "// 機能: 有向直線 a→b に対する c の左・右・共線を EPS 込みで返す。",
    "int orient(Point a, Point b, Point c) { return sgn(cross(a, b, c)); }",
    "",
    "// +1:反時計回り, -1:時計回り, +2:C-A-B, -2:A-B-C, 0:線分AB上",
    "// 機能: 3点の左右関係と、共線時の線分上・前後関係を5分類する。",
    "int ccw(Point a, Point b, Point c) {",
    "    Point ab = b - a, ac = c - a;",
    "    int cr = sgn(cross(ab, ac));",
    "    if (cr != 0) return cr;",
    "    if (sgn(dot(ab, ac)) < 0) return 2;",
    "    if (sgn(norm2(ab) - norm2(ac)) < 0) return -2;",
    "    return 0;",
    "}",
    "",
    "struct Line { Point a, b; };",
    "struct Segment { Point a, b; };",
    "struct Ray { Point origin, through; };",
    "// 機能: 直線を表す2点が一致し、実質的に一点へ退化しているか判定する。",
    "bool degenerate(Line l) { return same_point(l.a, l.b); }",
    "// 機能: 線分の両端点が一致し、長さ0か判定する。",
    "bool degenerate(Segment s) { return same_point(s.a, s.b); }",
    "// 機能: 2直線が平行か EPS 込みで判定する。",
    "bool parallel(Line l, Line m) { return sgn(cross(l.b - l.a, m.b - m.a)) == 0; }",
    "// 機能: 2直線が垂直か EPS 込みで判定する。",
    "bool orthogonal(Line l, Line m) { return sgn(dot(l.b - l.a, m.b - m.a)) == 0; }",
    "// 機能: 点 p が無限直線 l 上にあるか判定する。",
    "bool on_line(Line l, Point p) {",
    "    return degenerate(l) ? same_point(l.a, p) : sgn(cross(l.b - l.a, p - l.a)) == 0;",
    "}",
    "// 機能: 点 p が半直線 r 上にあるか判定する。",
    "bool on_ray(Ray r, Point p) {",
    "    Point d = r.through - r.origin;",
    "    if (length(d) <= EPS) return same_point(r.origin, p);",
    "    return sgn(cross(d, p - r.origin)) == 0 && sgn(dot(d, p - r.origin)) >= 0;",
    "}",
    "// 機能: 点 p が端点を含む線分 s 上にあるか判定する。",
    "bool on_segment(Segment s, Point p) {",
    "    return sgn(cross(s.b - s.a, p - s.a)) == 0 && sgn(dot(p - s.a, p - s.b)) <= 0;",
    "}",
    "",
    "struct LineIntersection {",
    "    int count = 0; // 0:なし, 1:一意, -1:同一直線",
    "    Point point;",
    "};",
    "// 機能: 2直線の共通部分を「なし・一意な交点・同一直線」に分類する。",
    "LineIntersection line_intersection(Line l, Line m) {",
    "    bool dl = degenerate(l), dm = degenerate(m);",
    "    if (dl && dm) return {same_point(l.a, m.a) ? 1 : 0, l.a};",
    "    if (dl) return {on_line(m, l.a) ? 1 : 0, l.a};",
    "    if (dm) return {on_line(l, m.a) ? 1 : 0, m.a};",
    "    Point u = l.b - l.a, v = m.b - m.a;",
    "    Real det = cross(u, v);",
    "    if (sgn(det) == 0) return {on_line(l, m.a) ? -1 : 0, {}};",
    "    Real t = cross(m.a - l.a, v) / det;",
    "    return {1, l.a + u * t};",
    "}",
    "",
    "// 機能: 点 p を直線 l へ正射影した垂線の足を返す。",
    "Point projection(Line l, Point p) {",
    "    Point d = l.b - l.a; Real z = norm2(d);",
    "    return z <= EPS * EPS ? l.a : l.a + d * (dot(p - l.a, d) / z);",
    "}",
    "// 機能: 点 p を直線 l に関して線対称移動した点を返す。",
    "Point reflection(Line l, Point p) { return projection(l, p) * 2 - p; }",
    "// 機能: 線分 s 上で点 p に最も近い点を返す。",
    "Point closest_point(Segment s, Point p) {",
    "    Point d = s.b - s.a; Real z = norm2(d);",
    "    if (z <= EPS * EPS) return s.a;",
    "    Real t = std::clamp(dot(p - s.a, d) / z, 0.0L, 1.0L);",
    "    return s.a + d * t;",
    "}",
    "// 機能: 点 p と無限直線 l の最短距離を返す。",
    "Real distance_point_line(Point p, Line l) {",
    "    Point d = l.b - l.a;",
    "    return length(d) <= EPS ? distance(p, l.a) : fabsl(cross(d, p - l.a)) / length(d);",
    "}",
    "// 機能: 点 p と有限線分 s の最短距離を返す。",
    "Real distance_point_segment(Point p, Segment s) { return distance(p, closest_point(s, p)); }",
    "",
    "// 機能: 2線分が端点以外の内部で真に交差するか判定する。",
    "bool segments_properly_intersect(Segment s, Segment t) {",
    "    return orient(s.a, s.b, t.a) * orient(s.a, s.b, t.b) < 0",
    "        && orient(t.a, t.b, s.a) * orient(t.a, t.b, s.b) < 0;",
    "}",
    "// 機能: 2線分が端点接触・重なりを含めて交差するか判定する。",
    "bool segments_intersect(Segment s, Segment t) {",
    "    if (on_segment(s, t.a) || on_segment(s, t.b) || on_segment(t, s.a) || on_segment(t, s.b)) return true;",
    "    return segments_properly_intersect(s, t);",
    "}",
    "// 機能: 2線分の共通部分を0点・1点・重なり区間の2端点として返す。",
    "std::vector<Point> segment_intersection_points(Segment s, Segment t) {",
    "    std::vector<Point> ans;",
    "    auto add = [&](Point p) {",
    "        for (Point q : ans) if (same_point(p, q)) return;",
    "        ans.push_back(p);",
    "    };",
    "    if (on_segment(s, t.a)) add(t.a);",
    "    if (on_segment(s, t.b)) add(t.b);",
    "    if (on_segment(t, s.a)) add(s.a);",
    "    if (on_segment(t, s.b)) add(s.b);",
    "    if (ans.empty() && segments_properly_intersect(s, t)) {",
    "        auto z = line_intersection({s.a, s.b}, {t.a, t.b});",
    "        if (z.count == 1) add(z.point);",
    "    }",
    "    std::sort(ans.begin(), ans.end(), lex_less);",
    "    return ans; // 0点、1点、または重なり区間の2端点",
    "}",
    "// 機能: 2線分間の最短距離を返す。交差時は0。",
    "Real distance_segment_segment(Segment s, Segment t) {",
    "    if (segments_intersect(s, t)) return 0;",
    "    return std::min({distance_point_segment(s.a, t), distance_point_segment(s.b, t),",
    "                     distance_point_segment(t.a, s), distance_point_segment(t.b, s)});",
    "}",
    "",
    "// 正規化済み a*x+b*y+c=0（sqrt(a^2+b^2)=1、符号を統一）。",
    "struct NormalLine { Real a = 0, b = 0, c = 0; };",
    "// 機能: 直線を単位法線を持つ一意に近い標準形 ax+by+c=0 へ変換する。",
    "std::optional<NormalLine> normal_form(Line l) {",
    "    Point d = l.b - l.a; Real z = length(d);",
    "    if (z <= EPS) return std::nullopt;",
    "    Real a = -d.y / z, b = d.x / z, c = -(a * l.a.x + b * l.a.y);",
    "    if (a < -EPS || (fabsl(a) <= EPS && b < -EPS)) a = -a, b = -b, c = -c;",
    "    return NormalLine{a, b, c};",
    "}",
    "} // namespace geo",
    "$0"
  ],
  "description": "long doubleの2D点・ベクトル・角度・直線・半直線・線分・交差点・射影・距離ライブラリ"
},
"円・三角形幾何フル": {
  "prefix": "snip_geo_circle_triangle",
  "body": [
    "// 依存: snip_geo2d_float。円の交点・接線・共通部分、円構築、三角形の各中心を収録。",
    "// 前提: Circleの半径は非負。退化入力を許すかは各関数の戻り値コメントを確認する。",
    "namespace geo {",
    "struct Circle { Point center; Real radius = 0; };",
    "",
    "enum class CirclePointRelation { INSIDE, ON, OUTSIDE };",
    "// 機能: 点が円の内部・円周上・外部のどこにあるか分類する。",
    "CirclePointRelation circle_point_relation(Circle c, Point p) {",
    "    int z = sgn(distance(c.center, p) - c.radius);",
    "    return z < 0 ? CirclePointRelation::INSIDE : (z == 0 ? CirclePointRelation::ON : CirclePointRelation::OUTSIDE);",
    "}",
    "// 機能: 点の円に対する方べき |PC|^2-r^2 を返す。",
    "Real power(Circle c, Point p) { return norm2(p - c.center) - c.radius * c.radius; }",
    "",
    "// 機能: 円と無限直線の交点を0個・1個・2個の点として返す。",
    "std::vector<Point> circle_line_intersections(Circle c, Line l) {",
    "    if (degenerate(l)) return circle_point_relation(c, l.a) == CirclePointRelation::ON",
    "        ? std::vector<Point>{l.a} : std::vector<Point>{};",
    "    Point h = projection(l, c.center);",
    "    Real h2 = norm2(h - c.center), rem = c.radius * c.radius - h2;",
    "    if (rem < -EPS) return {};",
    "    if (rem <= EPS) return {h};",
    "    Point d = unit(l.b - l.a) * sqrtl(std::max(0.0L, rem));",
    "    return {h - d, h + d};",
    "}",
    "// 機能: 円と有限線分の交点だけを0～2点で返す。",
    "std::vector<Point> circle_segment_intersections(Circle c, Segment s) {",
    "    if (degenerate(s)) return circle_point_relation(c, s.a) == CirclePointRelation::ON",
    "        ? std::vector<Point>{s.a} : std::vector<Point>{};",
    "    std::vector<Point> ans;",
    "    for (Point p : circle_line_intersections(c, {s.a, s.b})) if (on_segment(s, p)) ans.push_back(p);",
    "    if (ans.size() == 2 && same_point(ans[0], ans[1])) ans.pop_back();",
    "    return ans;",
    "}",
    "",
    "enum class CircleRelation {",
    "    SEPARATE, EXTERNALLY_TANGENT, INTERSECT, INTERNALLY_TANGENT,",
    "    CONTAINED, CONCENTRIC, COINCIDENT",
    "};",
    "// 機能: 2円の離隔・外接・交差・内接・包含・同心・一致を分類する。",
    "CircleRelation circle_relation(Circle a, Circle b) {",
    "    Real d = distance(a.center, b.center);",
    "    if (d <= EPS) return eq(a.radius, b.radius) ? CircleRelation::COINCIDENT : CircleRelation::CONCENTRIC;",
    "    Real sum = a.radius + b.radius, dif = fabsl(a.radius - b.radius);",
    "    if (d > sum + EPS) return CircleRelation::SEPARATE;",
    "    if (eq(d, sum)) return CircleRelation::EXTERNALLY_TANGENT;",
    "    if (d < dif - EPS) return CircleRelation::CONTAINED;",
    "    if (eq(d, dif)) return CircleRelation::INTERNALLY_TANGENT;",
    "    return CircleRelation::INTERSECT;",
    "}",
    "// 機能: 2円の交点を0個・1個・2個で返す。同一円の無限交点は空で返す。",
    "std::vector<Point> circle_circle_intersections(Circle a, Circle b) {",
    "    CircleRelation rel = circle_relation(a, b);",
    "    if (rel != CircleRelation::INTERSECT && rel != CircleRelation::EXTERNALLY_TANGENT",
    "        && rel != CircleRelation::INTERNALLY_TANGENT) return {};",
    "    Point v = b.center - a.center; Real d = length(v);",
    "    Real x = (a.radius * a.radius - b.radius * b.radius + d * d) / (2 * d);",
    "    Real h2 = std::max(0.0L, a.radius * a.radius - x * x);",
    "    Point base = a.center + v * (x / d);",
    "    if (h2 <= EPS) return {base};",
    "    Point off = perp(v) * (sqrtl(h2) / d);",
    "    return {base - off, base + off};",
    "}",
    "",
    "// 機能: 点 p から円 c へ引ける接線の接点を0～2点返す。",
