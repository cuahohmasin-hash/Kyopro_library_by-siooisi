            "#ifndef CP_GENERATED_SEGTREE_WEIGHTED_FLIP_HPP",
            "#define CP_GENERATED_SEGTREE_WEIGHTED_FLIP_HPP",
            "// Header: resources/library/segtree/weighted_flip.hpp",
            "#include <bits/stdc++.h>",
            "#include <atcoder/lazysegtree>",
            "",
            "namespace cp {",
            "// WeightedFlipSumSegTree seg(lengths,bits); leaf iはlengths[i]個分の同じ0/1。",
            "// flip(l,r)、range_ones(l,r)、range_zeros(l,r)。各操作O(log N)、構築O(N)。",
            "// 座標版: auto seg=WeightedFlipSumSegTree::from_coordinates(bounds);",
            "// 全更新/問合せの両端を先読みしてboundsに入れる。重複/未整列の境界も可。",
            "// flip_coordinates(L,R), ones_coordinates(L,R)は座標の半開区間[L,R)。",
            "// 初期は全0（第2引数で全1）。L/Rは登録済み境界であること。閉区間ならR+1を登録。",
            "// 長さ・答えはint128。LLONG_MINからLLONG_MAXまでの境界差も計算できる。",
            "struct WeightedFlipSumSegTree {",
            "    using i128=__int128_t;",
            "    // lenは圧縮後の葉の個数でなく実長。1の実長onesを持てば反転後はlen-onesで得られる。",
            "    struct Node { i128 len=0,ones=0; };",
            "    // 左右の実長と1の実長を加算。空区間は両方0で反転しても変わらない。",
            "    static Node op(Node x,Node y) { return {x.len+y.len,x.ones+y.ones}; }",
            "    static Node e() { return {}; }",
            "    static Node mapping(bool f,Node x) { if(f) x.ones=x.len-x.ones; return x; }",
            "    static bool composition(bool f,bool g) { return f!=g; } // gの後にf。2回反転は打ち消し合う。",
            "    static bool id() { return false; }",
            "    // 1つの葉は均一bitの実長L: {len=L,ones=L*bit}。境界を追加せず途中だけ更新はできない。",
            "    static std::vector<Node> leaves(const std::vector<long long>& lengths,const std::vector<int>& bits) {",
            "        assert(bits.empty()||bits.size()==lengths.size());",
            "        std::vector<Node> v; v.reserve(lengths.size());",
            "        for(size_t i=0;i<lengths.size();++i) {",
            "            int b=bits.empty()?0:bits[i]; assert(lengths[i]>=0&&(b==0||b==1));",
            "            v.push_back({lengths[i],i128(lengths[i])*b});",
            "        }",
            "        return v;",
            "    }",
            "    atcoder::lazy_segtree<Node,op,e,bool,mapping,composition,id> seg;",
            "    std::vector<long long> coordinates;",
            "    explicit WeightedFlipSumSegTree(const std::vector<long long>& lengths={},const std::vector<int>& bits={}):seg(leaves(lengths,bits)){}",
            "    static WeightedFlipSumSegTree from_coordinates(std::vector<long long> bounds,int initial=0) {",
            "        assert(initial==0||initial==1);",
            "        std::sort(bounds.begin(),bounds.end());",
            "        bounds.erase(std::unique(bounds.begin(),bounds.end()),bounds.end());",
            "        std::vector<Node> v;",
            "        for(size_t i=1;i<bounds.size();++i) {",
            "            i128 len=i128(bounds[i])-bounds[i-1];",
            "            v.push_back({len,len*initial});",
            "        }",
            "        WeightedFlipSumSegTree out;",
            "        out.seg=decltype(seg)(v); out.coordinates=std::move(bounds);",
            "        return out;",
            "    }",
            "    int coordinate_index(long long x) const {",
            "        auto it=std::lower_bound(coordinates.begin(),coordinates.end(),x);",
            "        assert(it!=coordinates.end()&&*it==x);",
            "        return int(it-coordinates.begin());",
            "    }",
            "    void flip(int l,int r) { seg.apply(l,r,true); }",
            "    void set(int i,int bit) { assert(bit==0||bit==1); auto x=seg.get(i); x.ones=x.len*bit; seg.set(i,x); }",
            "    Node prod(int l,int r) { return seg.prod(l,r); }",
            "    Node all_prod() { return seg.all_prod(); }",
            "    i128 range_ones(int l,int r) { return prod(l,r).ones; }",
            "    i128 range_zeros(int l,int r) { auto x=prod(l,r); return x.len-x.ones; }",
            "    void flip_coordinates(long long l,long long r) { assert(l<=r); flip(coordinate_index(l),coordinate_index(r)); }",
            "    i128 ones_coordinates(long long l,long long r) { assert(l<=r); return range_ones(coordinate_index(l),coordinate_index(r)); }",
            "};",
            "} // namespace cp",
            "#endif // CP_GENERATED_SEGTREE_WEIGHTED_FLIP_HPP"
        ],
        "description": "[典型完成品] 長さ付き圧縮座標の01反転・個数 / cp名前空間 / ヘッダの使用例・条件参照"
    },
    "追加ライブラリ: 区間加算・最小値位置の重み和と個数": {
        "prefix": "snip_lazyseg_weighted_min",
        "body": [
            "#ifndef CP_GENERATED_SEGTREE_WEIGHTED_MIN_COUNT_HPP",
            "#define CP_GENERATED_SEGTREE_WEIGHTED_MIN_COUNT_HPP",
            "// Header: resources/library/segtree/weighted_min_count.hpp",
