    "XOR制約グラフ": {
        "prefix": "snip_xor_constraint_graph",
        "body": [
            "// XOR制約 A[u] xor A[v] = z を管理するグラフ。非負整数向け。",
            "// 各連結成分では、全解が A[v] = value[v] xor C (Cは成分共通) の形になる。",
            "// 使い方:",
            "// XorConstraintGraph<ll> xg(N);",
            "// xg.add(u, v, z); // A[u] xor A[v] = z",
            "// if (!xg.build()) { cout << -1 << '\\n'; return 0; } // 矛盾判定",
            "// auto ans = xg.min_sum_assignment(); // sum(A[i]) 最小の具体解",
            "// build後: value[v]=成分の基準頂点を0とした相対値、components=成分ごとの頂点一覧",
            "// diff(u,v)=同成分なら A[u] xor A[v]、別成分ならnullopt",
            "// min_weighted_sum_assignment(w)=非負重みwについて sum(w[i]*A[i]) を最小化",
            "template<class T = ll>",
            "struct XorConstraintGraph {",
            "    static_assert(is_integral_v<T> && !is_same_v<T, bool>);",
            "    int n;",
            "    vector<vector<pair<int, T>>> G;",
            "    vector<T> value;                  // A[v] xor A[root] (各成分でrootの値を0とした相対XOR)",
            "    vector<int> comp_id;              // 頂点 -> components のindex",
            "    vector<vector<int>> components;   // 連結成分ごとの頂点一覧",
            "    bool built = false;",
            "    bool valid = true;",
            "",
            "    explicit XorConstraintGraph(int n)",
            "        : n(n), G(n), value(n, 0), comp_id(n, -1) {}",
            "",
            "    // A[u] xor A[v] = z という制約を追加",
            "    void add(int u, int v, T z) {",
            "        assert(!built);",
            "        if constexpr (is_signed_v<T>) assert(z >= 0);",
            "        G[u].push_back({v, z});",
            "        G[v].push_back({u, z});",
            "    }",
            "",
            "    // 全制約を伝播し、矛盾がなければtrue。O(N+M)",
            "    bool build() {",
            "        if (built) return valid;",
            "        built = true;",
            "        vector<char> seen(n, false);",
            "",
            "        for (int s = 0; s < n; s++) {",
            "            if (seen[s]) continue;",
            "            int cid = (int)components.size();",
            "            components.push_back({});",
            "            queue<int> q;",
            "            seen[s] = true;",
            "            value[s] = 0;",
            "            comp_id[s] = cid;",
            "            q.push(s);",
            "",
            "            while (!q.empty()) {",
            "                int v = q.front(); q.pop();",
            "                components[cid].push_back(v);",
            "                for (auto [to, z] : G[v]) {",
            "                    T nv = value[v] ^ z;",
            "                    if (!seen[to]) {",
            "                        seen[to] = true;",
            "                        value[to] = nv;",
            "                        comp_id[to] = cid;",
            "                        q.push(to);",
            "                    } else if (value[to] != nv) {",
            "                        valid = false;",
            "                    }",
            "                }",
            "            }",
            "        }",
            "        return valid;",
            "    }",
            "",
            "    bool same(int u, int v) const {",
            "        assert(built);",
            "        return comp_id[u] == comp_id[v];",
            "    }",
            "",
            "    // 同じ連結成分なら A[u] xor A[v] を返す。別成分ならnullopt。",
            "    optional<T> diff(int u, int v) const {",
            "        assert(built);",
            "        if (!same(u, v)) return nullopt;",
            "        return value[u] ^ value[v];",
            "    }",
            "",
            "    // 各成分に共通XOR offset[c] を与えて具体解を作る",
            "    vector<T> assignment(const vector<T>& offset) const {",
            "        assert(built && valid);",
            "        assert((int)offset.size() == (int)components.size());",
            "        vector<T> ans(n);",
            "        for (int v = 0; v < n; v++) ans[v] = value[v] ^ offset[comp_id[v]];",
            "        return ans;",
            "    }",
            "",
            "    // sum(A[i]) が最小となる具体解を返す",
            "    // 各成分・各bitで、valueの1が過半数ならそのbitを成分全体で反転する",
            "    vector<T> min_sum_assignment() const {",
            "        assert(built && valid);",
            "        constexpr int B = numeric_limits<T>::digits;",
            "        vector<T> offset(components.size(), 0);",
            "",
            "        for (int cid = 0; cid < (int)components.size(); cid++) {",
            "            const auto& vs = components[cid];",
            "            for (int bit = 0; bit < B; bit++) {",
            "                int ones = 0;",
            "                for (int v : vs) ones += (value[v] >> bit) & T(1);",
            "                if (ones * 2 > (int)vs.size()) offset[cid] |= T(1) << bit;",
            "            }",
            "        }",
            "        return assignment(offset);",
            "    }",
            "",
            "    // sum(weight[i] * A[i]) が最小となる具体解を返す。weightは非負整数。",
            "    template<class W>",
            "    vector<T> min_weighted_sum_assignment(const vector<W>& weight) const {",
            "        static_assert(is_integral_v<W> && sizeof(W) <= 8);",
            "        assert(built && valid);",
            "        assert((int)weight.size() == n);",
            "        constexpr int B = numeric_limits<T>::digits;",
            "        vector<T> offset(components.size(), 0);",
            "",
            "        for (int cid = 0; cid < (int)components.size(); cid++) {",
            "            const auto& vs = components[cid];",
            "            int128 total = 0;",
            "            for (int v : vs) {",
            "                if constexpr (is_signed_v<W>) assert(weight[v] >= 0);",
            "                total += (int128)weight[v];",
            "            }",
            "            for (int bit = 0; bit < B; bit++) {",
            "                int128 one_weight = 0;",
            "                for (int v : vs) {",
            "                    if ((value[v] >> bit) & T(1)) one_weight += (int128)weight[v];",
            "                }",
            "                if (one_weight * 2 > total) offset[cid] |= T(1) << bit;",
            "            }",
            "        }",
            "        return assignment(offset);",
            "    }",
            "};",
            "$0"
        ],
