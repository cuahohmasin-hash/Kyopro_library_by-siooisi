"点集合幾何（最近点対・最小包含円）": {
  "prefix": "snip_geo_pointset",
  "body": [
    "// 依存: snip_geo2d_float + snip_geo_circle_triangle。最近点対、最小包含円、固定半径円の最大包含点数、幾何中央値。",
    "namespace geo {",
    "struct ClosestPairResult {",
    "    Real distance = std::numeric_limits<Real>::infinity();",
    "    Point a{}, b{};",
    "};",
    "// 機能: 点集合の最近点対・その距離を分割統治で O(N log N) で求める。",
    "ClosestPairResult closest_pair(std::vector<Point> p) {",
    "    int n = (int)p.size(); if (n < 2) return {};",
    "    std::sort(p.begin(), p.end(), lex_less);",
    "    std::vector<Point> buf(n);",
    "    std::function<ClosestPairResult(int, int)> rec = [&](int l, int r) -> ClosestPairResult {",
    "        ClosestPairResult best;",
    "        if (r - l <= 3) {",
    "            for (int i = l; i < r; ++i) for (int j = i + 1; j < r; ++j) {",
    "                Real d = geo::distance(p[i], p[j]);",
    "                if (d < best.distance) best = {d, p[i], p[j]};",
    "            }",
    "            std::sort(p.begin() + l, p.begin() + r, [](Point a, Point b) {",
    "                return a.y != b.y ? a.y < b.y : a.x < b.x;",
    "            });",
    "            return best;",
    "        }",
    "        int m = (l + r) / 2; Real mid_x = p[m].x;",
    "        auto left = rec(l, m), right = rec(m, r);",
    "        best = left.distance <= right.distance ? left : right;",
    "        std::merge(p.begin() + l, p.begin() + m, p.begin() + m, p.begin() + r, buf.begin() + l,",
    "            [](Point a, Point b) { return a.y != b.y ? a.y < b.y : a.x < b.x; });",
    "        std::copy(buf.begin() + l, buf.begin() + r, p.begin() + l);",
    "        std::vector<Point> strip; strip.reserve(r - l);",
    "        for (int i = l; i < r; ++i) if (fabsl(p[i].x - mid_x) <= best.distance + EPS) {",
    "            for (int j = (int)strip.size() - 1; j >= 0; --j) {",
    "                if (p[i].y - strip[j].y > best.distance + EPS) break;",
    "                Real d = geo::distance(p[i], strip[j]);",
    "                if (d < best.distance) best = {d, p[i], strip[j]};",
    "            }",
    "            strip.push_back(p[i]);",
    "        }",
    "        return best;",
    "    };",
    "    return rec(0, n); // O(N log N)",
    "}",
    "",
    "// 機能: 円盤 c が点 p を誤差込みで内部または円周上に含むか判定する。",
    "bool circle_covers(Circle c, Point p) {",
    "    return distance(c.center, p) <= c.radius + EPS * std::max(1.0L, c.radius);",
    "}",
    "// 機能: 3点を覆う候補円を作り、共線時は最遠2点を直径とする円を返す。",
    "Circle circle_from_three_covering(Point a, Point b, Point c) {",
    "    auto z = circumcircle(a, b, c);",
    "    if (z) return *z;",
    "    Circle x = circle_from_diameter(a, b), y = circle_from_diameter(a, c), w = circle_from_diameter(b, c);",
    "    Circle best = x; if (y.radius > best.radius) best = y; if (w.radius > best.radius) best = w;",
    "    return best;",
    "}",
    "// 機能: 全点を覆う最小包含円をランダム化アルゴリズムで期待 O(N) で求める。",
    "std::optional<Circle> minimum_enclosing_circle(std::vector<Point> p, uint64_t seed = 0x9e3779b97f4a7c15ULL) {",
    "    if (p.empty()) return std::nullopt;",
    "    std::mt19937_64 rng(seed); std::shuffle(p.begin(), p.end(), rng);",
    "    Circle c{p[0], 0};",
    "    for (int i = 0; i < (int)p.size(); ++i) if (!circle_covers(c, p[i])) {",
    "        c = {p[i], 0};",
    "        for (int j = 0; j < i; ++j) if (!circle_covers(c, p[j])) {",
    "            c = circle_from_diameter(p[i], p[j]);",
    "            for (int k = 0; k < j; ++k) if (!circle_covers(c, p[k]))",
    "                c = circle_from_three_covering(p[i], p[j], p[k]);",
    "        }",
    "    }",
    "    return c; // 期待 O(N)",
    "}",
    "",
    "// 機能: 半径固定の円盤を自由配置したときに含められる点数の最大値を求める。",
    "int max_points_in_circle(const std::vector<Point>& p, Real radius) {",
    "    int n = (int)p.size(), answer = 0;",
    "    if (radius <= EPS) {",
    "        for (int i = 0; i < n; ++i) {",
    "            int count = 0; for (Point q : p) count += same_point(p[i], q);",
    "            answer = std::max(answer, count);",
    "        }",
    "        return answer;",
    "    }",
    "    for (int i = 0; i < n; ++i) {",
    "        int base = 1; std::vector<std::pair<Real, int>> events;",
    "        auto add_interval = [&](Real l, Real r) {",
    "            // [l,r] とその2PI平行移動を置き、中央の1周 [2PI,4PI) をsweepする。",
    "            events.push_back({l, +1}); events.push_back({r, -1});",
    "            events.push_back({l + 2 * PI, +1}); events.push_back({r + 2 * PI, -1});",
    "        };",
    "        for (int j = 0; j < n; ++j) if (i != j) {",
    "            Real d = distance(p[i], p[j]);",
    "            if (d <= EPS) { ++base; continue; }",
    "            if (d > 2 * radius + EPS) continue;",
    "            Real a = normalize_angle(argument(p[j] - p[i]));",
    "            Real delta = acosl(clamp_unit(d / (2 * radius)));",
    "            Real l = normalize_angle(a - delta), r = l + 2 * delta;",
    "            add_interval(l, r);",
    "        }",
    "        std::sort(events.begin(), events.end(), [](auto a, auto b) {",
    "            if (a.first != b.first) return a.first < b.first;",
    "            return a.second > b.second; // 閉区間なので開始を先に処理",
    "        });",
    "        int cur = base; answer = std::max(answer, cur);",
    "        for (int e = 0; e < (int)events.size();) {",
    "            int f = e; while (f < (int)events.size() && events[f].first <= events[e].first + EPS) ++f;",
    "            for (int k = e; k < f; ++k) if (events[k].second > 0) cur += events[k].second;",
    "            if (events[f - 1].first >= 2 * PI - EPS && events[e].first <= 4 * PI + EPS) answer = std::max(answer, cur);",
    "            for (int k = e; k < f; ++k) if (events[k].second < 0) cur += events[k].second;",
    "            e = f;",
    "        }",
    "    }",
    "    return answer; // O(N^2 log N)",
    "}",
    "",
    "// 機能: 全点へのユークリッド距離和を最小化する幾何中央値をWeiszfeld法で近似する。",
    "Point geometric_median(const std::vector<Point>& p, int iterations = 200) {",
    "    if (p.empty()) return {};",
    "    Point x{}; for (Point q : p) x += q; x = x / (Real)p.size();",
    "    for (int it = 0; it < iterations; ++it) {",
    "        Point num{}; Real den = 0;",
    "        for (Point q : p) {",
    "            Real w = 1 / std::max(distance(x, q), 1e-18L); num += q * w; den += w;",
    "        }",
    "        Point nx = num / den; if (distance(x, nx) <= EPS) break; x = nx;",
    "    }",
    "    return x; // Weiszfeld法による近似",
    "}",
    "} // namespace geo",
    "$0"
  ],
  "description": "最近点対O(NlogN)、最小包含円期待O(N)、固定半径円の最大包含点数、幾何中央値"
},
"円と領域の高度幾何": {
  "prefix": "snip_geo_circle_area_advanced",
  "body": [
    "// 依存: snip_geo2d_float + snip_geo_circle_triangle + snip_geo_polygon_convex。",
    "// 円と多角形の共通部分面積、複数円の和集合面積、円反転、Apolloniusの円を収録。",
    "namespace geo {",
    "// 機能: 原点中心円盤と有向三角形 O-a-b の共通部分の符号付き面積を求める内部関数。",
    "Real signed_circle_triangle_area(Point a, Point b, Real radius) {",
    "    // 円の中心を原点とした有向三角形 O-a-b と円の共通部分の符号付き面積。",
    "    Point d = b - a; Real A = norm2(d), B = 2 * dot(a, d), C = norm2(a) - radius * radius;",
    "    std::vector<Real> ts{0, 1};",
    "    if (A > EPS) {",
    "        Real disc = B * B - 4 * A * C;",
    "        if (disc >= -EPS) {",
    "            disc = sqrtl(std::max(0.0L, disc));",
    "            Real t1 = (-B - disc) / (2 * A), t2 = (-B + disc) / (2 * A);",
    "            if (EPS < t1 && t1 < 1 - EPS) ts.push_back(t1);",
    "            if (EPS < t2 && t2 < 1 - EPS) ts.push_back(t2);",
    "        }",
    "    }",
    "    std::sort(ts.begin(), ts.end());",
    "    Real ans = 0;",
    "    for (int i = 0; i + 1 < (int)ts.size(); ++i) {",
    "        Point u = a + d * ts[i], v = a + d * ts[i + 1];",
    "        Point mid = (u + v) / 2;",
    "        if (norm2(mid) <= radius * radius + EPS) ans += cross(u, v) / 2;",
    "        else ans += radius * radius * atan2l(cross(u, v), dot(u, v)) / 2;",
    "    }",
    "    return ans;",
    "}",
    "// 機能: 円盤と多角形の共通部分面積を O(N) で求める。",
    "Real circle_polygon_intersection_area(Circle c, const Polygon& p) {",
    "    Real ans = 0; int n = (int)p.size();",
    "    for (int i = 0; i < n; ++i)",
    "        ans += signed_circle_triangle_area(p[i] - c.center, p[(i + 1) % n] - c.center, c.radius);",
    "    return fabsl(ans); // O(N)",
    "}",
    "",
    "// 機能: 複数円盤の和集合面積を O(N^2 log N) で求める。",
    "Real circle_union_area(const std::vector<Circle>& circles) {",
    "    // 各円周の『他円に覆われていない弧』をGreenの定理で積分。O(N^2 log N)",
    "    Real area = 0; int n = (int)circles.size();",
    "    for (int i = 0; i < n; ++i) {",
    "        Circle a = circles[i]; if (a.radius <= EPS) continue;",
    "        bool fully_covered = false; std::vector<std::pair<Real, Real>> covered;",
    "        for (int j = 0; j < n; ++j) if (i != j) {",
    "            Circle b = circles[j]; Real d = distance(a.center, b.center);",
    "            if (d <= EPS && eq(a.radius, b.radius)) {",
    "                if (j < i) fully_covered = true;",
    "                continue;",
    "            }",
    "            if (d + a.radius <= b.radius + EPS) { fully_covered = true; break; }",
    "            if (d >= a.radius + b.radius - EPS || d + b.radius <= a.radius + EPS || d <= EPS) continue;",
    "            Real mid = normalize_angle(argument(b.center - a.center));",
    "            Real delta = acosl(clamp_unit((a.radius * a.radius + d * d - b.radius * b.radius) / (2 * a.radius * d)));",
    "            Real l = normalize_angle(mid - delta), r = normalize_angle(mid + delta);",
    "            if (l <= r) covered.push_back({l, r});",
    "            else { covered.push_back({l, 2 * PI}); covered.push_back({0, r}); }",
    "        }",
    "        if (fully_covered) continue;",
    "        std::sort(covered.begin(), covered.end());",
    "        std::vector<std::pair<Real, Real>> merged;",
    "        for (auto [l, r] : covered) {",
    "            if (merged.empty() || l > merged.back().second + EPS) merged.push_back({l, r});",
    "            else merged.back().second = std::max(merged.back().second, r);",
    "        }",
    "        auto add_arc = [&](Real l, Real r) {",
    "            if (r <= l + EPS) return;",
    "            Point u{cosl(l), sinl(l)}, v{cosl(r), sinl(r)};",
    "            area += (cross(a.center, (v - u) * a.radius) + a.radius * a.radius * (r - l)) / 2;",
    "        };",
    "        Real last = 0;",
    "        for (auto [l, r] : merged) { add_arc(last, l); last = std::max(last, r); }",
    "        add_arc(last, 2 * PI);",
    "    }",
    "    return fabsl(area);",
    "}",
    "",
    "// 機能: 指定円に関して点を円反転する。反転中心自身は nullopt。",
    "std::optional<Point> invert_point(Point p, Circle inversion_circle) {",
    "    Point v = p - inversion_circle.center; Real d2 = norm2(v);",
    "    if (d2 <= EPS) return std::nullopt; // 反転中心は無限遠へ移る",
    "    return inversion_circle.center + v * (inversion_circle.radius * inversion_circle.radius / d2);",
    "}",
    "struct ApolloniusLocus {",
    "    bool is_line = false;",
    "    Circle circle{};",
    "    Line line{};",
    "};",
    "// 機能: 2点からの距離比が一定となる軌跡を垂直二等分線またはApollonius円で返す。",
    "std::optional<ApolloniusLocus> apollonius_locus(Point a, Point b, Real ratio) {",
    "    // |X-A| / |X-B| = ratio。ratio=1なら垂直二等分線、それ以外は円。",
    "    if (ratio < -EPS || same_point(a, b)) return std::nullopt;",
    "    if (eq(ratio, 1)) {",
    "        Point mid = (a + b) / 2; return ApolloniusLocus{true, {}, {mid, mid + perp(b - a)}};",
    "    }",
    "    Real k2 = ratio * ratio, den = 1 - k2;",
    "    Point center = (a - b * k2) / den;",
    "    Real radius = fabsl(ratio * distance(a, b) / den);",
    "    return ApolloniusLocus{false, {center, radius}, {}};",
    "}",
    "} // namespace geo",
    "$0"
  ],
  "description": "円と多角形の共通面積、円の和集合面積、円反転、距離比軌跡Apollonius円"
},
"半平面共通部分": {
  "prefix": "snip_geo_halfplane",
  "body": [
    "// 依存: snip_geo2d_float。有向直線の左側を半平面とし、有界な共通部分を O(N log N) で求める。",
    "// 正の面積を持つ有界領域用。空集合・非有界・点/線分へ退化した共通部分はいずれも空vector。",
    "// 十分大きい外枠4半平面を加えれば非有界領域も切り出せる。",
    "namespace geo {",
    "struct HalfPlane {",
    "    Point p, direction;",
    "    Real angle = 0;",
    "    // 機能: 有向直線 l の左側を許可領域とする半平面を構築する。",
    "    HalfPlane(Line l) : p(l.a), direction(unit(l.b - l.a)), angle(normalize_angle(argument(direction))) {}",
    "};",
    "// 機能: 点 p が半平面 h の許可領域より右側、つまり外部にあるか判定する。",
    "bool outside(const HalfPlane& h, Point p) { return cross(h.direction, p - h.p) < -EPS; }",
    "// 機能: 2半平面の境界直線の一意な交点を返す。平行なら nullopt。",
    "std::optional<Point> halfplane_boundary_intersection(const HalfPlane& a, const HalfPlane& b) {",
    "    Real det = cross(a.direction, b.direction);",
    "    if (sgn(det) == 0) return std::nullopt;",
    "    return a.p + a.direction * (cross(b.p - a.p, b.direction) / det);",
    "}",
    "// 機能: 有向直線群の左半平面の有界共通部分を凸多角形として O(N log N) で返す。",
    "std::vector<Point> halfplane_intersection(const std::vector<Line>& lines) {",
    "    std::vector<HalfPlane> h;",
    "    for (Line l : lines) if (!degenerate(l)) h.emplace_back(l);",
    "    std::sort(h.begin(), h.end(), [](const HalfPlane& a, const HalfPlane& b) {",
    "        if (a.angle != b.angle) return a.angle < b.angle;",
    "        return cross(a.direction, b.p - a.p) < 0;",
    "    });",
    "    std::vector<HalfPlane> unique;",
    "    for (HalfPlane x : h) {",
    "        if (!unique.empty() && sgn(cross(unique.back().direction, x.direction)) == 0",
    "            && dot(unique.back().direction, x.direction) > 0) {",
    "            if (outside(x, unique.back().p)) unique.back() = x; // より狭い方を残す",
    "        } else unique.push_back(x);",
    "    }",
    "    std::deque<HalfPlane> dq;",
    "    for (HalfPlane x : unique) {",
    "        while (dq.size() >= 2) {",
    "            auto p = halfplane_boundary_intersection(dq[dq.size() - 2], dq.back());",
    "            if (!p || outside(x, *p)) dq.pop_back(); else break;",
    "        }",
    "        while (dq.size() >= 2) {",
    "            auto p = halfplane_boundary_intersection(dq[0], dq[1]);",
    "            if (!p || outside(x, *p)) dq.pop_front(); else break;",
    "        }",
    "        dq.push_back(x);",
    "    }",
    "    while (dq.size() >= 3) {",
    "        auto p = halfplane_boundary_intersection(dq[dq.size() - 2], dq.back());",
    "        if (!p || outside(dq.front(), *p)) dq.pop_back(); else break;",
    "    }",
    "    while (dq.size() >= 3) {",
    "        auto p = halfplane_boundary_intersection(dq[0], dq[1]);",
    "        if (!p || outside(dq.back(), *p)) dq.pop_front(); else break;",
    "    }",
    "    if (dq.size() < 3) return {};",
    "    std::vector<Point> polygon;",
    "    for (int i = 0; i < (int)dq.size(); ++i) {",
    "        auto p = halfplane_boundary_intersection(dq[i], dq[(i + 1) % dq.size()]);",
    "        if (!p) return {};",
    "        polygon.push_back(*p);",
    "    }",
    "    return polygon;",
    "}",
    "} // namespace geo",
    "$0"
  ],
  "description": "有向直線の左半平面の有界共通部分をdequeで求めるO(NlogN)半平面交差"
},
"2Dアフィン変換": {
  "prefix": "snip_geo_affine",
  "body": [
    "// 依存: snip_geo2d_float。平行移動、拡大縮小、回転、任意直線対称、合成、逆変換、2線分間の相似変換。",
    "namespace geo {",
    "struct Affine {",
    "    // [x'] = [a b][x] + [tx]。A*B は B の後に A を適用する合成。",
    "    // [y']   [c d][y]   [ty]",
    "    Real a = 1, b = 0, c = 0, d = 1, tx = 0, ty = 0;",
    "    // 機能: 点へ線形変換と平行移動を適用する。",
    "    Point apply(Point p) const { return {a * p.x + b * p.y + tx, c * p.x + d * p.y + ty}; }",
    "    // 機能: ベクトルへ線形部分だけを適用し、平行移動は加えない。",
    "    Point apply_vector(Point v) const { return {a * v.x + b * v.y, c * v.x + d * v.y}; }",
    "    // 機能: 2つのアフィン変換を合成する。A*B は B の後に A を適用する。",
    "    Affine operator*(const Affine& o) const {",
    "        return {a * o.a + b * o.c, a * o.b + b * o.d,",
    "                c * o.a + d * o.c, c * o.b + d * o.d,",
    "                a * o.tx + b * o.ty + tx, c * o.tx + d * o.ty + ty};",
    "    }",
    "    // 機能: 何も変化させない恒等変換を返す。",
    "    static Affine identity() { return {}; }",
    "    // 機能: 指定ベクトルだけ平行移動する変換を返す。",
    "    static Affine translate(Point v) { return {1, 0, 0, 1, v.x, v.y}; }",
    "    // 機能: x・y方向を指定倍率で拡大縮小する変換を返す。",
    "    static Affine scale(Real sx, Real sy) { return {sx, 0, 0, sy, 0, 0}; }",
    "    // 機能: 原点中心に rad ラジアン回転する変換を返す。",
    "    static Affine rotate(Real rad) {",
    "        Real co = cosl(rad), si = sinl(rad); return {co, -si, si, co, 0, 0};",
    "    }",
    "    // 機能: 指定点を中心に rad ラジアン回転する変換を返す。",
    "    static Affine rotate_around(Point center, Real rad) {",
    "        return translate(center) * rotate(rad) * translate(-center);",
    "    }",
    "    // 機能: x軸に関する線対称変換を返す。",
    "    static Affine reflect_x() { return {1, 0, 0, -1, 0, 0}; }",
    "    // 機能: y軸に関する線対称変換を返す。",
    "    static Affine reflect_y() { return {-1, 0, 0, 1, 0, 0}; }",
    "    // 機能: 原点対称変換を返す。",
    "    static Affine reflect_origin() { return {-1, 0, 0, -1, 0, 0}; }",
    "    // 機能: 任意直線に関する線対称変換を返す。退化直線なら nullopt。",
