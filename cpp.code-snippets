            "// using Tree=MatrixProductSegTree<mint998,2>; Tree::Matrix m=Tree::identity();",
            "// 区間積はA[l]*A[l+1]*...*A[r-1]（行ベクトルを右から変換する順）。非可換なので順序に注意。",
            "// 列ベクトルへ左から順に適用したいならopをmultiply(b,a)へ変更。",
            "// 空区間は単位行列。構築O(N*D^3)、操作O(D^3 log N)。Tは加算・乗算が必要、modint推奨。",
            "template<class T,int D=2>",
            "struct MatrixProductSegTree {",
            "    static_assert(D>0);",
            "    // 区間内の全遷移を1行列に圧縮。状態ごとの入出力を保持するので任意のDPへ適用できる。",
