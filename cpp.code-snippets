            "        return it != st.begin() && prev(it)->second >= r;",
            "    }",
            "    bool contains(T x) const { return contains(x, x); }",
            "",
            "    int128 add(T l, T r) {",
            "        if (l > r) return 0;",
            "        auto it = st.lower_bound({l, numeric_limits<T>::lowest()});",
            "        // lower_boundの直前だけが左から重なる/隣接する可能性がある。",
            "        if (it != st.begin() && (int128)prev(it)->second + 1 >= (int128)l) --it;",
