            "// add_line/query O(log M)、add_segment O(log² M)、メモリO(M)。空ならnullopt。",
            "class LiChaoTree {",
            "public:",
            "    using Wide=__int128_t;",
            "    struct Result { Wide value; int id; };",
            "private:",
            "    struct Line { long long a,b; int id; Wide at(long long x) const { return Wide(a)*x+b; } };",
            "    std::vector<long long> xs_;",
            "    std::vector<std::optional<Line>> lines_;",
            "    int next_id_=0;",
            "    static bool better(const Line& a,const Line& b,long long x) {",
            "        Wide av=a.at(x),bv=b.at(x);",
            "        return av<bv || (av==bv && a.id<b.id);",
            "    }",
            "    void insert(int v,int l,int r,Line line) {",
            "        if (!lines_[v]) { lines_[v]=line; return; }",
            "        int m=l+(r-l)/2;",
            "        if (better(line,*lines_[v],xs_[m])) std::swap(line,*lines_[v]);",
            "        if (r-l==1) return;",
            "        if (better(line,*lines_[v],xs_[l])) insert(v*2,l,m,line);",
            "        else if (better(line,*lines_[v],xs_[r-1])) insert(v*2+1,m,r,line);",
            "    }",
            "    void segment(int v,int l,int r,int ql,int qr,Line line) {",
            "        if (qr<=l || r<=ql) return;",
            "        if (ql<=l && r<=qr) { insert(v,l,r,line); return; }",
            "        int m=l+(r-l)/2;",
            "        segment(v*2,l,m,ql,qr,line); segment(v*2+1,m,r,ql,qr,line);",
            "    }",
            "    int id(int requested) { return requested<0 ? next_id_++ : requested; }",
            "public:",
            "    explicit LiChaoTree(std::vector<long long> xs) : xs_(std::move(xs)) {",
            "        std::sort(xs_.begin(),xs_.end()); xs_.erase(std::unique(xs_.begin(),xs_.end()),xs_.end());",
            "        lines_.resize(xs_.size()*4+4);",
            "    }",
            "    int add_line(long long a,long long b,int line_id=-1) {",
            "        int ans=id(line_id);",
            "        if (!xs_.empty()) insert(1,0,static_cast<int>(xs_.size()),{a,b,ans});",
            "        return ans;",
            "    }",
