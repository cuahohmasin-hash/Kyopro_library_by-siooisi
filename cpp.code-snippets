    "// });",
    "//",
    "// パス上の辺の最小値:",
    "// long long ans = HLD_INF;",
    "// hld.path_edge(u, v, [&](int l, int r) {",
    "//     ans = min(ans, seg.prod(l, r));",
    "// });",
    "// if (u == v) ans = 0;",
    "//",
    "// 頂点に値がある場合は path_vertex を使う。"
  ],
  "description": "HL分解で木上パスを区間に分解し、セグ木と組み合わせてパス更新・取得を行う"
