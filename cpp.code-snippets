"Rolling Hash (Anti-Hash Killer)": {
    "prefix": "snip_rollinghash",
    "body": [
        "// ローリングハッシュ (Mod: 2^61 - 1, 乱数baseによるハッシュキラー対策版)",
        "// 計算量: 構築 O(|S|), 比較 O(1)",
        "// 使い方:",
        "//   RollingHash rh(${1:S});",
        "//   ull h1 = rh.get(l, r);       // [l, r) のハッシュ値",
        "//   ull h2 = rh.all();           // 文字列全体のハッシュ値",
        "//   ull h3 = RollingHash::hash_string(s); // 文字列全体のハッシュ値を一発取得",
        "struct RollingHash {",
        "    using ull = unsigned long long;",
        "    static constexpr ull MOD = (1ULL << 61) - 1;",
        "    ",
        "    // 実行時に1度だけ乱数でbaseを生成する (C++17以降の記法)",
        "    static inline ull generate_base() {",
        "        std::mt19937_64 mt(std::chrono::steady_clock::now().time_since_epoch().count());",
        "        std::uniform_int_distribution<ull> rand(256, MOD - 2);",
        "        return rand(mt);",
        "    }",
        "    static inline const ull base = generate_base(); // クラス全体で共有されるbase",
        "",
        "    int n;",
        "    vector<ull> hash, power;",
        "    ",
        "    ull calc_mod(__int128_t val) const {",
        "        val = (val & MOD) + (val >> 61);",
        "        if (val >= MOD) val -= MOD;",
        "        return (ull)val;",
        "    }",
        "    ",
        "    RollingHash(const string &s) {",
        "        n = s.size();",
        "        hash.assign(n + 1, 0);",
        "        power.assign(n + 1, 1);",
        "        for (int i = 0; i < n; i++) {",
        "            hash[i + 1] = calc_mod((__int128_t)hash[i] * base + s[i]);",
        "            power[i + 1] = calc_mod((__int128_t)power[i] * base);",
        "        }",
        "    }",
        "    ",
        "    // [l, r) のハッシュ値を取得 (0-indexed)",
        "    ull get(int l, int r) const {",
        "        ull res = hash[r] + MOD - calc_mod((__int128_t)hash[l] * power[r - l]);",
        "        return res >= MOD ? res - MOD : res;",
        "    }",
        "",
        "    // 文字列全体のハッシュ値を取得",
        "    ull all() const {",
        "        return hash[n];",
        "    }",
        "",
        "    // 文字列全体のハッシュ値を一発で取得",
        "    static ull hash_string(const string &s) {",
        "        RollingHash rh(s);",
        "        return rh.all();",
        "    }",
        "};$0"
    ],
    "description": "ローリングハッシュ O(|S|) : 文字列の一部や全体が一致しているかを高速に判定したい時に使用します。"
