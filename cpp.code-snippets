      "        if (!t) return;",
      "        t->cnt = 1 + count(t->l) + count(t->r);",
      "        t->acc = op(op(prod(t->l), t->val), prod(t->r));",
      "    }",
      "",
      "    static void push(Node* t) {",
      "        if (!t || !t->rev) return;",
      "        t->rev = false;",
      "        std::swap(t->l, t->r);",
      "        if (t->l) t->l->rev ^= 1;",
      "        if (t->r) t->r->rev ^= 1;",
      "    }",
      "",
      "    // a: 先頭 k 個, b: 残り",
      "    static void split(Node* t, int k, Node*& a, Node*& b) {",
      "        if (!t) {",
      "            a = b = nullptr;",
      "            return;",
      "        }",
      "        push(t);",
      "        if (k <= count(t->l)) {",
      "            split(t->l, k, a, t->l);",
      "            b = t;",
      "            pull(b);",
      "        } else {",
      "            split(t->r, k - count(t->l) - 1, t->r, b);",
      "            a = t;",
      "            pull(a);",
      "        }",
      "    }",
      "",
      "    static Node* merge(Node* a, Node* b) {",
      "        if (!a || !b) return a ? a : b;",
      "        if (a->priority > b->priority) {",
      "            push(a);",
      "            a->r = merge(a->r, b);",
      "            pull(a);",
      "            return a;",
      "        } else {",
      "            push(b);",
      "            b->l = merge(a, b->l);",
      "            pull(b);",
      "            return b;",
      "        }",
      "    }",
      "",
      "    // pos 番目の直前に val を挿入。0 <= pos <= size()",
      "    void insert(int pos, const T& val) {",
      "        assert(0 <= pos && pos <= size());",
      "        Node *a, *b;",
      "        split(root, pos, a, b);",
      "        root = merge(merge(a, new Node(val)), b);",
      "    }",
      "",
      "    // pos 番目の要素を削除。0 <= pos < size()",
      "    void erase(int pos) {",
      "        assert(0 <= pos && pos < size());",
      "        Node *a, *m, *b;",
      "        split(root, pos, a, m);",
      "        split(m, 1, m, b);",
      "        delete m;",
      "        root = merge(a, b);",
      "    }",
      "",
      "    // 半開区間 [left, right) を反転",
      "    void reverse(int left, int right) {",
      "        assert(0 <= left && left <= right && right <= size());",
      "        Node *a, *m, *b;",
      "        split(root, right, a, b);",
      "        split(a, left, a, m);",
      "        if (m) m->rev ^= 1;",
      "        root = merge(merge(a, m), b);",
      "    }",
      "",
      "    // 半開区間 [left, right) の集約値を取得",
      "    T query(int left, int right) {",
      "        assert(0 <= left && left <= right && right <= size());",
      "        Node *a, *m, *b;",
      "        split(root, right, a, b);",
      "        split(a, left, a, m);",
      "        T res = prod(m);",
      "        root = merge(merge(a, m), b);",
      "        return res;",
      "    }",
      "};",
      "// ------------------------"
    ],
    "description": "Implicit Treap (Range Reverse, Insert, Erase, Query)"
},
"Prim法_dense": {
  "prefix": "snip_prim_dense",
  "body": [
    "// Prim法（隣接行列版）",
    "// 最小全域木(MST)を構築",
    "// 計算量: O(N^2)",
    "//",
    "// 使い方:",
    "// auto tree = prim_dense<ll>(cost, infl); // 非辺をinflで埋めた場合",
    "// costは対称なN*N行列、実辺重みはno_edge未満とする",
    "// 戻り値: MSTの隣接リスト。非連結・不正な行列なら空vector",
    "",
    "template<class T>",
    "vector<vector<pair<int,T>>> prim_dense(",
    "    const vector<vector<T>>& cost,",
    "    T no_edge = numeric_limits<T>::max() / 4",
    ") {",
    "    int n = (int)cost.size();",
    "    for (const auto& row : cost) {",
    "        if ((int)row.size() != n) { assert(false); return {}; }",
    "    }",
    "    if (n == 0) return {};",
    "",
    "    vector<T> mincost(n, no_edge);",
    "    vector<int> parent(n, -1);",
    "    vector<bool> used(n, false);",
    "",
    "    vector<vector<pair<int,T>>> tree(n);",
    "",
    "    mincost[0] = 0;",
    "",
    "    for (int step = 0; step < n; step++) {",
    "        int v = -1;",
    "",
    "        for (int i = 0; i < n; i++) {",
    "            if (!used[i] && (v == -1 || mincost[i] < mincost[v])) {",
    "                v = i;",
    "            }",
    "        }",
    "",
    "        if (v == -1 || mincost[v] >= no_edge) return {}; // 非連結",
    "",
    "        used[v] = true;",
    "",
    "        if (parent[v] != -1) {",
    "            int p = parent[v];",
    "            T w = cost[p][v];",
    "            tree[p].push_back({v, w});",
    "            tree[v].push_back({p, w});",
    "        }",
    "",
    "        for (int to = 0; to < n; to++) {",
    "            if (!used[to] && cost[v][to] < no_edge && cost[v][to] < mincost[to]) {",
    "                mincost[to] = cost[v][to];",
    "                parent[to] = v;",
    "            }",
    "        }",
    "    }",
    "",
    "    return tree;",
    "}"
  ],
  "description": "Prim法（隣接行列版・O(N^2)）"
