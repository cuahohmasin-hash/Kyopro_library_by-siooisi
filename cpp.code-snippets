            "    bool merge(int x, int y, T w) {",
            "        w += weight(x); w -= weight(y);",
            "        x = leader(x); y = leader(y);",
            "        if (x == y) return false;",
            "        if (rank[x] < rank[y]) { swap(x, y); w = -w; }",
            "        if (rank[x] == rank[y]) rank[x]++;",
            "        parent[y] = x;",
            "        diff_weight[y] = w;",
            "        return true;",
