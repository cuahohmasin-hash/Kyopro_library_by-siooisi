    "グラフ同型判定": {
        "prefix": "snip_isomorphic",
        "body": [
            "// グラフ同型判定。次数で候補を絞り、割当済みの辺を逐次照合するバックトラック版",
            "// 最悪計算量は O(N!) だが、全順列ごとの O(N^2) 比較を避ける",
            "// directed = true なら有向グラフとして判定",
			"// 引数: 隣接リスト G1, G2 (0-indexed推奨)",
            "// 戻り値: 2つのグラフが同じ形なら true",
            "bool is_isomorphic(const vector<vector<int>>& G1, const vector<vector<int>>& G2, bool directed = false) {",
            "    int N = (int)G1.size();",
            "    if ((int)G2.size() != N) return false;",
            "    vector<vector<unsigned char>> mat1(N, vector<unsigned char>(N)), mat2(N, vector<unsigned char>(N));",
            "    for (int i = 0; i < N; ++i) {",
            "        for (int to : G1[i]) { mat1[i][to] = 1; if (!directed) mat1[to][i] = 1; }",
            "        for (int to : G2[i]) { mat2[i][to] = 1; if (!directed) mat2[to][i] = 1; }",
            "    }",
            "    vector<pair<int, int>> deg1(N), deg2(N); // {out-degree, in-degree}",
            "    for (int i = 0; i < N; i++) for (int j = 0; j < N; j++) {",
            "        deg1[i].first += mat1[i][j]; deg1[j].second += mat1[i][j];",
            "        deg2[i].first += mat2[i][j]; deg2[j].second += mat2[i][j];",
            "    }",
            "    auto sorted_deg1 = deg1, sorted_deg2 = deg2;",
            "    sort(sorted_deg1.begin(), sorted_deg1.end());",
            "    sort(sorted_deg2.begin(), sorted_deg2.end());",
            "    if (sorted_deg1 != sorted_deg2) return false;",
            "",
            "    vector<vector<int>> candidate(N);",
            "    for (int u = 0; u < N; u++) for (int v = 0; v < N; v++)",
            "        if (deg1[u] == deg2[v] && mat1[u][u] == mat2[v][v]) candidate[u].push_back(v);",
            "    vector<int> order(N); iota(order.begin(), order.end(), 0);",
            "    sort(order.begin(), order.end(), [&](int a, int b) { return candidate[a].size() < candidate[b].size(); });",
            "    vector<int> mapped(N, -1);",
            "    vector<unsigned char> used(N);",
            "    auto dfs = [&](auto&& self, int pos) -> bool {",
            "        if (pos == N) return true;",
            "        int u = order[pos];",
            "        for (int v : candidate[u]) {",
            "            if (used[v]) continue;",
            "            bool ok = true;",
            "            for (int q = 0; q < pos; q++) {",
            "                int pu = order[q], pv = mapped[pu];",
            "                if (mat1[u][pu] != mat2[v][pv] || mat1[pu][u] != mat2[pv][v]) { ok = false; break; }",
            "            }",
            "            if (!ok) continue;",
            "            mapped[u] = v; used[v] = 1;",
            "            if (self(self, pos + 1)) return true;",
            "            used[v] = 0; mapped[u] = -1;",
            "        }",
            "        return false;",
            "    };",
            "    return dfs(dfs, 0);",
            "}"
        ],
        "description": "グラフ同型判定"
    },
