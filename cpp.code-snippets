            "    atcoder::segtree<ll,op,e> seg;",
            "    explicit FrequencySegTree(const std::vector<ll>& a): n((int)a.size()),seg(checked(a)) {}",
            "    explicit FrequencySegTree(int n_=0): FrequencySegTree(std::vector<ll>(n_,0)) {}",
            "    void set(int i,ll x) { assert(x>=0); seg.set(i,x); }",
            "    void add(int i,ll delta) { set(i,seg.get(i)+delta); }",
