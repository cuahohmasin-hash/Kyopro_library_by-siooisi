"桁DP 汎用集約": {
  "prefix": "snip_digit_dp_fold",
  "body": [
    "// 0 <= X <= digits を処理するvector版の汎用桁DP。digitsは上位桁順。",
    "// 状態は 0 <= key < STATE_SIZE に圧縮し、transitionで範囲外を返した遷移は捨てる。",
    "// optional<Data>で到達不能を表すため、構造体Dataにも番兵値や比較演算子は不要。",
    "// extendでDP値を更新し、mergeを加算/chmax/chmin/ORなどへ差し替えて集約する。",
    "// leading zeroを区別する場合はstartedを状態に含める。親配列を使う復元は別スニペット向け。",
    "// 計算量: O(桁数 * STATE_SIZE * base)、空間計算量: O(STATE_SIZE)。",
    "",
    "// 10進の非負整数文字列を上位桁順へ変換する。",
    "vector<int> decimal_string_to_digits(const string& s) {",
    "    assert(!s.empty());",
    "    vector<int> digits;",
    "    digits.reserve(s.size());",
    "    for (char c : s) {",
    "        assert('0' <= c && c <= '9');",
    "        digits.push_back(c - '0');",
    "    }",
    "    return digits;",
    "}",
    "",
    "// 非負整数を任意基数の上位桁順へ変換する。n=0でも{0}を返す。",
    "vector<int> to_base_digits(unsigned long long n, int base, int min_digits = 1) {",
    "    assert(base >= 2 && min_digits >= 1);",
    "    vector<int> digits;",
    "    do {",
    "        digits.push_back((int)(n % (unsigned long long)base));",
    "        n /= (unsigned long long)base;",
    "    } while (n > 0);",
    "    while ((int)digits.size() < min_digits) digits.push_back(0);",
    "    reverse(digits.begin(), digits.end());",
    "    return digits;",
    "}",
    "",
    "template<class Data, class Transition, class Extend, class Merge, class Accept>",
    "optional<Data> digit_dp_fold(",
    "    const vector<int>& digits,",
    "    int base,",
    "    int STATE_SIZE,",
    "    int init_key,",
    "    const Data& init_data,",
    "    Transition transition,",
    "    Extend extend,",
    "    Merge merge,",
    "    Accept accept",
    ") {",
    "    assert(base >= 2 && STATE_SIZE > 0);",
    "    assert(0 <= init_key && init_key < STATE_SIZE);",
    "    assert(!digits.empty());",
    "    for (int d : digits) assert(0 <= d && d < base);",
    "",
    "    array<vector<optional<Data>>, 2> dp, ndp;",
    "    for (int tight = 0; tight < 2; tight++) {",
    "        dp[tight].assign(STATE_SIZE, nullopt);",
    "        ndp[tight].assign(STATE_SIZE, nullopt);",
    "    }",
    "    dp[1][init_key] = init_data;",
    "",
    "    for (int pos = 0; pos < (int)digits.size(); pos++) {",
    "        for (int tight = 0; tight < 2; tight++) {",
    "            fill(ndp[tight].begin(), ndp[tight].end(), nullopt);",
    "        }",
    "        int upper_digit = digits[pos];",
    "",
    "        for (int tight = 0; tight < 2; tight++) {",
    "            int high = tight ? upper_digit : base - 1;",
    "            for (int key = 0; key < STATE_SIZE; key++) {",
    "                if (!dp[tight][key].has_value()) continue;",
    "                const Data& current = *dp[tight][key];",
    "",
    "                for (int digit = 0; digit <= high; digit++) {",
    "                    int nkey = transition(key, digit, pos);",
    "                    if (nkey < 0 || nkey >= STATE_SIZE) continue;",
    "                    int ntight = tight && (digit == upper_digit);",
    "                    Data candidate = extend(current, key, digit, nkey, pos);",
    "",
    "                    auto& dest = ndp[ntight][nkey];",
    "                    if (!dest.has_value()) dest = move(candidate);",
    "                    else merge(*dest, candidate);",
    "                }",
    "            }",
    "        }",
    "        swap(dp, ndp);",
    "    }",
    "",
    "    optional<Data> answer = nullopt;",
    "    for (int tight = 0; tight < 2; tight++) {",
    "        for (int key = 0; key < STATE_SIZE; key++) {",
    "            if (!dp[tight][key].has_value() || !accept(key)) continue;",
    "            if (!answer.has_value()) answer = *dp[tight][key];",
    "            else merge(*answer, *dp[tight][key]);",
    "        }",
    "    }",
    "    return answer;",
    "}",
    "",
    "// ===== 使用例テンプレ =====",
    "string ${1:N};",
    "cin >> ${1:N};",
    "// [問題ごとに変更1: 基数と上限] 10進文字列ならこのまま。2進などはBASEとdigits生成を変える。",
    "// 例: 0<=X<=N（10進） -> BASE=10, decimal_string_to_digits(N)",
    "// 例: 0<=X<=N（2進）  -> BASE=2,  to_base_digits(N, 2)",
    "const int BASE = ${2:10};",
    "vector<int> digits = ${3:decimal_string_to_digits(N)}; // 任意基数ならto_base_digitsを使う",
    "",
    "// [問題ごとに変更2: DP値Data] 同じ状態へ到達した候補を何として集約するかを表す。",
    "// 数え上げ             : ll/mint、初期値1、extendはcurrent、mergeは+=",
    "// 最大・最小スコア     : ll、初期値0等、extendで加点、mergeはchmax/chmin",
    "// 個数と数値の総和     : struct Data { ll ways; ll sum; }; のように複数量を持つ",
    "// 到達可能性           : bool、初期値true、extendはcurrent、mergeはOR",
    "using Data = ${4:long long};",
    "",
    "// [問題ごとに変更3: 状態key] 未来の遷移・最後の判定に必要な情報を0..STATE_SIZE-1へ圧縮する。",
    "// 例1: X mod K                    -> STATE_SIZE=K, key=rem",
    "// 例2: 桁和 mod K                 -> STATE_SIZE=K, key=sum_mod",
    "// 例3: 数字3を含むか              -> STATE_SIZE=2, key=has3",
    "// 例4: startedと使用数字mask      -> STATE_SIZE=2*(1<<10), key=started*(1<<10)+mask",
    "const int STATE_SIZE = ${5:1};",
    "// まだ何も置いていない状態。余り・和・maskは0、startedはfalse。",
    "int init_key = ${6:0};",
    "// 空の桁列1通りの値。数え上げはData(1)、最大化は0、到達可能性はtrueなど。",
    "Data init_data = ${7:Data(1)};",
    "",
    "auto transition = [&](int key, int digit, int pos) -> int {",
    "    // [問題ごとに変更4: 状態遷移] 左からpos桁を処理済みのkeyへdigitを追加したnkeyを返す。",
    "    // 例: X mod Kなら (key*BASE+digit)%K、桁和mod Kなら (key+digit)%K。",
    "    // 例: 数字3を含むなら key || (digit==3)。禁止条件に触れた遷移は-1。",
    "    // posは0-indexed。特定桁だけ制約する場合（偶数桁は偶数など）に使う。不要なら無視してよい。",
    "    // 桁数・使用数字・隣接条件などleading zeroの影響を受ける性質ではstartedもkeyに含め、",
    "    // started=falseかつdigit=0の間は性質を更新しない。DP上の0007を整数7として扱うため。",
    "    return ${8:key};",
    "};",
    "auto extend = [&](const Data& current, int key, int digit, int nkey, int pos) -> Data {",
    "    // [問題ごとに変更5: 1遷移の値更新] currentからこのdigitを選んだ候補Dataを1個作る。",
    "    // 数え上げ              : return current;",
    "    // 最大桁和              : return current + digit;",
    "    // 数値の総和（Data{ways,sum}）: return {current.ways, current.sum*BASE + current.ways*digit};",
    "    // key/nkeyは状態依存の加点、posは桁位置依存の加点に使える。不要な引数は無視してよい。",
    "    return ${9:current};",
    "};",
    "auto merge = [&](Data& current, const Data& candidate) {",
    "    // [問題ごとに変更6: 同一状態の集約] 別経路から来たcandidateをcurrentへまとめる。",
    "    // 数え上げ: += / 最大・最小: chmax,chmin / 到達可能性: |= / 構造体: 各集計量を+=。",
    "    ${10:current += candidate;}",
    "};",
    "auto accept = [&](int key) -> bool {",
    "    // [問題ごとに変更7: 終端条件] 全桁処理後、このkeyを答えへmergeするならtrue。",
    "    // 例: X%K==0ならkey==0、数字3を含むならhas3、正の整数だけならstarted。",
    "    return ${11:true};",
    "};",
    "",
    "optional<Data> ans = digit_dp_fold<Data>(",
    "    digits, BASE, STATE_SIZE, init_key, init_data,",
    "    transition, extend, merge, accept",
    ");",
    "if (ans.has_value()) cout << ${12:*ans} << '\\n';",
    "else cout << ${13:-1} << '\\n';",
    "$0"
  ],
  "description": "個数・総和・最適化・存在判定をextendとmergeで切り替える任意基数の桁DP"
},
"2組の弦から共通中心判定（整数厳密）": {
  "prefix": "snip_geo_concentric",
  "body": [
    "// 2組の点対 (P,Q), (R,S) をそれぞれ通る2円が、同じ中心を持ち得るかを厳密判定。O(1)",
    "// 発想: 円の中心は各弦の垂直二等分線上。2本が交差または一致すればよい。除算・浮動小数は不要。",
    "// 注意: 『中心が同じ（半径は別でもよい）』の判定。同じ円に4点が乗る判定とは異なる。",
    "namespace concentric_chords {",
    "using i128 = __int128_t;",
    "",
    "struct Point {",
    "    long long x, y;",
    "};",
    "",
    "enum class CenterSet {",
    "    NONE,   // 共通中心なし",
    "    UNIQUE, // 共通中心が一意",
    "    LINE,   // 1本の垂直二等分線上すべて",
    "    PLANE   // 両方とも同一点対で、平面上すべて",
    "};",
    "",
    "struct RationalPoint {",
    "    // UNIQUE のとき中心は (x_num / den, y_num / den)。den > 0、未約分。",
    "    i128 x_num = 0, y_num = 0, den = 1;",
    "};",
    "",
    "struct Result {",
    "    CenterSet type = CenterSet::NONE;",
    "    RationalPoint center;",
    "};",
    "",
    "// 機能: 2組の弦の垂直二等分線を調べ、共通中心の集合を「なし・一意・直線・平面」に分類する。",
    "Result common_center(Point p, Point q, Point r, Point s) {",
    "    // a*x + b*y = c は |O-P|^2 = |O-Q|^2 の展開。",
    "    i128 a1 = 2 * ((i128)q.x - p.x);",
    "    i128 b1 = 2 * ((i128)q.y - p.y);",
    "    i128 c1 = (i128)q.x * q.x + (i128)q.y * q.y",
    "              - (i128)p.x * p.x - (i128)p.y * p.y;",
    "    i128 a2 = 2 * ((i128)s.x - r.x);",
    "    i128 b2 = 2 * ((i128)s.y - r.y);",
    "    i128 c2 = (i128)s.x * s.x + (i128)s.y * s.y",
    "              - (i128)r.x * r.x - (i128)r.y * r.y;",
    "",
    "    bool free1 = (a1 == 0 && b1 == 0); // P == Q: 制約は恒真",
    "    bool free2 = (a2 == 0 && b2 == 0); // R == S: 制約は恒真",
    "    if (free1 && free2) return {CenterSet::PLANE, {}};",
    "    if (free1 || free2) return {CenterSet::LINE, {}};",
    "",
    "    i128 det = a1 * b2 - a2 * b1;",
    "    if (det != 0) {",
    "        i128 xn = c1 * b2 - c2 * b1;",
    "        i128 yn = a1 * c2 - a2 * c1;",
    "        if (det < 0) xn = -xn, yn = -yn, det = -det;",
    "        return {CenterSet::UNIQUE, {xn, yn, det}};",
    "    }",
    "",
    "    // 平行。係数を割らずに、2式が同じ直線を表すか判定する。",
    "    bool same = (a1 * c2 == a2 * c1 && b1 * c2 == b2 * c1);",
    "    return {same ? CenterSet::LINE : CenterSet::NONE, {}};",
    "}",
    "",
    "// 機能: 2組の弦を通る円が共通中心を持ち得るかだけを O(1) で判定する。",
    "bool exists(Point p, Point q, Point r, Point s) {",
    "    // 存在判定だけなら平方・除算も不要。u=Q-P, v=S-R と中点差だけを見る。",
    "    i128 ux = (i128)q.x - p.x, uy = (i128)q.y - p.y;",
    "    i128 vx = (i128)s.x - r.x, vy = (i128)s.y - r.y;",
    "    if ((ux == 0 && uy == 0) || (vx == 0 && vy == 0)) return true;",
    "    if (ux * vy - uy * vx != 0) return true;",
    "    i128 mx = (i128)r.x + s.x - p.x - q.x;",
    "    i128 my = (i128)r.y + s.y - p.y - q.y;",
    "    return mx * ux + my * uy == 0;",
    "}",
    "// 機能: 各点対が直径の両端であるとき、2つの直径の中点が一致するか判定する。",
    "bool same_center_when_diameters(Point p, Point q, Point r, Point s) {",
    "    // 各点対が『円周上の任意の2点』でなく『直径の両端』なら、中心は中点に固定される。",
    "    return (i128)p.x + q.x == (i128)r.x + s.x && (i128)p.y + q.y == (i128)r.y + s.y;",
    "}",
    "// 機能: 各点対が直径の両端であるとき、中心と半径がともに同じ円か判定する。",
    "bool same_circle_when_diameters(Point p, Point q, Point r, Point s) {",
    "    if (!same_center_when_diameters(p, q, r, s)) return false;",
    "    i128 dx1 = (i128)p.x - q.x, dy1 = (i128)p.y - q.y;",
    "    i128 dx2 = (i128)r.x - s.x, dy2 = (i128)r.y - s.y;",
    "    return dx1 * dx1 + dy1 * dy1 == dx2 * dx2 + dy2 * dy2;",
    "}",
    "} // namespace concentric_chords",
    "",
    "// 使用例: YN(concentric_chords::exists({px, py}, {qx, qy}, {rx, ry}, {sx, sy}));",
    "$0"
  ],
  "description": "2本の垂直二等分線を__int128で処理し、2組の弦を通る円の共通中心を存在・一意・無限に分類"
},
"整数2D幾何フル（誤差なし）": {
  "prefix": "snip_geo2d_int",
  "body": [
    "// 整数2D幾何。判定計算は __int128 で行い、浮動小数誤差と long long の積overflowを避ける。",
    "// 点・内外積・CCW・線分交差・整数直線・垂直二等分線・凸包・凸多角形直径・格子点・共円判定を収録。",
    "// 前提: Pointの加減算結果と全int128中間値が各型に収まること。任意のll全域・高次式には多倍長整数を使う。",
    "namespace igeo {",
    "using i64 = long long;",
    "using i128 = __int128_t;",
    "",
    "// 機能: 整数値の符号を -1・0・1 のいずれかで返す。",
    "int sgn(i128 x) { return (x > 0) - (x < 0); }",
    "// 機能: __int128 値の絶対値を返す。",
    "i128 abs128(i128 x) { return x < 0 ? -x : x; }",
    "// 機能: __int128 同士の最大公約数をユークリッドの互除法で求める。",
    "i128 gcd128(i128 a, i128 b) {",
    "    a = abs128(a); b = abs128(b);",
    "    while (b != 0) { i128 r = a % b; a = b; b = r; }",
    "    return a;",
    "}",
    "",
    "struct Point {",
    "    i64 x = 0, y = 0;",
    "    // 機能: 2つの点・ベクトルを成分ごとに加算する。",
    "    Point operator+(const Point& p) const { return {x + p.x, y + p.y}; }",
    "    // 機能: 2つの点・ベクトルを成分ごとに減算する。",
    "    Point operator-(const Point& p) const { return {x - p.x, y - p.y}; }",
    "    // 機能: 2点の x・y 座標がともに等しいか判定する。",
    "    bool operator==(const Point& p) const { return x == p.x && y == p.y; }",
    "    // 機能: 2点が異なるか判定する。",
    "    bool operator!=(const Point& p) const { return !(*this == p); }",
    "    // 機能: 点を x 優先、次に y の辞書順で比較し、sort・set・mapで使えるようにする。",
    "    bool operator<(const Point& p) const { return x != p.x ? x < p.x : y < p.y; }",
    "};",
    "",
    "// 機能: 2ベクトル a・b の内積を返す。垂直判定や角度・射影の判定に使う。",
    "i128 dot(Point a, Point b) { return (i128)a.x * b.x + (i128)a.y * b.y; }",
    "// 機能: 2ベクトル a・b の2次元外積を返す。平行・左右・面積判定に使う。",
    "i128 cross(Point a, Point b) { return (i128)a.x * b.y - (i128)a.y * b.x; }",
    "// 機能: ベクトル OA と OB の内積を返す。点の前後関係や角度判定に使う。",
    "i128 dot(Point o, Point a, Point b) {",
    "    return ((i128)a.x - o.x) * ((i128)b.x - o.x)",
    "         + ((i128)a.y - o.y) * ((i128)b.y - o.y);",
    "}",
    "// 機能: ベクトル OA と OB の外積を返し、Oから見たA・Bの回転方向を表す。",
    "i128 cross(Point o, Point a, Point b) {",
    "    return ((i128)a.x - o.x) * ((i128)b.y - o.y)",
    "         - ((i128)a.y - o.y) * ((i128)b.x - o.x);",
    "}",
    "// 機能: ベクトルの長さの2乗を返す。平方根を取らずに長さ比較したいときに使う。",
    "i128 norm2(Point p) { return dot(p, p); }",
    "// 機能: 2点間のユークリッド距離の2乗を返す。",
    "i128 dist2(Point a, Point b) { return dot(a, b, b); }",
    "// 機能: ベクトルを原点中心に反時計回りへ90度回転する。",
    "Point rot90(Point p) { return {-p.y, p.x}; }",
    "// 機能: 有向直線 a→b に対して c が左・右・一直線のどれかを -1/0/1 で返す。",
    "int orient(Point a, Point b, Point c) { return sgn(cross(a, b, c)); }",
    "// 機能: 2ベクトルが平行かを外積0で判定する。",
    "bool parallel(Point a, Point b) { return cross(a, b) == 0; }",
    "// 機能: 2ベクトルが垂直かを内積0で判定する。",
    "bool orthogonal(Point a, Point b) { return dot(a, b) == 0; }",
    "",
    "// +1:反時計回り, -1:時計回り, +2:C-A-B, -2:A-B-C, 0:線分AB上",
    "// 機能: 3点の左右関係に加え、共線時に c が線分abの前・上・後のどこかまで5分類する。",
    "int ccw(Point a, Point b, Point c) {",
    "    i128 cr = cross(a, b, c);",
    "    if (cr > 0) return 1;",
    "    if (cr < 0) return -1;",
    "    if (dot(a, b, c) < 0) return 2;",
    "    if (dist2(a, b) < dist2(a, c)) return -2;",
    "    return 0;",
    "}",
    "",
    "// 機能: 点 p が点 a・b を通る無限直線上にあるか判定する。",
    "bool on_line(Point a, Point b, Point p) { return cross(a, b, p) == 0; }",
    "// 機能: 点 p が o を始点として through 方向へ伸びる半直線上にあるか判定する。",
    "bool on_ray(Point o, Point through, Point p) {",
    "    return cross(o, through, p) == 0 && dot(o, through, p) >= 0;",
    "}",
    "// 機能: 点 p が端点を含む線分 ab 上にあるか判定する。",
    "bool on_segment(Point a, Point b, Point p) {",
    "    return cross(a, b, p) == 0 && dot(p, a, b) <= 0;",
    "}",
    "// 機能: 2線分が端点接触・重なりを含めて共通点を持つか判定する。",
    "bool segments_intersect(Point a, Point b, Point c, Point d) {",
    "    int ab_c = orient(a, b, c), ab_d = orient(a, b, d);",
    "    int cd_a = orient(c, d, a), cd_b = orient(c, d, b);",
    "    if (ab_c == 0 && on_segment(a, b, c)) return true;",
    "    if (ab_d == 0 && on_segment(a, b, d)) return true;",
    "    if (cd_a == 0 && on_segment(c, d, a)) return true;",
    "    if (cd_b == 0 && on_segment(c, d, b)) return true;",
    "    return ab_c * ab_d < 0 && cd_a * cd_b < 0;",
    "}",
    "// 機能: 2線分が端点ではなく互いの内部で真に交差するか判定する。",
    "bool segments_properly_intersect(Point a, Point b, Point c, Point d) {",
    "    return orient(a, b, c) * orient(a, b, d) < 0",
    "        && orient(c, d, a) * orient(c, d, b) < 0;",
    "}",
    "",
    "// a*x + b*y = c。垂直二等分線では係数に2を掛け、1/2を排除する。",
    "struct Line { i128 a = 0, b = 0, c = 0; };",
    "// 機能: 2点 p・q を通る直線を整数係数 ax+by=c の形で作る。",
    "Line line_through(Point p, Point q) {",
    "    i128 a = (i128)q.y - p.y, b = (i128)p.x - q.x;",
    "    return {a, b, a * p.x + b * p.y};",
    "}",
    "// 機能: 線分 pq の垂直二等分線を整数係数 ax+by=c の形で作る。",
    "Line perpendicular_bisector(Point p, Point q) {",
    "    i128 a = 2 * ((i128)q.x - p.x);",
    "    i128 b = 2 * ((i128)q.y - p.y);",
    "    i128 c = (i128)q.x * q.x + (i128)q.y * q.y",
    "             - (i128)p.x * p.x - (i128)p.y * p.y;",
    "    return {a, b, c};",
    "}",
    "// 機能: 直線式が 0=0 となり、平面上の全点を解に持つか判定する。",
    "bool universal(Line l) { return l.a == 0 && l.b == 0 && l.c == 0; }",
    "// 機能: 直線式が 0=c（c≠0）となり、解を持たないか判定する。",
    "bool impossible(Line l) { return l.a == 0 && l.b == 0 && l.c != 0; }",
    "// 機能: 整数点 p が直線 l の方程式を満たすか判定する。",
    "bool satisfies(Line l, Point p) { return l.a * p.x + l.b * p.y == l.c; }",
    "// 機能: 2つの整数係数直線が平行か判定する。",
    "bool lines_parallel(Line l, Line m) { return l.a * m.b == m.a * l.b; }",
    "// 機能: 係数の定数倍も考慮し、2つの式が同一の直線を表すか判定する。",
    "bool same_line(Line l, Line m) {",
    "    if (universal(l) || universal(m)) return universal(l) && universal(m);",
    "    return lines_parallel(l, m) && l.a * m.c == m.a * l.c && l.b * m.c == m.b * l.c;",
    "}",
    "",
    "struct RationalPoint { i128 x_num = 0, y_num = 0, den = 1; };",
    "struct LinearSolution {",
    "    int count = 0; // 0:なし, 1:一意, -1:無限個",
    "    RationalPoint point;",
    "};",
    "// 機能: 2直線の共通部分を「なし・一意な分数座標・無限個」に分類する。",
    "LinearSolution intersect_lines(Line l, Line m) {",
    "    if (impossible(l) || impossible(m)) return {0, {}};",
    "    if (universal(l) || universal(m)) return {-1, {}};",
    "    i128 det = l.a * m.b - m.a * l.b;",
    "    if (det == 0) return {same_line(l, m) ? -1 : 0, {}};",
    "    i128 xn = l.c * m.b - m.c * l.b;",
    "    i128 yn = l.a * m.c - m.a * l.c;",
    "    if (det < 0) xn = -xn, yn = -yn, det = -det;",
    "    return {1, {xn, yn, det}};",
    "}",
    "// 機能: 直線 ax+by=c 上に整数座標点が少なくとも1つ存在するか判定する。",
    "bool has_integer_solution(Line l) {",
    "    if (impossible(l)) return false;",
    "    if (universal(l)) return true;",
    "    i128 g = gcd128(l.a, l.b);",
    "    return l.c % g == 0;",
    "}",
    "// 機能: 2直線が整数座標の共通点を持つか判定する。",
    "bool has_integer_intersection(Line l, Line m) {",
    "    auto sol = intersect_lines(l, m);",
    "    if (sol.count == 0) return false;",
    "    if (sol.count < 0) {",
    "        if (!universal(l)) return has_integer_solution(l);",
    "        return has_integer_solution(m);",
    "    }",
    "    return sol.point.x_num % sol.point.den == 0 && sol.point.y_num % sol.point.den == 0;",
    "}",
    "",
    "// ゼロベクトルを先頭、以降を+x軸から反時計回り。同方向は長さでtie-breakする安全な比較。",
    "// 機能: 偏角ソート用に、ベクトルを上半平面・下半平面・ゼロへ分類する。",
    "int polar_half(Point p) {",
    "    if (p.x == 0 && p.y == 0) return -1;",
    "    return (p.y < 0 || (p.y == 0 && p.x < 0)) ? 1 : 0;",
    "}",
    "struct PolarLess {",
    "    // 機能: ベクトルを +x 軸から反時計回りの偏角順に比較する。",
    "    bool operator()(Point a, Point b) const {",
    "        int ha = polar_half(a), hb = polar_half(b);",
    "        if (ha != hb) return ha < hb;",
    "        if (ha == -1) return false;",
    "        i128 cr = cross(a, b);",
    "        if (cr != 0) return cr > 0;",
    "        i128 na = norm2(a), nb = norm2(b);",
    "        if (na != nb) return na < nb;",
    "        return a < b;",
    "    }",
    "};",
    "",
    "// 機能: 方向ベクトルを最大公約数で割って既約化し、必要なら逆向きも同一視する。",
    "std::pair<i128, i128> primitive_direction(i64 dx_value, i64 dy_value, bool undirected = false) {",
    "    i128 dx = dx_value, dy = dy_value;",
    "    if (dx == 0 && dy == 0) return {0, 0};",
    "    i128 g = gcd128(dx, dy);",
    "    dx /= g; dy /= g;",
    "    if (undirected && (dx < 0 || (dx == 0 && dy < 0))) dx = -dx, dy = -dy;",
    "    return {dx, dy};",
    "}",
    "struct Direction {",
    "    i128 dx = 0, dy = 0;",
    "    // 機能: 正規化方向を dx・dy の辞書順で比較し、map・setのキーに使えるようにする。",
    "    bool operator<(const Direction& o) const { return dx != o.dx ? dx < o.dx : dy < o.dy; }",
    "    // 機能: 2つの正規化方向が同一か判定する。",
    "    bool operator==(const Direction& o) const { return dx == o.dx && dy == o.dy; }",
    "};",
    "// 機能: 点 a から b への方向を既約な整数ベクトルに正規化する。",
    "Direction normalized_direction(Point a, Point b, bool undirected = false) {",
    "    i128 dx = (i128)b.x - a.x, dy = (i128)b.y - a.y;",
    "    if (dx == 0 && dy == 0) return {};",
    "    i128 g = gcd128(dx, dy); dx /= g; dy /= g;",
    "    if (undirected && (dx < 0 || (dx == 0 && dy < 0))) dx = -dx, dy = -dy;",
    "    return {dx, dy};",
    "}",
    "struct NormalizedLine {",
    "    // primitiveな法線 (a,b) と a*x+b*y=c。辞書順比較でき、map/setのkeyに使える。",
    "    i128 a = 0, b = 0, c = 0;",
    "    // 機能: 正規化直線を a・b・c の辞書順で比較する。",
    "    bool operator<(const NormalizedLine& o) const {",
    "        if (a != o.a) return a < o.a; if (b != o.b) return b < o.b; return c < o.c;",
    "    }",
    "    // 機能: 2つの正規化直線が同一か判定する。",
    "    bool operator==(const NormalizedLine& o) const { return a == o.a && b == o.b && c == o.c; }",
    "};",
    "// 機能: 2点を通る直線を一意な整数表現へ正規化し、同一直線を同じキーにする。",
    "std::optional<NormalizedLine> normalized_line(Point p, Point q) {",
    "    Direction d = normalized_direction(p, q); if (d.dx == 0 && d.dy == 0) return std::nullopt;",
    "    i128 a = -d.dy, b = d.dx;",
    "    if (a < 0 || (a == 0 && b < 0)) a = -a, b = -b;",
    "    return NormalizedLine{a, b, a * p.x + b * p.y};",
    "}",
    "// 機能: 点集合で同一直線上に並ぶ点数の最大値を求める。重複点対応、O(N^2 log N)。",
    "int max_collinear_points(const std::vector<Point>& p) {",
    "    int n = (int)p.size(), answer = std::min(n, 1);",
    "    for (int i = 0; i < n; ++i) {",
    "        std::map<Direction, int> count; int duplicates = 0, best = 0;",
    "        for (int j = i + 1; j < n; ++j) {",
    "            Direction d = normalized_direction(p[i], p[j], true);",
    "            if (d.dx == 0 && d.dy == 0) ++duplicates;",
    "            else best = std::max(best, ++count[d]);",
    "        }",
    "        answer = std::max(answer, best + duplicates + 1);",
    "    }",
    "    return answer; // O(N^2 log N)、重複点対応",
    "}",
    "",
    "// 機能: 多角形の符号付き面積の2倍を返す。反時計回りなら正、時計回りなら負。",
    "i128 polygon_area2(const std::vector<Point>& p) {",
    "    i128 s = 0; int n = (int)p.size();",
    "    for (int i = 0; i < n; ++i) s += cross(p[i], p[(i + 1) % n]);",
    "    return s; // CCWなら正。面積は abs(s)/2。",
    "}",
    "enum class Location { OUT, ON, IN };",
    "// 機能: 一般多角形に対し、点 q が外部・境界上・内部のどこかを O(N) で判定する。",
    "Location point_in_polygon(const std::vector<Point>& poly, Point q) {",
    "    bool in = false; int n = (int)poly.size();",
    "    for (int i = 0; i < n; ++i) {",
    "        Point a = poly[i], b = poly[(i + 1) % n];",
    "        if (on_segment(a, b, q)) return Location::ON;",
    "        i128 cr = cross(a, b, q);",
    "        if (a.y <= q.y && q.y < b.y && cr > 0) in = !in;",
    "        if (b.y <= q.y && q.y < a.y && cr < 0) in = !in;",
    "    }",
    "    return in ? Location::IN : Location::OUT;",
    "}",
    "// 機能: 反時計回りの厳密凸多角形に対し、点 q の包含位置を O(log N) で判定する。",
    "Location convex_contains(const std::vector<Point>& p, Point q) {",
    "    // strictなCCW凸多角形への点包含 O(log N)。convex_hull(..., false)の出力を渡す。",
    "    int n = (int)p.size();",
    "    if (n == 0) return Location::OUT;",
    "    if (n == 1) return p[0] == q ? Location::ON : Location::OUT;",
    "    if (n == 2) return on_segment(p[0], p[1], q) ? Location::ON : Location::OUT;",
    "    int left = orient(p[0], p[1], q), right = orient(p[0], p[n - 1], q);",
    "    if (left < 0 || right > 0) return Location::OUT;",
    "    if (left == 0) return on_segment(p[0], p[1], q) ? Location::ON : Location::OUT;",
    "    if (right == 0) return on_segment(p[0], p[n - 1], q) ? Location::ON : Location::OUT;",
    "    int l = 1, r = n - 1;",
    "    while (r - l > 1) { int m = (l + r) / 2; if (orient(p[0], p[m], q) >= 0) l = m; else r = m; }",
    "    int z = orient(p[l], p[r], q);",
    "    return z < 0 ? Location::OUT : (z == 0 ? Location::ON : Location::IN);",
    "}",
    "",
    "// 機能: 点集合の凸包を反時計回りで構築する。辺上の共線点を残すか選択できる。",
    "std::vector<Point> convex_hull(std::vector<Point> p, bool keep_collinear = false) {",
    "    std::sort(p.begin(), p.end());",
    "    p.erase(std::unique(p.begin(), p.end()), p.end());",
    "    int n = (int)p.size();",
    "    if (n <= 2) return p;",
    "    bool all_collinear = true;",
    "    for (int i = 2; i < n; ++i) if (cross(p[0], p[1], p[i]) != 0) all_collinear = false;",
    "    if (all_collinear) return keep_collinear ? p : std::vector<Point>{p.front(), p.back()};",
    "    std::vector<Point> h(2 * n); int k = 0;",
    "    auto bad = [&](Point a, Point b, Point c) {",
    "        i128 cr = cross(a, b, c);",
    "        return keep_collinear ? cr < 0 : cr <= 0;",
    "    };",
    "    for (Point x : p) {",
    "        while (k >= 2 && bad(h[k - 2], h[k - 1], x)) --k;",
    "        h[k++] = x;",
    "    }",
    "    for (int i = n - 2, t = k + 1; i >= 0; --i) {",
    "        while (k >= t && bad(h[k - 2], h[k - 1], p[i])) --k;",
    "        h[k++] = p[i];",
    "    }",
    "    h.resize(k - 1);",
    "    return h; // CCW、先頭末尾の重複なし",
    "}",
    "",
    "struct DiameterResult { i128 distance2 = 0; int i = 0, j = 0; };",
    "// 機能: 反時計回り凸多角形の最遠点対と距離の2乗を回転キャリパーで求める。",
    "DiameterResult convex_diameter2(const std::vector<Point>& p) {",
    "    int n = (int)p.size();",
    "    if (n <= 1) return {};",
    "    if (n == 2) return {dist2(p[0], p[1]), 0, 1};",
    "    int j = 1; DiameterResult ans;",
    "    auto upd = [&](int a, int b) {",
    "        i128 d = dist2(p[a], p[b]);",
    "        if (d > ans.distance2) ans = {d, a, b};",
    "    };",
    "    for (int i = 0; i < n; ++i) {",
    "        int ni = (i + 1) % n;",
    "        while (cross(p[i], p[ni], p[(j + 1) % n]) > cross(p[i], p[ni], p[j]))",
    "            j = (j + 1) % n;",
    "        upd(i, j); upd(ni, j);",
    "    }",
    "    return ans;",
    "}",
    "",
    "// 機能: 整数線分上の格子点数を両端込みで求める。",
    "i128 lattice_points_on_segment(Point a, Point b) {",
    "    i128 dx = (i128)b.x - a.x, dy = (i128)b.y - a.y;",
    "    return gcd128(dx, dy) + 1;",
    "}",
    "// 機能: 格子多角形の境界上にある格子点の総数を求める。",
    "i128 polygon_boundary_lattice_points(const std::vector<Point>& p) {",
    "    i128 b = 0; int n = (int)p.size();",
    "    for (int i = 0; i < n; ++i) {",
    "        Point q = p[(i + 1) % n];",
    "        b += gcd128((i128)q.x - p[i].x, (i128)q.y - p[i].y);",
    "    }",
    "    return b;",
    "}",
    "// 機能: 単純格子多角形の内部格子点数をPickの定理で求める。",
    "i128 polygon_interior_lattice_points(const std::vector<Point>& p) {",
    "    // Pick: 2I = |2S| - B + 2。単純格子多角形が前提。",
    "    return (abs128(polygon_area2(p)) - polygon_boundary_lattice_points(p) + 2) / 2;",
    "}",
    "",
    "// a,b,c が作る円上に d があるか。a,b,c が非共線であること。",
    "// 機能: 非共線な a・b・c が定める円周上に d もあるか厳密判定する。",
    "bool concyclic(Point a, Point b, Point c, Point d) {",
    "    i128 bx = (i128)b.x - a.x, by = (i128)b.y - a.y;",
    "    i128 cx = (i128)c.x - a.x, cy = (i128)c.y - a.y;",
    "    i128 dx = (i128)d.x - a.x, dy = (i128)d.y - a.y;",
    "    i128 b2 = bx * bx + by * by, c2 = cx * cx + cy * cy, d2 = dx * dx + dy * dy;",
    "    i128 det = b2 * (cx * dy - cy * dx)",
    "             - c2 * (bx * dy - by * dx)",
    "             + d2 * (bx * cy - by * cx);",
    "    return det == 0;",
    "}",
    "// 機能: 点集合全体が1つの有限半径の円周上に乗り得るか判定する。",
    "bool can_lie_on_one_circle(std::vector<Point> p) {",
    "    std::sort(p.begin(), p.end());",
    "    p.erase(std::unique(p.begin(), p.end()), p.end());",
    "    if (p.size() <= 2) return true;",
    "    int k = -1;",
    "    for (int i = 2; i < (int)p.size(); ++i) if (cross(p[0], p[1], p[i]) != 0) { k = i; break; }",
    "    if (k == -1) return false; // 3点以上が一直線なら有限半径の円には乗らない",
    "    for (Point q : p) if (!concyclic(p[0], p[1], p[k], q)) return false;",
    "    return true;",
    "}",
    "} // namespace igeo",
    "$0"
  ],
  "description": "__int128による整数2D幾何フルセット。線分、直線、垂直二等分線、偏角、凸包、格子点、共円判定"
},
"実数2D幾何コア・直線・線分": {
  "prefix": "snip_geo2d_float",
  "body": [
    "// long double 版2D幾何コア。点・ベクトル・角度・直線・半直線・線分・交点・射影・距離を収録。",
    "// 判定だけ整数で完結する問題では snip_geo2d_int を優先し、交点座標などが必要なときに使う。",
    "// EPSは入力座標の規模に合わせて調整する。orient/parallel等の絶対EPS判定はスケール依存。",
    "namespace geo {",
    "using Real = long double;",
    "constexpr Real EPS = 1e-12L;",
    "const Real PI = acosl(-1.0L);",
    "",
    "// 機能: 実数を EPS 込みで負・0・正の -1/0/1 に分類する。",
    "int sgn(Real x) { return (x > EPS) - (x < -EPS); }",
    "// 機能: 相対誤差を考慮して2つの実数が等しいか判定する。",
    "bool eq(Real a, Real b) {",
    "    return fabsl(a - b) <= EPS * std::max({1.0L, fabsl(a), fabsl(b)});",
    "}",
    "// 機能: 値を [-1,1] に丸め、acos・asin の誤差による定義域外を防ぐ。",
    "Real clamp_unit(Real x) { return std::max(-1.0L, std::min(1.0L, x)); }",
    "// 機能: 角度を [0,2π) の範囲へ正規化する。",
    "Real normalize_angle(Real a) {",
    "    a = fmodl(a, 2 * PI);",
    "    if (a < 0) a += 2 * PI;",
    "    return a; // [0, 2PI)",
    "}",
    "// 機能: 角度を [-π,π) の範囲へ正規化する。",
    "Real normalize_signed_angle(Real a) {",
    "    a = normalize_angle(a);",
    "    if (a >= PI) a -= 2 * PI;",
    "    return a; // [-PI, PI)",
    "}",
    "",
    "struct Point {",
    "    Real x = 0, y = 0;",
    "    // 機能: 点・ベクトルをそのまま返す単項プラス演算子。",
    "    Point operator+() const { return *this; }",
    "    // 機能: 点・ベクトルの全成分の符号を反転する。",
    "    Point operator-() const { return {-x, -y}; }",
    "    // 機能: 2つの点・ベクトルを成分ごとに加算する。",
    "    Point operator+(const Point& p) const { return {x + p.x, y + p.y}; }",
    "    // 機能: 2つの点・ベクトルを成分ごとに減算する。",
    "    Point operator-(const Point& p) const { return {x - p.x, y - p.y}; }",
    "    // 機能: 点・ベクトルを実数倍する。",
    "    Point operator*(Real k) const { return {x * k, y * k}; }",
    "    // 機能: 点・ベクトルを実数で割る。",
    "    Point operator/(Real k) const { return {x / k, y / k}; }",
    "    // 機能: 現在の点・ベクトルへ別のベクトルを加算する。",
    "    Point& operator+=(const Point& p) { x += p.x; y += p.y; return *this; }",
    "    // 機能: 現在の点・ベクトルから別のベクトルを減算する。",
    "    Point& operator-=(const Point& p) { x -= p.x; y -= p.y; return *this; }",
    "    // 機能: 現在の点・ベクトルを実数倍する。",
    "    Point& operator*=(Real k) { x *= k; y *= k; return *this; }",
    "};",
    "// 機能: 実数を左辺に置いたスカラー倍 k*p を使えるようにする。",
    "Point operator*(Real k, Point p) { return p * k; }",
    "// 機能: 絶対EPSで2点が同一点か判定する。",
    "bool same_point(Point a, Point b) { return fabsl(a.x - b.x) <= EPS && fabsl(a.y - b.y) <= EPS; }",
    "// 機能: 点を x 優先、次に y の辞書順で比較する。",
    "bool lex_less(Point a, Point b) { return a.x != b.x ? a.x < b.x : a.y < b.y; }",
    "",
    "// 機能: 2ベクトルの内積を返す。",
    "Real dot(Point a, Point b) { return a.x * b.x + a.y * b.y; }",
    "// 機能: 2ベクトルの2次元外積を返す。",
    "Real cross(Point a, Point b) { return a.x * b.y - a.y * b.x; }",
    "// 機能: ベクトル OA と OB の外積を返す。",
    "Real cross(Point o, Point a, Point b) { return cross(a - o, b - o); }",
    "// 機能: ベクトルの長さの2乗を返す。",
    "Real norm2(Point p) { return dot(p, p); }",
    "// 機能: 2点間距離の2乗を返す。",
    "Real dist2(Point a, Point b) { return norm2(a - b); }",
    "// 機能: ベクトルのユークリッド長を返す。",
    "Real length(Point p) { return sqrtl(std::max(0.0L, norm2(p))); }",
    "// 機能: 2点間のユークリッド距離を返す。",
    "Real distance(Point a, Point b) { return length(a - b); }",
    "// 機能: ベクトルを反時計回りへ90度回転した垂直ベクトルを返す。",
    "Point perp(Point p) { return {-p.y, p.x}; }",
    "// 機能: 同方向の単位ベクトルを返す。ゼロベクトルならゼロを返す。",
    "Point unit(Point p) { Real d = length(p); return d <= EPS ? Point{} : p / d; }",
    "// 機能: ベクトルを原点中心に rad ラジアン回転する。",
    "Point rotate(Point p, Real rad) {",
    "    Real c = cosl(rad), s = sinl(rad);",
    "    return {c * p.x - s * p.y, s * p.x + c * p.y};",
    "}",
    "// 機能: ベクトルの偏角を atan2 により [-π,π] 付近の値で返す。",
    "Real argument(Point p) { return atan2l(p.y, p.x); }",
    "// 機能: 2ベクトル間の小さい方の角度をラジアンで返す。",
    "Real angle_between(Point a, Point b) {",
    "    Real den = length(a) * length(b);",
    "    return den <= EPS ? 0 : acosl(clamp_unit(dot(a, b) / den));",
    "}",
    "// 機能: 有向直線 a→b に対する c の左・右・共線を EPS 込みで返す。",
    "int orient(Point a, Point b, Point c) { return sgn(cross(a, b, c)); }",
    "",
    "// +1:反時計回り, -1:時計回り, +2:C-A-B, -2:A-B-C, 0:線分AB上",
    "// 機能: 3点の左右関係と、共線時の線分上・前後関係を5分類する。",
    "int ccw(Point a, Point b, Point c) {",
    "    Point ab = b - a, ac = c - a;",
    "    int cr = sgn(cross(ab, ac));",
    "    if (cr != 0) return cr;",
    "    if (sgn(dot(ab, ac)) < 0) return 2;",
    "    if (sgn(norm2(ab) - norm2(ac)) < 0) return -2;",
    "    return 0;",
    "}",
    "",
    "struct Line { Point a, b; };",
    "struct Segment { Point a, b; };",
    "struct Ray { Point origin, through; };",
    "// 機能: 直線を表す2点が一致し、実質的に一点へ退化しているか判定する。",
    "bool degenerate(Line l) { return same_point(l.a, l.b); }",
    "// 機能: 線分の両端点が一致し、長さ0か判定する。",
    "bool degenerate(Segment s) { return same_point(s.a, s.b); }",
    "// 機能: 2直線が平行か EPS 込みで判定する。",
    "bool parallel(Line l, Line m) { return sgn(cross(l.b - l.a, m.b - m.a)) == 0; }",
    "// 機能: 2直線が垂直か EPS 込みで判定する。",
    "bool orthogonal(Line l, Line m) { return sgn(dot(l.b - l.a, m.b - m.a)) == 0; }",
    "// 機能: 点 p が無限直線 l 上にあるか判定する。",
    "bool on_line(Line l, Point p) {",
    "    return degenerate(l) ? same_point(l.a, p) : sgn(cross(l.b - l.a, p - l.a)) == 0;",
    "}",
    "// 機能: 点 p が半直線 r 上にあるか判定する。",
    "bool on_ray(Ray r, Point p) {",
    "    Point d = r.through - r.origin;",
    "    if (length(d) <= EPS) return same_point(r.origin, p);",
    "    return sgn(cross(d, p - r.origin)) == 0 && sgn(dot(d, p - r.origin)) >= 0;",
    "}",
    "// 機能: 点 p が端点を含む線分 s 上にあるか判定する。",
    "bool on_segment(Segment s, Point p) {",
    "    return sgn(cross(s.b - s.a, p - s.a)) == 0 && sgn(dot(p - s.a, p - s.b)) <= 0;",
    "}",
    "",
    "struct LineIntersection {",
    "    int count = 0; // 0:なし, 1:一意, -1:同一直線",
    "    Point point;",
    "};",
    "// 機能: 2直線の共通部分を「なし・一意な交点・同一直線」に分類する。",
    "LineIntersection line_intersection(Line l, Line m) {",
    "    bool dl = degenerate(l), dm = degenerate(m);",
    "    if (dl && dm) return {same_point(l.a, m.a) ? 1 : 0, l.a};",
    "    if (dl) return {on_line(m, l.a) ? 1 : 0, l.a};",
    "    if (dm) return {on_line(l, m.a) ? 1 : 0, m.a};",
    "    Point u = l.b - l.a, v = m.b - m.a;",
    "    Real det = cross(u, v);",
    "    if (sgn(det) == 0) return {on_line(l, m.a) ? -1 : 0, {}};",
    "    Real t = cross(m.a - l.a, v) / det;",
    "    return {1, l.a + u * t};",
    "}",
    "",
    "// 機能: 点 p を直線 l へ正射影した垂線の足を返す。",
    "Point projection(Line l, Point p) {",
    "    Point d = l.b - l.a; Real z = norm2(d);",
    "    return z <= EPS * EPS ? l.a : l.a + d * (dot(p - l.a, d) / z);",
    "}",
    "// 機能: 点 p を直線 l に関して線対称移動した点を返す。",
    "Point reflection(Line l, Point p) { return projection(l, p) * 2 - p; }",
    "// 機能: 線分 s 上で点 p に最も近い点を返す。",
    "Point closest_point(Segment s, Point p) {",
    "    Point d = s.b - s.a; Real z = norm2(d);",
    "    if (z <= EPS * EPS) return s.a;",
    "    Real t = std::clamp(dot(p - s.a, d) / z, 0.0L, 1.0L);",
    "    return s.a + d * t;",
