    "        i128 dy = floor_sqrt(rem); if (dy * dy != rem) continue;",
    "        if ((cy + dy) % scale == 0) ++answer;",
    "        if (dy != 0 && (cy - dy) % scale == 0) ++answer;",
    "    }",
    "    return answer;",
    "}",
    "// 使用例: auto X=parse_scaled(sx), Y=parse_scaled(sy), R=parse_scaled(sr); answer=count_inside(X,Y,R,10000);",
    "} // namespace lattice_circle",
