            "#include <functional>",
            "#include <optional>",
            "#include <queue>",
            "#include <utility>",
            "#include <vector>",
            "",
            "namespace cp {",
            "// 整数傾きの区分線形凸関数。初期f(x)=0。座標・値・offsetはint128。",
            "// ヒンジ/絶対値の追加O(log N)、shift/minimum/argmin O(1)。",
            "// evaluate(x)はO(N log N)、mergeは相手をコピーしてO(M log(N+M))。",
            "class SlopeTrick {",
            "public:",
            "    using Wide=__int128_t;",
            "private:",
            "    std::priority_queue<Wide> left_;",
            "    std::priority_queue<Wide,std::vector<Wide>,std::greater<Wide>> right_;",
            "    Wide left_offset_=0,right_offset_=0,minimum_=0;",
            "    Wide top_left() const { return left_.top()+left_offset_; }",
            "    Wide top_right() const { return right_.top()+right_offset_; }",
            "public:",
            "    Wide minimum() const { return minimum_; }",
            "    // 最小値を取る閉区間。nulloptは左=-∞/右=+∞。",
            "    std::pair<std::optional<Wide>,std::optional<Wide>> argmin() const {",
            "        return {left_.empty() ? std::nullopt : std::optional<Wide>(top_left()),",
            "                right_.empty() ? std::nullopt : std::optional<Wide>(top_right())};",
            "    }",
            "    void add_constant(Wide c) { minimum_+=c; }",
            "    void add_a_minus_x(Wide a) { // f(x)+=max(0,a-x)",
            "        right_.push(a-right_offset_);",
            "        Wide b=top_right(); right_.pop();",
            "        minimum_+=std::max(Wide(0),a-b);",
            "        left_.push(b-left_offset_);",
            "    }",
            "    void add_x_minus_a(Wide a) { // f(x)+=max(0,x-a)",
            "        left_.push(a-left_offset_);",
            "        Wide b=top_left(); left_.pop();",
            "        minimum_+=std::max(Wide(0),b-a);",
            "        right_.push(b-right_offset_);",
            "    }",
            "    void add_abs(Wide a) { add_a_minus_x(a); add_x_minus_a(a); }",
            "    void shift(Wide a,Wide b) { // 新f(x)=min_{x-b<=y<=x-a}旧f(y)",
            "        assert(a<=b); left_offset_+=a; right_offset_+=b;",
            "    }",
            "    void shift(Wide a) { shift(a,a); } // 新f(x)=旧f(x-a)",
            "    void clear_right() { right_={}; } // 新f(x)=min_{y<=x}旧f(y)",
