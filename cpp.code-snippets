      "body": [
        "// Moのアルゴリズム (Mo's Algorithm)",
        "// オフライン区間クエリを平方分割で高速化する",
        "// 計算量: O((N+Q)√N) ※更新のないクエリにのみ適用可能",
        "// 使い方: Mo mo(N); で宣言 -> mo.add_query(l, r) で半開区間[l, r)を追加 -> mo.build(...) で実行",
        "struct Mo {",
        "    int n;",
        "    std::vector<std::pair<int, int>> lr;",
        "",
        "    explicit Mo(int n) : n(n) {}",
        "",
        "    void add_query(int l, int r) {",
        "        lr.push_back({l, r});",
        "    }",
        "",
        "    template <typename AL, typename AR, typename DL, typename DR, typename REM>",
        "    void build(const AL &add_left, const AR &add_right, const DL &del_left, const DR &del_right, const REM &rem) {",
        "        int q = lr.size();",
        "        int b_size = std::max<int>(1, n / std::max<int>(1, std::sqrt(q)));",
        "        std::vector<int> ord(q);",
        "        std::iota(ord.begin(), ord.end(), 0);",
        "",
        "        std::sort(ord.begin(), ord.end(), [&](int a, int b) {",
        "            int ablock = lr[a].first / b_size, bblock = lr[b].first / b_size;",
        "            if (ablock != bblock) return ablock < bblock;",
        "            return (ablock & 1) ? lr[a].second > lr[b].second : lr[a].second < lr[b].second;",
        "        });",
        "",
        "        int l = 0, r = 0;",
        "        for (auto idx : ord) {",
        "            int L = lr[idx].first, R = lr[idx].second;",
        "            while (l > L) add_left(--l);",
