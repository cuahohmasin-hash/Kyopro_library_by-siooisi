    "}",
    "// 機能: 2長方形の共通部分を長方形として返す。必要なら正の面積を必須にする。",
    "std::optional<Rect> intersection(Rect a, Rect b, bool positive_area = false) {",
    "    a = normalized(a); b = normalized(b);",
    "    Rect c{std::max(a.x1, b.x1), std::max(a.y1, b.y1),",
