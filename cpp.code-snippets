        "    // 戻り値: 矛盾なく追加できたか",
        "    bool merge(int x, int y, int c, T v) {",
        "        if (!valid) return false;",
        "        int rx = find(x), ry = find(y);",
        "        T D = v - weight[x] - c * weight[y];",
        "        int cx = sign[x], cy = c * sign[y];",
