            "    // 全C>=1の前提から、それ以外のoffsetでの判定はDを変更できない。",
            "    struct Tag { i128 add=0,offset=0,hits=0; };",
            "    // historyは常に左右分を加算。mn/countは低い側だけ、同値なら個数を足す。",
            "    static Node op(Node x,Node y) {",
