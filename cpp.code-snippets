    "最長増加部分列": {
    "prefix": "snip_lis",
    "body": [
        "// 最長増加部分列 (LIS) 汎用ライブラリ O(N log N)",
        "// strict = true  : 狭義単調増加 (同じ値NG 1->2->3)",
        "// strict = false : 広義単調増加 (同じ値OK 1->2->2->3)",
        "// 単調減少(LDS)を求めたい場合は、配列をreverseしてからこれを呼ぶ",
        "template<typename T>",
        "struct LIS_Result {",
        "    int max_length;          // LISの全体の長さ",
        "    vector<int> P;           // P[i] := v[i] を末尾とするLISの長さ",
        "    vector<T> restored;      // 復元されたLISの具体例 (1つ)",
        "};",
        "template<typename T>",
        "LIS_Result<T> calc_LIS(const vector<T>& v, bool strict = true) {",
        "    vector<T> tail;",
        "    vector<int> tail_index, prev_index(v.size(), -1), P(v.size());",
        "    for (int i = 0; i < (int)v.size(); ++i) {",
        "        auto it = strict ? lower_bound(tail.begin(), tail.end(), v[i]) : upper_bound(tail.begin(), tail.end(), v[i]);",
        "        int len = (int)(it - tail.begin());",
        "        P[i] = len + 1;",
        "        if (len > 0) prev_index[i] = tail_index[len - 1];",
        "        if (it == tail.end()) { tail.push_back(v[i]); tail_index.push_back(i); }",
        "        else { *it = v[i]; tail_index[len] = i; }",
        "    }",
        "    ",
        "    // 復元処理",
        "    vector<T> restored;",
        "    for (int i = tail_index.empty() ? -1 : tail_index.back(); i != -1; i = prev_index[i]) restored.push_back(v[i]);",
        "    reverse(restored.begin(), restored.end());",
        "    ",
        "    return {(int)tail.size(), move(P), move(restored)};",
        "}"
    ],
    "description": "最長増加部分列 (長さ、各要素を末尾とするLIS長、配列の復元)"
},
