        "    if (G.size() > (size_t)INT_MAX) throw std::length_error(\"tree_diameter: too many vertices\");",
        "    int n = (int)G.size();",
        "    size_t edge_count = 0;",
        "    for (const auto& adj : G) edge_count += adj.size();",
        "    if (edge_count != 2 * (size_t)(n - 1))",
        "        throw std::invalid_argument(\"tree_diameter: expected an undirected tree\");",
        "    std::vector<int> parent(n, -1), order(n);",
        "    auto traverse = [&](int root, std::vector<Distance>& dist) {",
        "        dist.assign(n, -1);",
        "        parent[root] = -1;",
        "        int tail = 1, farthest = root;",
