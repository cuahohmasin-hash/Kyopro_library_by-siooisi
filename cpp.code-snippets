"時間制限乱数シャッフル": {
	"prefix": "snip_timed_random_shuffle",
	"body": [
		"// 時間制限つき乱択シャッフル用",
		"// 使い方: RandomSolver rnd(1900, 1024);",
		"// while (rnd.in_time()) の中で shuffle_vec(A) して乱択貪欲などを試す",
		"// 第1引数: 制限時間[ms]、第2引数: 何回に1回時間確認するか",
		"// 計算量: シャッフル1回 O(N)、全体は指定時間内で回るだけ",
		"// 注意: 嘘解法・ヒューリスティック用。正当性の保証はない",
		"// 時間確認の間にも処理するため少し超過し得る。一回が重いなら第二引数を16等へ下げる",
		"struct RandomSolver {",
		"    using ull = unsigned long long;",
		"    using Clock = chrono::steady_clock;",
		"",
		"    mt19937_64 rng;",
		"    Clock::time_point start_time;",
		"    long long limit_ms;",
		"    int check_interval;",
		"    long long loop_count = 0;",
		"    bool timeout = false;",
		"",
		"    static ull splitmix64(ull x) {",
		"        x += 0x9e3779b97f4a7c15;",
		"        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;",
		"        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;",
		"        return x ^ (x >> 31);",
		"    }",
		"",
		"    RandomSolver(long long limit_ms_ = 1900, int check_interval_ = 1024)",
		"        : limit_ms(limit_ms_), check_interval(max(1, check_interval_)) {",
		"        ull seed = Clock::now().time_since_epoch().count();",
		"        seed ^= (ull)(uintptr_t)this;",
		"        rng.seed(splitmix64(seed));",
		"        start_time = Clock::now();",
		"    }",
		"",
		"    long long elapsed_ms() const {",
		"        auto now = Clock::now();",
		"        return chrono::duration_cast<chrono::milliseconds>(now - start_time).count();",
		"    }",
		"",
		"    bool in_time() {",
		"        if (timeout) return false;",
		"        if (loop_count++ % check_interval != 0) return true;",
		"        if (elapsed_ms() >= limit_ms) {",
		"            timeout = true;",
		"            return false;",
		"        }",
		"        return true;",
		"    }",
		"",
		"    template<class T>",
		"    void shuffle_vec(vector<T>& a) {",
		"        shuffle(a.begin(), a.end(), rng);",
		"    }",
		"",
		"    long long randint(long long l, long long r) {",
		"        if (l > r) throw invalid_argument(\"RandomSolver::randint requires l <= r\");",
		"        return uniform_int_distribution<long long>(l, r)(rng);",
		"    }",
		"};",
		"",
		"// 使用例:",
		"// RandomSolver rnd(1900, 1024); // 1900msまで、1024回に1回時間確認",
		"// auto base = A;",
		"// long long best = 0;",
