},"Bipartite Min DSU": {
    "prefix": "snip_bipartite_min_dsu",
    "body": [
        "// 二部グラフ管理用DSU",
        "// color[x] xor color[y] = w を追加しながら、各成分の min(色0側, 色1側) の総和を管理する",
        "// w=0: 同じ色, w=1: 違う色",
        "// d.ans が現在の最小黒数、d.ok=false なら二部グラフでない",
        "struct BipartiteMinDSU {",
        "    vector<int> parent, sz, diff;",
        "    vector<array<long long, 2>> cnt;",
        "    long long ans = 0;",
        "    bool ok = true;",
        "",
        "    BipartiteMinDSU(int n) : parent(n), sz(n, 1), diff(n, 0), cnt(n) {",
        "        iota(parent.begin(), parent.end(), 0);",
        "        for (int i = 0; i < n; i++) cnt[i] = {1, 0};",
        "    }",
        "",
        "    // 戻り値: {leader, x と leader の色の xor 差}",
        "    pair<int, int> find(int x) {",
        "        if (parent[x] == x) return {x, 0};",
        "        auto [r, p] = find(parent[x]);",
        "        diff[x] ^= p;",
        "        parent[x] = r;",
        "        return {parent[x], diff[x]};",
        "    }",
        "",
        "    int leader(int x) {",
        "        return find(x).first;",
        "    }",
        "",
        "    int parity(int x) {",
        "        return find(x).second;",
        "    }",
        "",
        "    bool same(int x, int y) {",
        "        return leader(x) == leader(y);",
        "    }",
        "",
        "    long long cost(int r) {",
        "        return min(cnt[r][0], cnt[r][1]);",
        "    }",
        "",
        "    // color[x] xor color[y] = w を追加する",
        "    // 矛盾がなければ true、矛盾したら false",
        "    bool merge(int x, int y, int w) {",
        "        if (!ok) return false;",
        "",
        "        auto [rx, px] = find(x);",
        "        auto [ry, py] = find(y);",
        "",
        "        if (rx == ry) {",
        "            if ((px ^ py) != w) ok = false;",
        "            return ok;",
        "        }",
        "",
        "        ans -= cost(rx);",
        "        ans -= cost(ry);",
        "",
        "        if (sz[rx] < sz[ry]) {",
        "            swap(rx, ry);",
        "            swap(px, py);",
        "        }",
        "",
        "        // ry を rx にぶら下げる",
        "        // diff[ry] = ry と rx の色の xor 差",
        "        int d = px ^ py ^ w;",
        "        parent[ry] = rx;",
        "        diff[ry] = d;",
        "        sz[rx] += sz[ry];",
        "",
        "        if (d == 0) {",
        "            cnt[rx][0] += cnt[ry][0];",
        "            cnt[rx][1] += cnt[ry][1];",
        "        } else {",
        "            cnt[rx][0] += cnt[ry][1];",
        "            cnt[rx][1] += cnt[ry][0];",
        "        }",
        "",
        "        ans += cost(rx);",
        "        return true;",
        "    }",
        "",
        "    // x と y の色の xor 差を返す。同じ成分でなければ -1",
        "    int diff_parity(int x, int y) {",
        "        auto [rx, px] = find(x);",
