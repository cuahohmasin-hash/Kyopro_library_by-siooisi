            "// 交点が一致する直線も保持する。同値時のidは保証しない(値は正しい)。",
            "class ConvexHullTrick {",
            "public:",
            "    using Wide=__int128_t;",
            "    struct Result { Wide value; int id; };",
            "private:",
            "    struct Line { long long a,b; int id; Wide at(long long x) const { return Wide(a)*x+b; } };",
            "    std::vector<Line> hull_;",
            "    std::optional<long long> last_slope_;",
            "    int next_id_=0;",
            "    static bool redundant(const Line& a,const Line& b,const Line& c) {",
            "        // 各差は最大2^64-1。符号を分け、絶対値の積をunsigned int128で比較。",
            "        Wide u=Wide(b.b)-a.b,v=Wide(c.b)-b.b;",
            "        if ((u<0)!=(v<0)) return v<0;",
            "        __uint128_t left=__uint128_t(u<0 ? -u:u)*__uint128_t(Wide(b.a)-c.a);",
            "        __uint128_t right=__uint128_t(v<0 ? -v:v)*__uint128_t(Wide(a.a)-b.a);",
            "        return u<0 ? left<right : left>right;",
            "    }",
